    "B08.finance_services_cost": {
      "id": "B08.finance_services_cost",
      "version": 3,
      "purpose": "Общая стоимость услуг Ozon: логистика, хранение, эквайринг и другие статьи услуг. Комиссия за продажи отдельно. Для «сколько стоили услуги/удержали за услуги». Для отдельной услуги — её шаблон. Не все удержания Ozon.",
      "platforms": [
        "ozon"
      ],
      "kind": "scalar",
      "input_policy": {
