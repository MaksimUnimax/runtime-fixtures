  "recipes": {
    "ozon": {
      "id": "ozon.orders.v1",
      "operation": "ozon_orders",
      "method": "POST",
      "url": "https://api-seller.ozon.ru/v1/analytics/data",
      "min_interval": 61,
      "daily_limit": 50,
      "qualification": "CANDIDATE_DECODER",
      "decoder": "ozon_month_rows_and_totals_v1",
      "period_mode": "one_full_interval",
      "metrics": {
        "ordered_units": "ordered_units",
        "ordered_revenue": "revenue"
      }
    },
    "wb": {
      "id": "wb.orders.v3",
      "operation": "wb_orders",
      "method": "POST",
      "url": "https://seller-analytics-api.wildberries.ru/api/analytics/v3/sales-funnel/products",
      "min_interval": 21,
      "daily_limit": 48,
      "qualification": "CANDIDATE_DECODER",
      "decoder": "wb_selected_period_offset_v1",
      "period_mode": "one_full_interval_per_page",
      "metrics": {
        "ordered_units": "orderCount",
        "ordered_revenue": "orderSum",
        "buyout_units_cohort": "buyoutCount",
        "buyout_revenue_cohort": "buyoutSum",
        "cancelled_units_cohort": "cancelCount",
        "cancelled_revenue_cohort": "cancelSum",
        "card_views": "openCount",
        "cart_additions": "cartCount"
      },
      "token_class": "PERSONAL_VERIFIED_OWNER_INTAKE_2026_11_03"
    },
    "ozon_ads": {
