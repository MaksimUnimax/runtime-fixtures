{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "runtime_task_v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "logical_query_id": {
      "type": "string",
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "actor_id": {
          "type": "string",
          "format": "uuid"
        },
        "store_scope": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "store_id": {
                "type": "string",
                "format": "uuid"
              },
              "credential_revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "scope_revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": [
              "store_id",
              "credential_revision",
              "scope_revision"
            ]
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "security_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "access_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "business_timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "execution_ticket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "not_after": {
          "type": "string",
          "format": "date-time"
        },
        "catalog_release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runtime_contract_version": {
          "const": "runtime_port_v1"
        }
      },
      "required": [
        "tenant_id",
        "actor_id",
        "store_scope",
        "security_revision",
        "access_revision",
        "business_timezone",
        "execution_ticket",
        "not_after",
        "catalog_release_id",
        "runtime_contract_version"
      ]
    },
    "query_input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "utterance"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "template"
            },
            "template_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "slots": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "period_from": {
                  "type": "string",
                  "format": "date"
                },
                "period_to": {
                  "type": "string",
                  "format": "date"
                },
                "grouping": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "minItems": 0,
                  "maxItems": 8
                },
                "include_product_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "exclude_product_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": []
            }
          },
          "required": [
            "kind",
            "template_id",
            "slots"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "logical_query_id",
    "trace_id",
    "context",
    "query_input"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alisa:runtime_task:v1",
  "title": "Trusted internal request; session/peer/ticket validation is mandatory outside JSON Schema"
}
