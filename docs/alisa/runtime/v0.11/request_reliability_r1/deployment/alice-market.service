# Observed: /etc/systemd/system/alice-market.service
[Unit]
Description=Private Alice marketplace read-only canary worker and local gateway
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=alice-market
Group=alice-lab
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=alice-market
RuntimeDirectoryMode=0750
StateDirectory=alice-market
StateDirectoryMode=0700
UMask=0077
LoadCredential=ozon:/etc/alice-lab/marketplaces/ozon.json
LoadCredential=wb:/etc/alice-lab/marketplaces/wb.json
LoadCredential=deepseek:/var/lib/alice-lab/secrets/deepseek.key
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/alice-market /run/alice-market
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M
TasksMax=32
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
