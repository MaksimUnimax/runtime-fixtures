+"""Server-owned prompt-layout policy. No response cache, quotas or extra calls.
+
+This is deliberately not a multi-version catalogue executor. Old jobs without
+this field keep legacy payloads; a rollout still requires the existing safe gate.
+"""
+from copy import deepcopy
+import hashlib
