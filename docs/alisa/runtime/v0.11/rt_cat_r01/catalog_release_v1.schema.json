{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "catalog_release_v1"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "engine_contract_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "required_engine_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "minItems": 0,
      "maxItems": 200
    },
    "semantic_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "speech_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_ref": {
      "type": "string",
      "format": "uuid"
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "proof_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "level": {
            "type": "string",
            "enum": [
              "SOURCE_TEST",
              "INTEGRATION_FIXTURE",
              "RECORDED_PROVIDER",
              "LIVE_PROVIDER",
              "LIVE_DIALOGS"
            ]
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": [
          "proof_id",
          "level",
          "artifact_sha256",
          "scope"
        ]
      },
      "minItems": 1,
      "maxItems": 500
    },
    "author_id": {
      "type": "string",
      "format": "uuid"
    },
    "approver_id": {
      "type": "string",
      "format": "uuid"
    },
    "approved_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "qualified_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "engine_contract_version",
    "required_engine_capabilities",
    "semantic_version",
    "source_version",
    "speech_version",
    "content_sha256",
    "artifact_ref",
    "proofs",
    "author_id",
    "approver_id",
    "approved_hash",
    "qualified_scopes",
    "created_at"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alisa:catalog_release:v1",
  "title": "Immutable proposed catalog manifest; equality of approved_hash/content_sha256 checked by domain code"
}
