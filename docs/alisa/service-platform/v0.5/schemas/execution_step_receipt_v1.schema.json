{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alisa:execution-step-receipt:v1",
  "title": "Квитанция приёмки исполнительского шага",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "step_id",
    "artifact_sha256",
    "source_commit",
    "environment",
    "test_ids",
    "verdict",
    "accepted_inputs",
    "remaining_external_scope"
  ],
  "properties": {
    "schema_version": {
      "const": "execution_step_receipt_v1"
    },
    "step_id": {
      "type": "string",
      "pattern": "^AL-S(0[0-9]|1[0-9]|2[0-4])$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "test_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AL-(?:[TN][0-9]{2}|V04)-[0-9]{2}$"
      }
    },
    "verdict": {
      "enum": [
        "ACCEPTED_FOR_DECLARED_SCOPE",
        "REWORK",
        "BLOCKED"
      ]
    },
    "accepted_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "remaining_external_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "reviewer": {
      "type": "string",
      "maxLength": 200
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  }
}
