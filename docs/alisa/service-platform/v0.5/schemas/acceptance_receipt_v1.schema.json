{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "acceptance_receipt_v1"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^AL-F[0-9]{2}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment": {
      "type": "string",
      "enum": [
        "isolated",
        "staging",
        "production"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "SOURCE_TEST",
        "INTEGRATION_FIXTURE",
        "INSTALLED_UI",
        "PROVIDER_SANDBOX",
        "LIVE_PROVIDER",
        "LIVE_DIALOGS",
        "LIVE_STATION",
        "PRODUCTION"
      ]
    },
    "runtime_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "db_schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "executed_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "test_id": {
            "type": "string",
            "pattern": "^AL-T[0-9]{2}-[0-9]{2}$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "expected_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "actual_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 0,
            "maxItems": 30
          }
        },
        "required": [
          "test_id",
          "verdict",
          "expected_summary",
          "actual_summary",
          "evidence_refs"
        ]
      },
      "minItems": 1,
      "maxItems": 500
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "redacted": {
            "const": true
          }
        },
        "required": [
          "ref",
          "sha256",
          "redacted"
        ]
      },
      "minItems": 0,
      "maxItems": 500
    },
    "external_api_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "feature_id",
    "source_commit",
    "artifact_sha256",
    "environment",
    "level",
    "runtime_version",
    "catalog_version",
    "db_schema_version",
    "policy_version",
    "executed_by",
    "reviewed_by",
    "started_at",
    "finished_at",
    "verdict",
    "cases",
    "evidence",
    "external_api_calls",
    "remaining"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alisa:acceptance_receipt:v1"
}
