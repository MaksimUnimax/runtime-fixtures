{
  "version": 1,
  "canonicalRepo": "MaksimUnimax/runtime-fixtures",
  "main": "main",
  "roles": {
    "A": {
      "path": "/root/octoport-a-extension",
      "branch": "work/a-extension",
      "allow": [
        "apps/extension/**",
        "packages/bridge-core/**",
        "packages/ai-adapters/**",
        "packages/browser-platform/**",
        "packages/control-client/**",
        "packages/marketplaces/**",
        "tests/extension/**",
        "tests/e2e/extension/**",
        "docs/development/coordination/receipts/A/**",
        "tests/regression/extension-core/**",
        "tooling/build/extension_composed.py",
        "tooling/build/extension_firefox.py",
        "tooling/checks/extension_core.py",
        "tooling/checks/extension_i1.py",
        "tooling/checks/extension-test-requirements.txt"
      ],
      "deny": [
        "**/package.json"
      ]
    },
    "B": {
      "path": "/root/octoport-b-backend",
      "branch": "work/b-backend",
      "allow": [
        "apps/api/**",
        "apps/worker/**",
        "apps/portal/**",
        "apps/admin/**",
        "packages/server/**",
        "tooling/server/**",
        "tests/integration/server/**",
        "tests/e2e/server/**",
        "docs/development/coordination/receipts/B/**"
      ],
      "deny": [
        "apps/api/src/health-admin*",
        "apps/worker/src/health-notification*",
        "apps/admin/app/health/**",
        "apps/admin/lib/health*",
        "packages/server/health/**",
        "packages/server/monitoring-control/**",
        "tests/e2e/server/health*",
        "tests/e2e/server/playwright.health*",
        "tests/e2e/server/playwright-dedicated*",
        "tests/e2e/server/support/health*",
        "tests/integration/server/h3-health*",
        "tests/integration/server/s2-*",
        "**/package.json"
      ]
    },
    "C": {
      "path": "/root/octoport-main",
      "branch": "work/c-integration",
      "allow": [
        "**"
      ],
      "deny": [
        "apps/site/**"
      ]
    }
  },
  "notes": [
    "C broad access is for serial integration and shared changes, not permission to edit an active A/B task concurrently.",
    "DB and migrations: B sole author after baseline; C requests changes from B.",
    "A/B dependency manifest changes and shared contract changes require a documented path assignment by C.",
    "SEO outside this plan. Files outside A/B allowlists require assignment before editing."
  ]
}
