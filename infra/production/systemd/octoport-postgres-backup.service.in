[Unit]
Description=Octoport independent PostgreSQL backup
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=@RELEASE_DIR@
ConditionFileNotEmpty=@BACKUP_ENV_FILE@

[Service]
Type=oneshot
User=@BACKUP_USER@
Group=@BACKUP_GROUP@
WorkingDirectory=@RELEASE_DIR@
EnvironmentFile=/etc/seller-agents-owner-test/api.env
EnvironmentFile=@BACKUP_ENV_FILE@
UMask=0077
ExecStart=/usr/bin/python3 @RELEASE_DIR@/tooling/operations/backup_postgres_independent.py
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=@BACKUP_DESTINATION_MOUNT@
ExecStartPre=/usr/bin/python3 @RELEASE_DIR@/tooling/operations/verify_ops_release.py @RELEASE_DIR@
StandardOutput=journal
StandardError=journal
SyslogIdentifier=octoport-postgres-backup
