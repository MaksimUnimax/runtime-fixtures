# Source-only example. Do not install unchanged.
# The destination MUST be a genuinely independent mounted filesystem.
OCTOPORT_BACKUP_DESTINATION=/OWNER_SELECTED_INDEPENDENT_MOUNT/octoport/postgres
OCTOPORT_BACKUP_DESTINATION_MOUNT=/OWNER_SELECTED_INDEPENDENT_MOUNT
OCTOPORT_DB_DATA_PATH=/OWNER_CONFIRMED_POSTGRES_DATA_PATH
OCTOPORT_DB_DATA_MOUNT=/OWNER_CONFIRMED_POSTGRES_DATA_MOUNT
OCTOPORT_BACKUP_MIN_FREE_BYTES=1073741824
