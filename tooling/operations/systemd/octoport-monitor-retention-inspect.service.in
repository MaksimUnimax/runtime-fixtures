[Unit]
Description=Octoport isolated monitor pilot retention read-only inspection
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/octoport-monitor/pilot.env

[Service]
Type=oneshot
User=octoport-monitor
Group=octoport-monitor
WorkingDirectory=@RELEASE_DIR@
EnvironmentFile=/etc/octoport-monitor/pilot.env
Environment=NODE_PATH=@RELEASE_DIR@/apps/telegram-operator/node_modules
Environment=MONITOR_PILOT_EXPECTED_ROLE=octoport_monitor_pilot
UMask=0077
StateDirectory=octoport-monitor-retention
StateDirectoryMode=0700
ExecStartPre=/usr/bin/python3 @RELEASE_DIR@/tooling/operations/verify_ops_release.py @RELEASE_DIR@
ExecStart=/usr/bin/python3 @RELEASE_DIR@/tooling/operations/monitor_pilot_retention_runner.py inspect --state-dir=/var/lib/octoport-monitor-retention --hard-timeout-seconds=60
TimeoutStartSec=90s
Restart=no
MemoryMax=1G
MemorySwapMax=0
TasksMax=256
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
