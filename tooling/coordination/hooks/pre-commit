#!/usr/bin/env python3
import json
from pathlib import Path
import subprocess
import sys
root = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
rules = json.loads((root / "docs/development/coordination/OWNERSHIP.json").read_text())
role = next((key for key,value in rules["roles"].items() if value["path"] == str(root)), None)
if role is None:
    raise SystemExit("Unknown stream worktree; do not bypass this hook")
raise SystemExit(subprocess.call(["python3", str(root / "tooling/coordination/control.py"), role, "guard"]))
