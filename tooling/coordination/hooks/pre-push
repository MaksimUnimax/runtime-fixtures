#!/usr/bin/env python3
import json
import os
from pathlib import Path
import subprocess
import sys

# Explicit isolated-candidate route.  The hook stays lock-free; the parent
# task_publication wrapper holds the role lock, prepares an immutable lease,
# releases coordination.lock, and passes only these exact identities.
if os.environ.get("OCTOPORT_PUBLICATION_REGISTRATION_ID"):
    bundle_root = Path(__file__).resolve().parents[1]
    sys.path.insert(0, str(bundle_root))
    from task_publication import hook_main

    raise SystemExit(hook_main(sys.argv, sys.stdin))

# Existing fixed-role route remains unchanged in meaning.
root = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
sys.path.insert(0, str(root / "tooling/coordination"))
from publication_guard import validate_main_receipt
from work_queue import validate_task_scope

rules = json.loads((root / "docs/development/coordination/OWNERSHIP.json").read_text())
role = next((key for key, value in rules["roles"].items() if value["path"] == str(root)), None)
if role is None:
    raise SystemExit("Unknown stream worktree")
own_ref = "refs/heads/" + rules["roles"][role]["branch"]
current_ref = subprocess.check_output(["git", "symbolic-ref", "HEAD"], text=True).strip()
if current_ref != own_ref:
    raise SystemExit("Stream branch does not match the assigned role")
control_root = Path("/root/octoport-control")
state_file = control_root / (role + ".json")
state = json.loads(state_file.read_text()) if state_file.exists() else {}
if state.get("status") == "STOPPED":
    raise SystemExit("STOPPED: no publication permitted")
allowed = {own_ref, "refs/heads/main"}
for line in sys.stdin:
    local_ref, local_sha, remote_ref, remote_sha = line.split()
    if local_ref not in (own_ref, "HEAD"):
        raise SystemExit("Publish only the current assigned stream ref")
    head = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
    if local_sha != head:
        raise SystemExit("Publish only the checked current HEAD")
    if local_sha == "0" * 40 or remote_ref not in allowed:
        raise SystemExit("Stream cannot delete or publish this ref: " + remote_ref)
    if remote_ref == "refs/heads/main":
        if subprocess.check_output(["git", "status", "--porcelain"], text=True).strip():
            raise SystemExit("Main requires the clean, checked current candidate")
        validate_main_receipt(
            control_root, role, local_sha, remote_sha, rules["roles"][role]["branch"]
        )
        if subprocess.call(["git", "merge-base", "--is-ancestor", remote_sha, local_sha]):
            raise SystemExit("Main history must be preserved; fetch and reconcile")
        if rules.get("taskBoundScope"):
            changed = subprocess.check_output(
                ["git", "diff", "--name-only", remote_sha, local_sha], text=True
            ).splitlines()
            validate_task_scope(control_root, role, changed)
