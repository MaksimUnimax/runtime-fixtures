+    about = bool(re.match(r"(?:что (?:такое|делает|умеет|может|за)|как работает|для чего|зачем|расскажи(?:те)? (?:о|об|про)|есть ли|описание|плагин|интеграция)\b", text))
+    catalog = bool(re.fullmatch(r"(?:плагины|интеграции|каталог|список (?:доступных )?(?:плагинов|интеграций))", text)
+                   or groups and re.match(r"(?:каки[ехм]|что (?:ты |вы )?(?:умеешь|умеет|умеют|можешь)|каков|перечисли|список|покажи|все|доступные|каталог|расскажи|что (?:за|есть)|есть ли|опиши|описани|плагин|интеграц)", text))
+    if named and (setup or about or catalog or any(text == c["title"].casefold().replace("ё", "е") for c in named)):
+        lines = []
+        for card in named:
+            steps = card["steps"]
+            ordered = steps if isinstance(steps, list) else [step for group in steps.values() for step in group]
+            lines.append(card["title"] + " — " + card["purpose"] +
+                         (" " + " ".join(dict.fromkeys(ordered)) if setup else ""))
+        return "\n".join(lines)
+    if catalog:
+        return "\n\n".join(_list_cards(cards, group) for group in ("Плагины", "Интеграции")
+                            if group in (groups or {"Плагины"}))
+    return None
