+        catalogStatus.textContent = error.message;
+      } finally {
+        for (const item of catalogItems.querySelectorAll('button')) item.disabled = false;
+      }
+    });
+    row.append(info, button);
+    return row;
+  }));
+  if (!plugins.length) catalogStatus.textContent = 'В реестре пока нет плагинов.';
+}
+request(catalogPath).then(result => renderPluginCatalog(result.plugins)).catch(error => {
+  catalogStatus.textContent = error.message;
+});
