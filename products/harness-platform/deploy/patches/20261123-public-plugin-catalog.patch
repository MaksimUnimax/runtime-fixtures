@@ -0,0 +1,70 @@
+"""Public installation directory shared by guest help, Octopus and account settings."""
+import json
+
+
+def synchronize(db, cards):
+    """Apply the release's manifests atomically, preserving publication decisions."""
+    db.execute("""CREATE TABLE IF NOT EXISTS product_directory(
+        id TEXT PRIMARY KEY, card TEXT NOT NULL, listed INTEGER NOT NULL DEFAULT 1 CHECK(listed IN (0,1)))""")
+    db.executemany("""INSERT INTO product_directory(id, card) VALUES(?,?)
+        ON CONFLICT(id) DO UPDATE SET card=excluded.card WHERE card<>excluded.card""",
+        [(card["id"], json.dumps(card, ensure_ascii=False, sort_keys=True)) for card in cards])
+    db.execute("DELETE FROM product_directory WHERE id NOT IN (SELECT value FROM json_each(?))",
+               (json.dumps([card["id"] for card in cards]),))
+
+
+def public_cards(db):
+    return [json.loads(card) for card, in db.execute(
+        "SELECT card FROM product_directory WHERE listed=1 ORDER BY id")]
+
+
+def listed_plugins(db):
+    return {key.removeprefix("plugin/") for key, in db.execute(
+        "SELECT id FROM product_directory WHERE listed=1 AND id LIKE 'plugin/%'")}
+
+
+def can_obtain(db, workspace, plugin):
+    return bool(db.execute("""SELECT 1 FROM product_directory
+        WHERE id=? AND (listed=1 OR EXISTS(
+            SELECT 1 FROM entitlements WHERE workspace_id=? AND plugin_id=?))""",
+        ("plugin/" + plugin, workspace, plugin)).fetchone())
+
+
+def admin_routes(get_token, body):
+    from starlette.concurrency import run_in_threadpool
+    from starlette.exceptions import HTTPException
+    from starlette.responses import JSONResponse
+    from starlette.routing import Route
+
+    from ..admin_statistics import require_admin
+    from ..identity import AuthenticationError
+
+    def directory(store, token, change):
+        with (store._write() if change is not None else store._lock):
+            db = store._db
+            try:
+                require_admin(db, token)
+            except AuthenticationError:
+                raise
+            except PermissionError:
+                raise HTTPException(403, "Требуются права администратора.") from None
+            if change is not None:
+                key, listed = change["plugin"], change["listed"]
+                if not isinstance(key, str) or type(listed) is not bool:
+                    raise HTTPException(400, "Проверьте плагин и статус публикации.")
+                if not db.execute("UPDATE product_directory SET listed=? WHERE id=?",
+                                  (listed, "plugin/" + key)).rowcount:
+                    raise HTTPException(404, "Плагин отсутствует в реестре.")
+            rows = db.execute("""SELECT substr(id,8), json_extract(card,'$.title'),
+                json_extract(card,'$.purpose'), listed FROM product_directory
+                WHERE id LIKE 'plugin/%' ORDER BY id""")
+            return [{"id": key, "title": title, "description": purpose, "listed": bool(listed)}
+                    for key, title, purpose, listed in rows]
+
+    async def manage(req):
+        token = get_token(req, allow_cookie=True)
+        change = await body(req, "plugin", "listed") if req.method == "POST" else None
+        rows = await run_in_threadpool(directory, req.app.state.identity, token, change)
+        return JSONResponse({"plugins": rows})
+
+    return [Route("/api/admin/plugin-catalog", manage, methods=["GET", "POST"])]
