+from datetime import datetime, time as clock, timedelta
+from time import time
+from unittest import TestCase
+from unittest.mock import patch
+
+from platform_core import guest_activity, guest_selector
+from platform_core.guest_registration import RegistrationStore
+
+
+class GuestActivityTests(TestCase):
+    def setUp(self):
+        self.store = self.enterContext(RegistrationStore(":memory:"))
+        self.db = self.store._db
+        self.today = guest_selector.day(time())
+        self.midnight = datetime.combine(self.today, clock.min, guest_selector.ZONE).timestamp()
+
+    def send(self, account, rid, offset):
+        with patch.object(guest_selector, "time", return_value=self.midnight+offset):
+            self.store.guest_turn(*account, rid, "Что ты умеешь?")
+
+    def report(self, mode, start=None, end=None):
+        return guest_activity.period_report(self.db, self.today, mode, start, end)
+
+    def test_separate_guests_replay_midnight_and_claim(self):
+        one, two, empty = [self.store.start_guest() for _ in range(3)]
+        self.send(one, "first", -10)
+        self.send(one, "next", 10)
+        self.send(one, "next", 15)
+        self.send(two, "other", 10)
+        today = self.report("today")
+        yesterday = (self.today-timedelta(days=1)).isoformat()
+        current = self.today.isoformat()
+        period = self.report("range", yesterday, current)
+        self.assertEqual((today["messages"],today["guests"],today["calls"]), (2,2,0))
+        self.assertEqual((period["messages"],period["guests"]), (3,2))
+        other_day = self.report("day", yesterday)
+        self.assertEqual((other_day["guests"],other_day["messages"]), (1,1))
+        self.assertEqual(self.store.guest_history(*empty), [])
+        self.assertEqual(len(self.store.guest_history(*two)),1)
+        self.store.register(one[0],"guest-test","Guest registration test password",self.store.guest_recovery(one[0]))
+        with self.store._write() as db:
+            db.execute("UPDATE guest_chats SET expires_at=0 WHERE chat_id=?",(two[1],))
+            self.store._prune(db)
+        self.assertEqual(self.report("range",yesterday,current),period)
+
+    def test_backfill_once_cost_and_unavailable_history(self):
+        one, two = self.store.start_guest(), self.store.start_guest()
+        self.send(one,"a",-5)
+        self.send(one,"b",4)
+        self.send(two,"c",5)
+        self.db.execute("DELETE FROM guest_activity_start")
+        self.db.execute("DELETE FROM guest_activity_daily")
+        guest_activity.initialize(self.db,int(time()))
+        guest_activity.initialize(self.db,int(time()))
+        today = self.today.isoformat()
+        guest_selector.add(self.db,today,calls=1)
+        self.assertIsNone(self.report("today")["rub"])
+        guest_selector.add(self.db,today,receipts=1,input=30,cache=10,output=5,rub=1234567,usd=101)
+        report = self.report("month")
+        self.assertEqual((report["guests"],report["messages"],report["tokens"],report["rub"],report["usd"]),
+                         (2,3,45,"0.001234567","0.000000101"))
+        self.assertTrue(report["activityPartial"])
+        past = self.report("day",(self.today-timedelta(days=10)).isoformat())
+        self.assertIsNone(past["messages"])
+        self.assertIsNone(past["tokens"])
+        self.db.execute("UPDATE guest_activity_start SET started=?",(self.midnight-3*86400,))
+        self.db.execute("DELETE FROM guest_activity_daily WHERE day=?",(today,))
+        self.assertEqual(self.report("today")["guests"],0)
+        self.assertFalse(self.report("today")["activityPartial"])
+
+    def test_pruning_and_invalid_periods(self):
+        old = self.today-timedelta(days=90)
+        keep = old+timedelta(days=1)
+        for d in (old,keep):
+            guest_activity.record(self.db,d,None)
+        guest_selector.prune(self.db,int(time()))
+        self.assertEqual(self.db.execute("SELECT day FROM guest_activity_daily").fetchall(),[(keep.isoformat(),)])
+        for args in [("day",old.isoformat()),("day","invalid"),("day","2026-11-40"),
+                     ("range",self.today.isoformat(),keep.isoformat()),("day",keep.isoformat(),keep.isoformat()),
+                     ("range",keep.isoformat()),("foo",),("today",keep.isoformat())]:
+            with self.subTest(args=args), self.assertRaises(ValueError):
+                self.report(*args)
