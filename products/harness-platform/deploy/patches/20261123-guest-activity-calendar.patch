index 0000000..9041ca1
--- /dev/null
+++ b/products/harness-platform/platform_core/guest_activity.py
@@ -0,0 +1,74 @@
+"""Calendar statistics for anonymous guest conversations. No identifiers survive chat expiry here."""
+from datetime import date, datetime, time as clock, timedelta
+from itertools import groupby
+
+from . import guest_selector
+
+
+def record(db, current, previous, messages=1):
+    # A guest session lives 24 hours. A conversation can span two local calendar days.
+    first_today = previous != current
+    overlap = first_today and previous == current - timedelta(days=1)
+    db.execute("""INSERT INTO guest_activity_daily(day,messages,guests,overlap) VALUES(?,?,?,?)
+        ON CONFLICT(day) DO UPDATE SET messages=messages+excluded.messages,
+        guests=guests+excluded.guests, overlap=overlap+excluded.overlap""",
+        (current.isoformat(), messages, int(first_today), int(overlap)))
+
+
+def initialize(db, now):
+    db.execute("""CREATE TABLE IF NOT EXISTS guest_activity_daily(
+        day TEXT PRIMARY KEY, messages INTEGER NOT NULL, guests INTEGER NOT NULL, overlap INTEGER NOT NULL)""")
+    db.execute("""CREATE TABLE IF NOT EXISTS guest_activity_start(
+        singleton INTEGER PRIMARY KEY CHECK(singleton=1), started INTEGER NOT NULL, cost_from TEXT NOT NULL)""")
+    if db.execute("SELECT 1 FROM guest_activity_start").fetchone():
+        return
+    today = guest_selector.day(now)
+    oldest = today - timedelta(days=guest_selector.MEMORY_DAYS-1)
+    boundary = datetime.combine(oldest, clock.min, guest_selector.ZONE)
+    rows = db.execute("""SELECT chat_id,at_ms FROM guest_turns WHERE at_ms>=?
+        ORDER BY chat_id,at_ms""", (int(boundary.timestamp())*1000,))
+    for _, turns in groupby(rows, key=lambda row: row[0]):
+        previous = None
+        for current, batch in groupby(turns, key=lambda row: guest_selector.day(row[1]/1000)):
+            record(db, current, previous, sum(1 for _ in batch))
+            previous = current
+    first_cost = db.execute("SELECT min(day) FROM guest_filter_daily WHERE day!='total'").fetchone()[0]
+    db.execute("INSERT INTO guest_activity_start VALUES(1,?,?)", (now, first_cost or today.isoformat()))
+
+
+def period_report(db, today, period, start=None, end=None):
+    earliest = today - timedelta(days=guest_selector.MEMORY_DAYS-1)
+    if period in ("today", "month") and start is None and end is None:
+        first, last = (today if period=="today" else today-timedelta(days=29)), today
+    elif period in ("day", "range") and start and (period=="range") == (end is not None):
+        try:
+            first = date.fromisoformat(start)
+            last = date.fromisoformat(end) if end is not None else first
+        except ValueError:
+            raise ValueError("Некорректная дата") from None
+        if first.isoformat()!=start or (end is not None and last.isoformat()!=end):
+            raise ValueError("Некорректная дата")
+    else:
+        raise ValueError("Некорректный период")
+    if not earliest <= first <= last <= today:
+        raise ValueError("Выберите даты за последние 90 дней")
+    bounds = first.isoformat(), last.isoformat()
+    began, cost_from = db.execute("SELECT started,cost_from FROM guest_activity_start WHERE singleton=1").fetchone()
+    # Daily guest totals overlap only on adjacent days. Subtract a returning chat only if both days are selected.
+    messages, guests = db.execute("""SELECT COALESCE(SUM(messages),0),
+        COALESCE(SUM(guests - CASE WHEN day>? THEN overlap ELSE 0 END),0)
+        FROM guest_activity_daily WHERE day BETWEEN ? AND ?""", (bounds[0], *bounds)).fetchone()
+    incomplete = first <= guest_selector.day(began)
+    activity_known = bool(messages) or not incomplete or last >= guest_selector.day(began)
+    meter = guest_selector.metric_sums(db, "day BETWEEN ? AND ?", bounds)
+    has_cost = bounds[1] >= cost_from
+    measured = has_cost and (meter["receipts"] > 0 or meter["unknown"] == 0)
+    return {
+        "from":bounds[0], "to":bounds[1], "today":today.isoformat(), "earliest":earliest.isoformat(),
+        "messages":messages if activity_known else None, "guests":guests if activity_known else None,
+        "activityPartial":incomplete, "activityStarted":datetime.fromtimestamp(began,guest_selector.ZONE).isoformat(timespec="minutes"),
+        "costFrom":cost_from, "costPartial":bounds[0]<cost_from,
+        "calls":meter["calls"] if has_cost else None, "unknown":meter["unknown"] if has_cost else None,
+        "tokens":meter["input"]+meter["cache"]+meter["output"] if measured else None,
+        "rub":meter["rub"] if measured else None, "usd":meter["usd"] if measured else None,
+    }
