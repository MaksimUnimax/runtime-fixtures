+    def touch_session(self, token: str) -> int | None:
+        """Renew an active session on explicit activity and return a new persistent cookie age."""
+        with self._write() as db:
+            actor, _ = _principal(db, token)
+            digest = _secret_digest(token)
+            now = int(time())
+            row = db.execute("""SELECT s.expires_at, p.remembered FROM identity_sessions s
+                LEFT JOIN identity_session_preferences p USING(digest)
+                WHERE s.digest=? AND s.expires_at>?""", (digest, now)).fetchone()
+            if row is None:
+                raise AuthenticationError("Invalid session")
+            expires, remembered = row
+            if remembered is None:
+                # Old sessions have no preference in SQLite. Only a remaining lifetime
+                # longer than the old default proves that "Remember me" was checked.
+                remembered = expires - now > _SESSION_SECONDS
+                db.execute("INSERT INTO identity_session_preferences(digest,remembered) VALUES(?,?)",
+                           (digest, int(remembered)))
+            duration = _session_duration(db, actor, remembered)
+            if now + duration <= expires:
+                return None
+            db.execute("UPDATE identity_sessions SET expires_at=? WHERE digest=?", (now + duration, digest))
+            return duration if remembered else None
