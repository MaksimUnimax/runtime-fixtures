+    def test_member_rotates_own_credentials_in_place(self):
+        with self.client() as client:
+            store = client.app.state.integrations
+            # The ordinary account owns both the credentials and the existing chat grant.
+            token = self.other["Authorization"].split()[1]
+            chat = client.app.state.identity.create_user_chat(token).chat_id
+            base = "/api/integrations"
+            for provider, original, update in (
+                ("ozon", {"client_id":"seller-1", "api_key":"fixture-old", "performance_id":"ads-1",
+                          "performance_secret":"fixture-private-performance"}, {"api_key":"fixture-new"}),
+                ("wb", {"token":"fixture-wb-old"}, {"token":"fixture-wb-new"}),
+                ("wordstat", {"token":"fixture-ws-old"}, {"token":"fixture-ws-new"}),
+            ):
+                with self.subTest(provider=provider):
+                    data = {"provider":provider, "name":"Fixture " + provider, "fields":original}
+                    cid = client.post(base, json=data, headers=self.other).json()["id"]
+                    # Use the ordinary grant endpoint for a retained connection. WB refresh has an offline fixture.
+                    with patch.object(client.app.state.plugins, "sync_added"):
+                        client.post(f"/api/chats/{chat}/integrations", headers=self.other,
+                                    json={"connectionId":cid, "enabled":True}).raise_for_status()
+                    endpoint = f"{base}/{cid}/keys"
+                    def edit(auth, version, fields):
+                        return client.post(endpoint, headers=auth, json={"version":version, "fields":fields})
+                    self.assertEqual(edit(self.headers, 1, update).status_code, 404)
+                    self.assertEqual(edit(self.other, 1, {}).status_code, 400)
+                    result = edit(self.other, 1, update)
+                    self.assertEqual(result.json(), {"id":cid, "version":2, "status":"saved"})
+                    self.assertEqual(edit(self.other, 1, update).status_code, 409)
+                    self.assertEqual(store.open(token, cid), (provider,2,original|update))
+                    if provider == "ozon":
+                        self.assertEqual(edit(self.other,2,{"client_id":"different-shop"}).status_code,409)
+                        edit(self.other,2,{"performance_secret":"fixture-rotated-performance"}).raise_for_status()
+                        self.assertEqual(store.open(token,cid)[2]["api_key"],update["api_key"])
+                    rows = client.get(base,headers=self.other).json()["connections"]
+                    self.assertEqual(sum(c["id"] == cid for c in rows), 1)
+                    self.assertFalse(set(original.values()) & {str(v) for row in rows for v in row.values()})
+                    with client.app.state.identity._lock:
+                        self.assertTrue(client.app.state.identity._db.execute(
+                            "SELECT 1 FROM chat_integrations WHERE chat_id=? AND connection_id=?", (chat,cid)).fetchone())
