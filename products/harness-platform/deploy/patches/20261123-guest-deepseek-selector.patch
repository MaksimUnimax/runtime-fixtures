diff --git a/products/harness-platform/platform_core/guest_selector.py b/products/harness-platform/platform_core/guest_selector.py
new file mode 100644
index 0000000..cafdbe9
--- /dev/null
+++ b/products/harness-platform/platform_core/guest_selector.py
@@ -0,0 +1,257 @@
+"""Select a public answer by ID. Guest turns, reservations and the provider ledger have separate lifetimes."""
+import asyncio
+from contextlib import asynccontextmanager, suppress
+from datetime import datetime, timedelta
+from decimal import Decimal
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sqlite3
+import logging
+from time import time
+from zoneinfo import ZoneInfo
+
+from starlette.concurrency import run_in_threadpool
+
+from . import coins
+from .identity import AuthenticationError
+from .guest_billing import fill_terms, purchase_reply
+from .user_plugins.publication import guest_cards
+
+ZONE = ZoneInfo("Asia/Qyzylorda")
+DEFAULT_LIMIT = 500
+MEMORY_DAYS = 90
+SCRIPT = Path(__file__).resolve().parents[1] / "native/guest-selector.mjs"
+LABELS = {
+    "scope":"Вне тем Октопорта, непонятный запрос", "features":"Обзор доступных возможностей Октопуса",
+    "intro":"Что здесь делать, предложение показать возможности", "clarify":"Уточнить, какую из предложенных задач разобрать",
+    "signup":"Регистрация, как начать", "signin":"Вход в аккаунт", "history":"Сохранение переписки после регистрации",
+    "price":"Стоимость работы, как списываются монеты", "answer_cost":"Стоимость одного ответа или задачи",
+    "coin_rate":"Цена одной монеты", "pay":"Как пополнить баланс и способы оплаты", "trial":"Стартовый бонус и проба",
+    "budget":"На сколько работы хватит монет", "balance":"Где посмотреть баланс и списания",
+    "payment_status":"Статус совершённой оплаты", "combined":"Стоимость работы и способы оплаты вместе",
+    "business_advice":"Как разбогатеть, увеличить продажи или уменьшить расходы, общий совет",
+    "shop":"Запросить реальные данные своего магазина", "platforms":"Какие площадки поддерживаются",
+}
+METRICS = ("calls", "receipts", "rejected", "input", "cache", "output", "usd", "rub")
+SCHEMA = (
+    """CREATE TABLE IF NOT EXISTS guest_filter_memory(chat TEXT PRIMARY KEY REFERENCES guest_chats ON DELETE CASCADE,
+       topic TEXT NOT NULL, choices TEXT NOT NULL)""",
+    """CREATE TABLE IF NOT EXISTS guest_filter_attempt(chat TEXT NOT NULL REFERENCES guest_chats ON DELETE CASCADE,
+       request TEXT NOT NULL, fingerprint TEXT NOT NULL, started INTEGER NOT NULL, pending INTEGER NOT NULL,
+       PRIMARY KEY(chat,request))""",
+    """CREATE TABLE IF NOT EXISTS guest_filter_daily(day TEXT PRIMARY KEY, calls INTEGER NOT NULL DEFAULT 0,
+       receipts INTEGER NOT NULL DEFAULT 0,rejected INTEGER NOT NULL DEFAULT 0,input INTEGER NOT NULL DEFAULT 0,
+       cache INTEGER NOT NULL DEFAULT 0,output INTEGER NOT NULL DEFAULT 0,usd INTEGER NOT NULL DEFAULT 0,rub INTEGER NOT NULL DEFAULT 0)""",
+    """CREATE TABLE IF NOT EXISTS guest_filter_setting(singleton INTEGER PRIMARY KEY CHECK(singleton=1),daily_limit INTEGER NOT NULL)""",
+)
+
+def limit(db):
+    row = db.execute("SELECT daily_limit FROM guest_filter_setting WHERE singleton=1").fetchone()
+    return row[0] if row else DEFAULT_LIMIT
+
+def day(stamp):
+    return datetime.fromtimestamp(stamp, ZONE).date()
+
+def add(db, date, **values):
+    assert values.keys() <= set(METRICS)
+    keys = ",".join(values)
+    changes = ",".join(f"{k}={k}+excluded.{k}" for k in values)
+    db.executemany(f"INSERT INTO guest_filter_daily(day,{keys}) VALUES(?,{','.join('?' for _ in values)}) "
+                   f"ON CONFLICT(day) DO UPDATE SET {changes}", [(period,*values.values()) for period in (date,"total")])
+
+def prune(db, now):
+    cutoff = (day(now)-timedelta(days=MEMORY_DAYS-1)).isoformat()
+    db.execute("DELETE FROM guest_filter_daily WHERE day!='total' AND day<?",(cutoff,))
+
+@asynccontextmanager
+async def maintenance(store):
+    def clean():
+        with store._write() as db:
+            store._prune(db)
+    async def run():
+        while True:
+            await asyncio.sleep(900)
+            try:
+                await run_in_threadpool(clean)
+            except sqlite3.OperationalError:
+                logging.getLogger(__name__).exception("Guest history cleanup failed")
+    task=asyncio.create_task(run())
+    try:
+        yield
+    finally:
+        task.cancel()
+        with suppress(asyncio.CancelledError):
+            await task
+
+def totals(db):
+    today = day(time())
+    rows = []
+    for label, where, args in (
+        ("Сегодня","day=?",(today.isoformat(),)),
+        ("Последние 30 дней","day BETWEEN ? AND ?",((today-timedelta(days=29)).isoformat(),today.isoformat())),
+        ("За всё время","day='total'",()),
+    ):
+        sums = ",".join(f"COALESCE(SUM({k}),0)" for k in METRICS)
+        values = dict(zip(METRICS, db.execute(f"SELECT {sums} FROM guest_filter_daily WHERE {where}",args).fetchone()))
+        values["unknown"] = values["calls"]-values["receipts"]-values["rejected"]
+        for k in ("usd","rub"):
+            values[k] = format(Decimal(values[k]).scaleb(-9),'f').rstrip('0').rstrip('.') or "0"
+        rows.append((label,values))
+    return rows
+
+def classify(prompt, fx):
+    payload = json.dumps({"fx":fx,"prompt":prompt},ensure_ascii=False)
+    try:
+        result = subprocess.run(["node",str(SCRIPT)],input=payload,text=True,capture_output=True,timeout=16,
+            env={k:v for k,v in os.environ.items() if k in ("PATH","LANG","HARNESS_PROVIDER_KEYS_DIR","SSL_CERT_FILE","NODE_EXTRA_CA_CERTS")})
+        return json.loads(result.stdout) if result.returncode==0 else {}
+    except (OSError, ValueError, subprocess.TimeoutExpired):
+        return {}
+
+def memory(db, chat):
+    row = db.execute("SELECT topic,choices FROM guest_filter_memory WHERE chat=?",(chat,)).fetchone()
+    return (row[0],json.loads(row[1])) if row else ("",[])
+
+def card_ids(cards):
+    return [c["id"] for c in cards if c["group"]=="Плагины"]
+
+def render(faq, key, cards):
+    if key.startswith(("plugin/","integration/")):
+        card = next((c for c in cards if c["id"]==key),None)
+        if card:
+            if key.startswith("plugin/"):
+                return card["detail"],True
+            steps=card.get("steps",{})
+            entries=steps if isinstance(steps,list) else [s for group in steps.values() for s in group]
+            return " ".join(dict.fromkeys(entries)) or card["purpose"],False
+        key="withdrawn"
+    text=faq.template(key)
+    if key=="features":
+        from .public_faq import _overview
+        return _overview(text,cards),False
+    if key=="clarify":
+        items=[c.get("overview") or c["purpose"] for c in cards if c["group"]=="Плагины"]
+        if items:
+            text+="\n\n"+"\n".join(f"{i}. {item}" for i,item in enumerate(items,1))
+        else:
+            text=faq.template("scope")
+    return text,False
+
+ORDINALS = {"перв":0,"втор":1,"трет":2,"четверт":3,"пят":4,"шест":5,"седьм":6,"восьм":7,"девят":8,"десят":9}
+def selected_position(text):
+    match=re.fullmatch(r"(?:а |и )?(?:(?:расскажи |подробнее )?(?:про |о )?)?(?:(?:пункт|вариант) )?(\d{1,2}|[а-я]+)(?: (?:пункт[еа]?|вариант[ае]?))?",text)
+    if match:
+        value=match[1]
+        if value.isdecimal(): return int(value)-1
+        for stem,index in ORDINALS.items():
+            if re.fullmatch(stem+r"(?:ый|ой|ий|ую|ое|ая|ье|ий|ем|ом|я)",value):
+                return index
+    return None
+
+def options(faq,cards,question,shown):
+    labels={k:LABELS.get(k,a[:110]) for k,a in faq.topics() if k!="withdrawn"}
+    def rank(card):
+        terms = re.findall(r"[а-яa-z]{3,}",question.lower())
+        desc = (card["title"]+" "+card.get("keywords","")).lower()
+        return (card["id"] in shown,sum(t[:5] in desc for t in terms))
+    # Direct matching still sees every published card. Bound the optional provider prompt as the directory grows.
+    for c in sorted(cards,key=rank,reverse=True)[:40]:
+        labels[c["id"]]=(c["title"]+" — "+(c.get("overview") or c["purpose"]))[:150]
+    return labels
+
+def save(db, chat, rid, text, key, answer, detailed, cards):
+    db.execute("INSERT INTO guest_turns VALUES(?,?,?,?,?)",(chat,rid,text,fill_terms(db,answer),int(time()*1000)))
+    if detailed:
+        db.execute("INSERT INTO guest_detailed_answers VALUES(?,?)",(chat,rid))
+    shown=card_ids(cards) if key in ("features","clarify") else []
+    db.execute("""INSERT INTO guest_filter_memory VALUES(?,?,?) ON CONFLICT(chat) DO UPDATE SET
+               topic=excluded.topic,choices=excluded.choices""",(chat,key,json.dumps(shown)))
+
+# Public responses form the entire history sent to the classifier. Mask contact details in the new question.
+PRIVATE = re.compile(r"[\w.+%-]+@[\w.-]+\.[a-z]{2,}|(?:\+?\d[\s().-]*){10,15}|\b(?:sk-[\w-]{12,}|bearer\s+[\w./+=-]{6,})",re.I)
+
+def send(store,token,chat,rid,text,select=None):
+    from .guest_registration import RegistrationConflict
+    from starlette.exceptions import HTTPException
+    now=int(time())
+    date=day(now).isoformat()
+    digest=hashlib.sha256(text.encode()).hexdigest()
+    with store._write() as db:
+        store._active(db,token,chat)
+        prior=db.execute("SELECT text FROM guest_turns WHERE chat_id=? AND request_id=?",(chat,rid)).fetchone()
+        if prior:
+            if prior[0]!=text: raise RegistrationConflict("Request already used")
+            return
+        old=db.execute("SELECT fingerprint FROM guest_filter_attempt WHERE chat=? AND request=?",(chat,rid)).fetchone()
+        if old and old[0]!=digest: raise RegistrationConflict("Request already used")
+        if db.execute("SELECT 1 FROM guest_filter_attempt WHERE chat=? AND pending=1 AND started>? LIMIT 1",(chat,now-45)).fetchone():
+            raise HTTPException(409,"Предыдущее сообщение ещё обрабатывается.")
+        db.execute("UPDATE guest_filter_attempt SET pending=0 WHERE chat=? AND pending=1 AND started<=?",(chat,now-45))
+        cards=guest_cards(db)
+        topic,shown=memory(db,chat)
+        answer=purchase_reply(db,chat,text)
+        key,detail="quote",False
+        if answer is None:
+            answer,detail,key=store.faq.resolve(text,cards)
+        short=" ".join(re.findall(r"[^\W_]+",text.casefold().replace("ё","е")))
+        # Ordinals refer to the order actually shown, even if publication changed between turns.
+        pos=selected_position(short) if shown else None
+        if pos is not None:
+            key=shown[pos] if 0<=pos<len(shown) else "clarify"
+            if key!="clarify" and key not in card_ids(cards):
+                key="withdrawn"
+            answer,detail=render(store.faq,key,cards)
+        if key!="scope":
+            save(db,chat,rid,text,key,answer,detail,cards)
+            return
+        history=[r[0] for r in db.execute("SELECT answer FROM guest_turns WHERE chat_id=? ORDER BY rowid DESC LIMIT 2",(chat,))][::-1]
+        fallback="scope"
+        if short in ("да","давай","рассказывай","расскажите","продолжай","подробнее","ну давай","конечно"):
+            fallback="clarify" if shown else "features" if topic in ("intro","scope","withdrawn") or not topic else "clarify"
+        labels=options(store.faq,cards,text,shown)
+        configured=select is not None
+        today=db.execute("SELECT calls FROM guest_filter_daily WHERE day=?",(date,)).fetchone()
+        count=db.execute("SELECT COUNT(*) FROM guest_filter_attempt WHERE chat=?",(chat,)).fetchone()[0]
+        if not configured or old or len(text)>1200 or count>=12 or (today[0] if today else 0)>=limit(db):
+            answer,detail=render(store.faq,fallback,cards)
+            save(db,chat,rid,text,fallback,answer,detail,cards)
+            return
+        try:
+            fx=coins.rub_rate()
+        except ValueError:
+            answer,detail=render(store.faq,fallback,cards)
+            save(db,chat,rid,text,fallback,answer,detail,cards)
+            return
+        prompt={"options":labels,"previous_answers":[a if len(a)<=460 else a[:300]+" … "+a[-150:] for a in history],
+                "last_topic":topic,"shown_in_order":shown[:40],"question":PRIVATE.sub("[скрыто]",text)}
+        db.execute("INSERT INTO guest_filter_attempt VALUES(?,?,?,?,1)",(chat,rid,digest,now))
+        add(db,date,calls=1)
+    # Never hold the identity DB writer while waiting on the provider.
+    receipt=select(prompt,fx) or {}
+    chosen=receipt.get("id")
+    key=chosen if isinstance(chosen,str) and chosen in labels else fallback
+    if key=="scope" and fallback!="scope": key=fallback
+    with store._write() as db:
+        usage=receipt.get("usage")
+        if isinstance(usage,dict) and all(type(usage.get(k)) is int and usage[k]>=0 for k in ("input","cache","output","usd","rub")):
+            add(db,date,receipts=1,**{k:usage[k] for k in ("input","cache","output","usd","rub")})
+        elif receipt.get("rejected") is True:
+            add(db,date,rejected=1)
+        reserved=db.execute("UPDATE guest_filter_attempt SET pending=0 WHERE chat=? AND request=? AND pending=1",
+                            (chat,rid)).rowcount
+        # Account registration or expiry during a call never loses its independent expense.
+        active=db.execute("SELECT 1 FROM guest_chats WHERE chat_id=? AND claimed_actor IS NULL AND expires_at>?",(chat,int(time()))).fetchone()
+        if reserved and active and not db.execute("SELECT 1 FROM guest_turns WHERE chat_id=? AND request_id=?",(chat,rid)).fetchone():
+            cards=guest_cards(db)
+            if key.startswith(("plugin/","integration/")) and not any(c["id"]==key for c in cards):
+                key="withdrawn"
+            answer,detail=render(store.faq,key,cards)
+            save(db,chat,rid,text,key,answer,detail,cards)
+    if not active:
+        raise AuthenticationError("Guest session unavailable")
+    if not reserved:
+        raise HTTPException(409,"Запрос устарел. Обновите историю диалога.")
