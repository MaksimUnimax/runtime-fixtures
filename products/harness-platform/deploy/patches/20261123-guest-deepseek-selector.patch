diff --git a/products/harness-platform/tests/test_guest_selector.py b/products/harness-platform/tests/test_guest_selector.py
new file mode 100644
index 0000000..2160afd
--- /dev/null
+++ b/products/harness-platform/tests/test_guest_selector.py
@@ -0,0 +1,123 @@
+import json
+from concurrent.futures import ThreadPoolExecutor
+from datetime import timedelta
+from threading import Event
+from time import time
+from unittest import TestCase
+
+from starlette.exceptions import HTTPException
+
+from platform_core import guest_selector as selector
+from platform_core.guest_registration import RegistrationConflict, RegistrationStore
+from platform_core.identity import AuthenticationError
+
+
+class GuestSelector(TestCase):
+    def setUp(self):
+        self.store = self.enterContext(RegistrationStore(":memory:"))
+        self.db = self.store._db
+        self.guest = self.store.start_guest()
+        self.prompts = []
+
+    def choose(self, prompt, fx):
+        self.prompts.append(prompt)
+        return {"id":"features", "usage":{"input":100, "cache":50, "output":5, "usd":10, "rub":800}}
+
+    def send(self, rid, question, select=None, guest=None):
+        self.store.guest_turn(*(guest or self.guest), rid, question, select=select or self.choose)
+
+    def stats(self):
+        return selector.totals(self.db)[-1][1]
+
+    def test_context_and_idempotence(self):
+        self.send("a","Что делать?")
+        self.assertFalse(self.prompts)
+        self.send("b","Рассказывай")
+        self.send("b","Рассказывай")
+        self.assertEqual(len(self.prompts), 1)
+        context = self.prompts[0]
+        self.assertIn("Рассказать", context["previous_answers"][0])
+        self.assertEqual(context["last_topic"], "intro")
+        self.assertIn("Вот что я могу", self.db.execute("SELECT answer FROM guest_turns WHERE request_id='b'").fetchone()[0])
+        self.assertNotIn(self.guest[1], json.dumps(context))
+        with self.assertRaises(RegistrationConflict):
+            self.send("b","расскажи о другом")
+        self.assertEqual((self.stats()["calls"], self.stats()["rub"]), (1,"0.0000008"))
+        other = self.store.start_guest()
+        self.send("c","Фраза [qa] owner@example.test",guest=other)
+        self.assertEqual(self.prompts[-1]["previous_answers"], [])
+        self.assertNotIn("owner@example.test", self.prompts[-1]["question"])
+
+    def test_local_quotes_unknown_receipt_and_cap(self):
+        self.send("a","Сколько стоит 100 монет?")
+        self.send("b","А 200")
+        self.assertEqual(self.stats()["calls"],0)
+        self.db.execute("INSERT INTO guest_filter_setting VALUES(1,1)")
+        self.send("c","Сложный пересказ вопроса",select=lambda *args:{"id":"foreign body", "usage":None})
+        self.send("d","Эта реплика должна пройти локально")
+        self.assertEqual((self.stats()["calls"],self.stats()["unknown"]),(1,1))
+        self.assertFalse(self.prompts)
+        self.assertEqual(self.db.execute("SELECT answer FROM guest_turns WHERE request_id='c'").fetchone()[0],
+                         self.store.faq.template("scope"))
+
+    def test_expiry_registration_and_rollup(self):
+        first = self.guest
+        other = self.store.start_guest()
+        self.send("a","Необычная формулировка")
+        self.send("b","Необычная формулировка",guest=other)
+        self.store.register(other[0],"new-test","Local password for test",self.store.guest_recovery(other[0]))
+        with self.store._write() as db:
+            db.execute("UPDATE guest_chats SET expires_at=0 WHERE chat_id=?", (first[1],))
+            old = (selector.day(time())-timedelta(days=90)).isoformat()
+            selector.add(db, old, calls=3, rejected=3)
+            self.store._prune(db)
+        for table in ("guest_filter_memory","guest_filter_attempt"):
+            self.assertEqual(self.db.execute(f"SELECT count(*) FROM {table}").fetchone()[0],0)
+        self.assertEqual(self.db.execute("SELECT chat_id FROM guest_turns").fetchall(), [(other[1],)])
+        self.assertEqual(self.db.execute("SELECT count(*) FROM guest_filter_daily WHERE day=?", (old,)).fetchone()[0],0)
+        self.assertEqual((self.stats()["calls"],self.stats()["receipts"]),(5,2))
+        with self.assertRaises(AuthenticationError):
+            self.send("late","Рассказывай")
+
+    def test_withdrawal_during_selection_and_stale_ordinal(self):
+        self.send("list","Что ты умеешь?")
+        _, shown = selector.memory(self.db,self.guest[1])
+        self.assertGreaterEqual(len(shown),2)
+        def withdraw(key):
+            with self.store._write() as db:
+                db.execute("UPDATE product_directory SET listed=0 WHERE id=?",(key,))
+        withdraw(shown[0])
+        self.send("ordinal","Первое")
+        self.assertEqual(selector.memory(self.db,self.guest[1])[0],"withdrawn")
+        def choice(prompt,fx):
+            self.assertIn(shown[1],prompt["options"])
+            withdraw(shown[1])
+            return {"id":shown[1]}
+        self.send("race","Необычно сформулированная просьба",select=choice)
+        self.assertEqual(selector.memory(self.db,self.guest[1])[0],"withdrawn")
+
+    def test_chat_cap_and_independent_other_guest(self):
+        for i in range(15):
+            self.send(str(i),"Необычная реплика")
+        self.assertEqual(self.stats()["calls"],12)
+        self.send("first","Необычная реплика",guest=self.store.start_guest())
+        self.assertEqual(self.stats()["calls"],13)
+
+    def test_duplicate_while_waiting_and_replay(self):
+        entered, release = Event(), Event()
+        def waiting(prompt, fx):
+            entered.set()
+            self.assertTrue(release.wait(5))
+            return self.choose(prompt,fx)
+        with ThreadPoolExecutor(max_workers=1) as pool:
+            result = pool.submit(self.send, "repeat","Рассказывай",waiting)
+            self.assertTrue(entered.wait(5))
+            try:
+                with self.assertRaises(HTTPException) as error:
+                    self.send("repeat","Рассказывай")
+                self.assertEqual(error.exception.status_code,409)
+            finally:
+                release.set()
+            result.result(timeout=5)
+        self.send("repeat","Рассказывай")
+        self.assertEqual(self.stats()["calls"],1)
