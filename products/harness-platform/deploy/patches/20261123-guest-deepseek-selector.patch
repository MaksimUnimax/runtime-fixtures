@@ -0,0 +1,41 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {classify} from './guest-selector.mjs';
+
+const config={fx:810000,prompt:{question:'рассказывай',options:{features:'Обзор'}}};
+const now=()=>Date.UTC(2026,10,23,13);
+const usage={prompt_cache_hit_tokens:5,prompt_cache_miss_tokens:20,completion_tokens:4,prompt_tokens:25,total_tokens:29};
+function call(content, details={}) {
+  return classify(config,'test-only',async (url,req)=>{
+    assert.equal(url,'https://api.deepseek.com/chat/completions');
+    assert.equal(req.headers.Authorization,'Bearer test-only');
+    const body=JSON.parse(req.body);
+    assert.equal(body.tools, undefined);
+    assert.equal(req.body.includes('test-only'),false);
+    return {ok:true,json:async()=>({model:'deepseek-flash',usage,
+      choices:[{finish_reason:'stop',message:{content}}],...details})};
+  },now);
+}
+
+test('exactly one public ID, while valid usage is recorded independently', async()=>{
+  const valid=await call('{"id":"features"}');
+  assert.equal(valid.id,'features');
+  assert.equal(valid.usage.cache,5);
+  assert.ok(valid.usage.rub>0);
+  for(const content of ['I can answer','{"id":"other"}','{"id":"features","extra":"output"}',
+      '{"id":"other","id":"features"}','{"id":"constructor"}']) {
+    const bad=await call(content);
+    assert.equal(bad.id,null);
+    assert.deepEqual(bad.usage,valid.usage);
+  }
+});
+test('missing or inconsistent metering does not masquerade as zero spend',async()=>{
+  for(const u of [null,{...usage,total_tokens:0}]) {
+    const result=await call('{"id":"features"}',{usage:u});
+    assert.equal(result.usage,null);
+  }
+  const rejected=await classify(config,'test-only',async()=>({ok:false,status:429}),now);
+  assert.equal(rejected.rejected,true);
+  const unknown=await classify(config,'test-only',async()=>({ok:false,status:502}),now);
+  assert.equal(unknown.rejected,false);
+});
