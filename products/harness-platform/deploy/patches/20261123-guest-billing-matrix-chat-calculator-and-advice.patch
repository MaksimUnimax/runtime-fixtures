diff --git a/products/harness-platform/platform_core/guest_billing.py b/products/harness-platform/platform_core/guest_billing.py
new file mode 100644
index 0000000..8a72dd1
--- /dev/null
+++ b/products/harness-platform/platform_core/guest_billing.py
@@ -0,0 +1,62 @@
+"""Local guest pricing answers use the same coin settings and quotes as checkout."""
+import re
+
+from . import coins
+
+# Only a full purchase question in coins is a quote. Sales, delivery and ad costs are separate.
+_NUMBER = r"(?P<count>[+-]?[0-9]+(?: [0-9]{3})*(?:[.,][0-9]+)?)"
+_COINS = r"монет(?:а|ы|у|ок|ки|ка)?"
+_REQUEST = r"(?:(?:а|и|ну|подскажите|скажи|пожалуйста) )*"
+_QUANTITY = _NUMBER + r" " + _COINS
+_PRICE = r"(?:сколько (?:это )?(?:стоит|стоят|стоит купить|будет стоить|будут стоить|будет|выйдет за|я заплачу за)|во сколько (?:обойдется|обойдутся)|почем|цена|стоимость|посчитай(?: стоимость)?|рассчитай(?: стоимость)?)"
+_QUESTIONS = tuple(re.compile(_REQUEST + pattern) for pattern in (
+    _PRICE + r" " + _QUANTITY + r"(?: (?:в рублях|для октопорта))?",
+    _QUANTITY + r"(?: (?:это )?(?:сколько(?: (?:это )?(?:стоит|стоят|рублей|в рублях))?|по какой цене|в рублях))?",
+    r"(?:сколько (?:рублей |денег )?(?:нужно |надо )?(?:заплатить |отдать )?за|купить|хочу купить) " + _QUANTITY,
+))
+_SHORT = re.compile(_REQUEST + _NUMBER)
+
+def coin_label(value):
+    number = coins.display(value)
+    if "." in number:
+        word = "монеты"
+    else:
+        n = int(number)
+        word = ("монет" if 11 <= n % 100 <= 14 else "монета" if n % 10 == 1
+                else "монеты" if 2 <= n % 10 <= 4 else "монет")
+    return number.replace(".", ",") + " " + word
+
+def local_rate(rate):
+    whole, _, fraction = rate.partition(".")
+    return whole + "," + fraction.ljust(2, "0")
+
+def purchase_reply(db, chat, message):
+    text = " ".join(message.casefold().replace("ё", "е").split()).strip("?!.,:; ")
+    text = re.sub(r"\s*[,—:]\s*(?=[а-я])", " ", text).replace("чтоит", "стоит")
+    match = next((m for pattern in _QUESTIONS if (m := pattern.fullmatch(text))), None)
+    if match is None:
+        match = _SHORT.fullmatch(text)
+        if match is None:
+            return None
+        previous = db.execute("SELECT answer FROM guest_turns WHERE chat_id=? ORDER BY rowid DESC LIMIT 1", (chat,)).fetchone()
+        if not previous or "₽" not in previous[0] or "монет" not in previous[0]:
+            return None
+    raw = match["count"].replace(" ", "")
+    try:
+        count = coins.purchase_quantity(raw)
+    except ValueError:
+        return "Для расчёта укажите целое количество монет от 1 до 8 000 000."
+    rate = coins.sale_pricing(db)["rubPerCoin"]
+    total = coins.purchase_total(rate, count).removesuffix(".00").replace(".", ",")
+    return f"{coin_label(count * coins.UNIT)} × {local_rate(rate)} ₽ = {total} ₽."
+
+def fill_terms(db, answer):
+    if "{sale_price}" in answer:
+        answer = answer.replace("{sale_price}", local_rate(coins.sale_pricing(db)["rubPerCoin"]))
+    if "{signup_offer}" in answer:
+        amount = coins.signup_bonus(db)
+        offer = (f"При первой регистрации вы получите стартовый бонус — {coin_label(amount)}. "
+                 "На своих задачах вы сможете оценить, как быстро я расходую монеты."
+                 if amount else "Сейчас стартовый бонус за регистрацию не начисляется.")
+        answer = answer.replace("{signup_offer}", offer)
+    return answer
