[Unit]
Description=Research public API terms for the Octoport model hub
After=network-online.target octoport-hub-catalog.service
Wants=octoport-hub-catalog.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/octoport-model-hub/current/products/harness-platform
ExecStart=/opt/octoport-harness-inbound/runtime/venv/bin/python -m platform_core.hub_research --database /var/lib/octoport-model-hub/model-hub.sqlite3
Environment=PATH=/root/.nvm/versions/node/v22.22.1/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=280
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=tmpfs
BindPaths=/root/.codex_second
BindReadOnlyPaths=/root/.nvm/versions/node/v22.22.1
ProtectSystem=strict
InaccessiblePaths=-/etc/octoport -/var/lib/octoport-harness-inbound -/var/lib/private/octoport-harness-inbound -/opt/octoport-harness-inbound/incoming
ReadWritePaths=/var/lib/octoport-model-hub
