[Unit]
Description=Harness public seller service
After=network.target

[Service]
DynamicUser=yes
User=harness-prod
StateDirectory=harness-prod
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
WorkingDirectory=/opt/harness-prod/current/products/harness-platform
LoadCredential=integrations:/etc/harness-prod/integrations.key
Environment=HARNESS_INTEGRATIONS_KEY_FILE=%d/integrations
Environment=HARNESS_NODE_MODULES=/opt/harness-prod/runtime/v1/node_modules
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HARNESS_PROVIDER_KEYS_DIR=/var/lib/harness-prod/provider-keys
Environment=HARNESS_OPENROUTER_ENABLED=1
Environment=HARNESS_RUB_PER_USD=81.9290
ExecStart=/opt/harness-prod/runtime/v1/venv/bin/python -m platform_core.serve --state /var/lib/harness-prod --port 18763 --model live
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
