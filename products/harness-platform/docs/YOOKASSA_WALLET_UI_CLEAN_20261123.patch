 }
+
+/* Wallet UX refinement: no extra focus halo on the amount input. */
+dialog.octo-checkout > form input[type=number],
+dialog.octo-checkout > form input[type=number]:focus,
+dialog.octo-checkout > form input[type=number]:focus-visible {
+  appearance:textfield;
+  -moz-appearance:textfield;
+  outline:none !important;
+  outline-offset:0;
+  box-shadow:none !important;
+  border-color:var(--octo-line,#414850);
+}
+dialog.octo-checkout > form input[type=number]::-webkit-inner-spin-button,
+dialog.octo-checkout > form input[type=number]::-webkit-outer-spin-button {
+  -webkit-appearance:none;
+  margin:0;
+}
+dialog.octo-checkout .octo-checkout-widget-note:empty {
+  display:none;
+}
+dialog.octo-checkout .octo-checkout-widget-panel {
+  row-gap:12px;
+}
