+    def test_wallet_checkout_plain_language_and_clean_amount_focus(self):
+        response = self.client.get("/ui-assets/project/checkout.js")
+        self.assertEqual(response.status_code, 200)
+        script = response.text
+        self.assertIn("Перейти к оплате", script)
+        self.assertIn("<span>К оплате</span>", script)
+        self.assertNotIn("Продолжить к оплате", script)
+        self.assertNotIn("Безопасная оплата через ЮKassa", script)
+        self.assertNotIn("Платёжные реквизиты обрабатывает ЮKassa", script)
+        self.assertNotIn("ЮKassa отвечает медленно", script)
+        self.assertIn("showEmbedded(activeToken, activeDraft)", script)
+        self.assertIn("/api/coins/reconcile", script)
+        css = self.client.get("/ui-assets/project/checkout.css")
+        self.assertEqual(css.status_code, 200)
+        self.assertIn("input[type=number]:focus-visible", css.text)
+        self.assertIn("outline:none !important", css.text)
+        self.assertIn("::-webkit-inner-spin-button", css.text)
