 .octo-checkout header button { display:grid; place-items:center; flex:none; width:32px; height:32px; padding:0; border:1px solid var(--octo-line,#b3bbc5); border-radius:8px; font-size:0; }
 .octo-checkout header button::before { content:""; width:14px; height:14px; background:linear-gradient(45deg,transparent 44%,currentColor 45% 55%,transparent 56%),linear-gradient(-45deg,transparent 44%,currentColor 45% 55%,transparent 56%); }
+
+/* Official YooKassa form inside the existing Octoport wallet dialog. */
+.octo-checkout-with-widget {
+  width:min(530px,calc(100vw - 28px));
+  max-height:calc(100dvh - 28px);
+  overflow-y:auto;
+  padding:clamp(12px,3vw,24px);
+  box-shadow:0 24px 80px rgb(0 0 0 / .22);
+}
+.octo-checkout-widget-panel { display:grid; gap:14px; min-width:0; padding-top:14px; }
+.octo-checkout-widget-panel[hidden], .octo-checkout form[hidden] { display:none !important; }
+.octo-checkout-summary {
+  display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap;
+  gap:6px 14px; padding:12px 14px; border:1px solid var(--octo-line,#bcc3cd);
+  background:var(--octo-field,#fff); border-radius:10px;
+  font-size:13px; color:var(--octo-muted,#444c56);
+}
+.octo-checkout-summary strong { font-size:15px; font-weight:650; color:var(--octo-ink,#0f1115); }
+.octo-checkout-provider {
+  box-sizing:border-box; min-width:288px; min-height:260px; width:100%;
+  border-radius:10px; overflow:hidden; background:var(--octo-panel,#f8f9fb);
+}
+.octo-checkout-provider[hidden] { display:none; }
+.octo-checkout-widget-note {
+  margin:0; color:var(--octo-muted,#444c56); font:500 13px/1.5 var(--octo-font,system-ui);
+}
+.octo-checkout-widget-actions { display:flex; gap:10px; justify-content:space-between; flex-wrap:wrap; }
+.octo-checkout-widget-actions button {
+  box-sizing:border-box; min-height:38px; padding:8px 14px; border-radius:8px; cursor:pointer;
+  font:600 13px/1.4 var(--octo-font,system-ui); border:1px solid var(--octo-line,#bcc3cd);
+  background:var(--octo-field,#fff); color:var(--octo-ink,#0f1115);
+}
+.octo-checkout-widget-actions button[data-widget-check] {
+  color:var(--octo-on-action,#fff); background:var(--octo-action,#15171c);
+  border-color:var(--octo-action,#15171c);
+}
+.octo-checkout-widget-actions button[hidden] { display:none; }
+.octo-checkout-widget-actions button:disabled { opacity:.6; cursor:default; }
+.octo-checkout-widget-foot { margin:0; font-size:11px; line-height:1.5; color:var(--octo-muted,#444c56); }
+.octo-checkout-widget-success .octo-checkout-widget-note { font-size:15px; color:var(--octo-ink,#0f1115); }
+@media (max-width:390px) {
+  .octo-checkout-with-widget { width:calc(100vw - 12px); padding:10px; }
