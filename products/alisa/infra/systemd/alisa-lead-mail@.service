[Unit]
Description=Alisa finite synthetic confirmation email delivery (%i)

[Service]
Type=oneshot
User=alisa-worker-%i
Group=alisa-worker-%i
EnvironmentFile=/etc/alisa-platform/%i/platform.env
WorkingDirectory=/opt/alisa-platform/%i/current
ExecStart=/opt/alisa-platform/%i/current/.venv/bin/python /opt/alisa-platform/%i/current/infra/launch.py lead-mail
RuntimeMaxSec=110
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=96M
MemorySwapMax=0
TasksMax=32
UMask=0077
