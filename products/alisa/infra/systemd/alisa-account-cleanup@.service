[Unit]
Description=Alisa expired account state cleanup (%i)

[Service]
Type=oneshot
User=alisa-worker-%i
Group=alisa-worker-%i
EnvironmentFile=/etc/alisa-platform/%i/platform.env
WorkingDirectory=/opt/alisa-platform/%i/site-current
ExecStart=/opt/alisa-platform/%i/site-current/.venv/bin/python /opt/alisa-platform/%i/site-current/infra/launch.py account-cleanup
RuntimeMaxSec=60
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=96M
MemorySwapMax=0
TasksMax=32
UMask=0077
