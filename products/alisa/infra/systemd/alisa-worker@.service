[Unit]
Description=Alisa worker (%i)
After=network.target

[Service]
Type=simple
User=alisa-worker-%i
Group=alisa-worker-%i
EnvironmentFile=/etc/alisa-platform/%i/platform.env
WorkingDirectory=/opt/alisa-platform/%i/current
ExecStart=/opt/alisa-platform/%i/current/.venv/bin/python /opt/alisa-platform/%i/current/infra/launch.py worker
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
MemoryAccounting=yes
MemoryMax=96M
MemorySwapMax=0
TasksMax=128
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
