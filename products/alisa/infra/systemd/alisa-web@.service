[Unit]
Description=Alisa web (%i)
After=network.target

[Service]
Type=simple
User=alisa-web-%i
Group=alisa-web-%i
EnvironmentFile=/etc/alisa-platform/%i/web.env
WorkingDirectory=/opt/alisa-platform/%i/current
ExecStart=/opt/alisa-platform/%i/current/.venv/bin/python /opt/alisa-platform/%i/current/infra/launch.py web
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
MemoryAccounting=yes
MemoryMax=256M
MemorySwapMax=0
TasksMax=128
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
