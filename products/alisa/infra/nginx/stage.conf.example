# Install only after ENV-00 capacity admission and independent SOURCE review.
# Three separate server blocks; reuse ONLY new Alisa names and own certificate.
server {
    listen 443 ssl;
    server_name alisa-stage.octoport.ru;
    ssl_certificate /etc/letsencrypt/live/alisa-platform-bootstrap/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/alisa-platform-bootstrap/privkey.pem;
    client_max_body_size 1k;
    location /__engineering {
        satisfy all;
        allow REPLACE_WITH_ENGINEER_IP;
        deny all;
        auth_basic "Alisa engineering";
        auth_basic_user_file /etc/alisa-platform/stage/engineering.htpasswd;
        proxy_pass http://127.0.0.1:18100;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /api/engineering/ {
        satisfy all;
        allow REPLACE_WITH_ENGINEER_IP;
        deny all;
        auth_basic "Alisa engineering";
        auth_basic_user_file /etc/alisa-platform/stage/engineering.htpasswd;
        proxy_pass http://127.0.0.1:18100;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / { proxy_pass http://127.0.0.1:18100; proxy_set_header Host $host; }
}
server {
    listen 443 ssl;
    server_name alisa-admin-stage.octoport.ru;
    ssl_certificate /etc/letsencrypt/live/alisa-platform-bootstrap/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/alisa-platform-bootstrap/privkey.pem;
    location / { proxy_pass http://127.0.0.1:18101; proxy_set_header Host $host; }
}
server {
    listen 443 ssl;
    server_name id-stage.octoport.ru;
    ssl_certificate /etc/letsencrypt/live/alisa-platform-bootstrap/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/alisa-platform-bootstrap/privkey.pem;
    location / { proxy_pass http://127.0.0.1:18103; proxy_set_header Host $host; }
}
