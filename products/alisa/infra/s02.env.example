# Names and placeholders only. Not a runnable combined environment.
# Existing common/DB config stays separate for every service and migration role.
# SOURCE ONLY: applying these settings to stage needs exact S02 live approval.

# web only: opaque state/token encryption and confidential RP secret.
ALISA_ACCOUNTS_ENABLED=1
ALISA_PUBLIC_BASE_URL=https://alisa-stage.octoport.ru
ALISA_IDENTITY_ISSUER=https://id-stage.octoport.ru
ALISA_WEB_OIDC_CLIENT_ID=alisa_market_stage
ALISA_WEB_OIDC_CLIENT_SECRET=REPLACE_IN_PRIVATE_STORE
ALISA_WEB_SESSION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64URL_WITHOUT_PADDING
ALISA_AUTH_SERVICE_TOKEN=REPLACE_WITH_NEW_AUTH_ONLY_BFF_PLATFORM_SECRET
# ALISA_SERVICE_TOKEN remains a DIFFERENT S01 intake token.

# platform only: same auth API token, fixed issuer/client ID, own runtime DB.
# No identity key, confidential client secret or web session key here.

# identity only: own secret/DB/role, encrypted sessions/cache/mail, fixed issuer.
ALISA_IDENTITY_ENABLED=1
ALISA_IDENTITY_DATA_KEYS=REPLACE_WITH_FERNET_KEY_OR_ORDERED_COMMA_SEPARATED_ROTATION_KEYS
ALISA_IDENTITY_SIGNING_KEYS_B64=REPLACE_WITH_BASE64_JSON_ARRAY_OF_PEM_AND_ISSUED_AT
ALISA_PRODUCT_ORIGIN=https://alisa-stage.octoport.ru
ALISA_SMTP_HOST=127.0.0.1
ALISA_SMTP_PORT=18225
# Recipients are restricted to example.invalid; no real email admission.

# Explicit identity_clients --apply bootstrap only: NOT identity daemon env.
ALISA_WEB_OIDC_REDIRECT_URI=https://alisa-stage.octoport.ru/auth/callback
ALISA_PROBE_OIDC_CLIENT_ID=alisa_compatibility_stage
ALISA_PROBE_OIDC_CLIENT_SECRET=REPLACE_WITH_SEPARATE_SYNTHETIC_CLIENT_SECRET
ALISA_PROBE_OIDC_REDIRECT_URI=https://alisa-stage.octoport.ru/oidc-probe/callback
