# Names only; create independent private files for each process/environment.
ALISA_ENV=stage
ALISA_RELEASE=REPLACE_WITH_ARTIFACT_ID
ALISA_SECRET_KEY=REPLACE_WITH_RANDOM_PER_SERVICE_SECRET
ALISA_ALLOWED_HOSTS=127.0.0.1,localhost
ALISA_DB_NAME=alisa_stage_platform
ALISA_DB_USER=alisa_stage_platform_runtime
ALISA_DB_PASSWORD=REPLACE_IN_PRIVATE_STORE
ALISA_DB_HOST=127.0.0.1
ALISA_DB_PORT=5432
FOUNDATION_PROBE_ENABLED=0
ALISA_SERVICE_TOKEN=REPLACE_WITH_RANDOM_BFF_PLATFORM_SECRET
ALISA_ENGINEERING_AUTH=REPLACE_WITH_BASE64_BASIC_CREDENTIAL
ALISA_WEB_ORIGIN=https://alisa-stage.octoport.ru
ALISA_PLATFORM_URL=http://127.0.0.1:18102
# Identity uses its OWN DB, role, SECRET_KEY and config; no service token.
