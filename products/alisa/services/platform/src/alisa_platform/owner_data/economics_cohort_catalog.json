    "processing": {
      "fee_group": "processing",
      "fallback": {
        "fbo": {
          "constant": "0"
        },
        "fbs": {
          "multiply": [
            {
              "input": "quantity"
            },
            {
              "divide": [
                {
                  "add": [
                    {
                      "input": "processing_min"
                    },
                    {
                      "input": "processing_max"
                    }
                  ]
                },
                {
                  "constant": "2"
                }
              ]
            }
          ]
        }
      },
      "fallback_kind": {
        "fbo": "FBS_PROCESSING_NOT_APPLICABLE",
        "fbs": "SCHEME_TARIFF_ESTIMATE"
      }
    },
    "other": {
      "fee_group": "other",
