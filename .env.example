# Development-only PostgreSQL endpoint from infra/local/docker-compose.yml.
NODE_ENV=development
DATABASE_URL=postgres://product_control_plane:development_only_password@127.0.0.1:55432/product_control_plane
LOG_LEVEL=info
API_PORT=3000
WORKER_READY_DELAY_MS=0
# Placeholder only; standard base64 for exactly 32 random bytes.
AUTH_ROOT_SECRET_B64=REPLACE_WITH_32_BYTE_BASE64_SECRET
# Placeholder only: standard base64 encoding of a UTF-8 PKCS#8 Ed25519 private PEM.
ACCESS_TOKEN_SIGNING_PRIVATE_KEY_PEM_B64=REPLACE_WITH_ED25519_PKCS8_PEM_BASE64
ACCESS_TOKEN_SIGNING_KEY_ID=replace-with-key-id
# API-only config signer ring. Placeholder only; private material is never persisted or client-visible.
CONFIG_SIGNING_KEY_RING_JSON='{"version":1,"keys":[{"keyId":"replace-with-config-key-id","privateKeyPemB64":"REPLACE_WITH_ED25519_PKCS8_PEM_BASE64"}]}'
# Legacy singleton compatibility fallback (use only when CONFIG_SIGNING_KEY_RING_JSON is absent):
# CONFIG_SIGNING_PRIVATE_KEY_PEM_B64=REPLACE_WITH_ED25519_PKCS8_PEM_BASE64
# CONFIG_SIGNING_KEY_ID=replace-with-config-key-id
# Project-owned Octoport SMTP. The worker submits to the local MTA, which
# handles remote-MX TLS and queueing. SMTP credentials are optional and
# server-only when the local MTA requires authenticated submission.
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@octoport.ru
SMTP_FROM_NAME=Seller Agents / Octoport
SMTP_ENVELOPE_FROM=no-reply@octoport.ru
SMTP_TIMEOUT_MS=8000
