+def _active_campaigns(data, offset=0):
+    from semantics import Rejected
+    rows = data.get("list") if isinstance(data,dict) else None
+    if not isinstance(rows,list) or "total" in data and str(data["total"])!=str(len(rows)):
+        raise Rejected("READ_CAMPAIGN_RESPONSE_MISMATCH")
+    ids, out = set(), []
+    for row in rows:
+        if not isinstance(row,dict) or row.get("state")!="CAMPAIGN_STATE_RUNNING":
+            raise Rejected("READ_CAMPAIGN_RESPONSE_MISMATCH")
+        key = str(row.get("id",""))
+        if not re.fullmatch(r"[1-9][0-9]{0,19}",key) or int(key)>=2**64 or key in ids:
+            raise Rejected("READ_CAMPAIGN_RESPONSE_MISMATCH")
+        ids.add(key)
+        if row.get("advObjectType")=="REF_VK":
+            continue
+        payment = {row[k] for k in ("paymentType","PaymentType") if isinstance(row.get(k),str)}
+        if len(payment)>1:
+            raise Rejected("READ_CAMPAIGN_RESPONSE_MISMATCH")
+        out.append({"id":key,"title":str(row.get("title") or "")[:300],"state":row["state"],
+                    "paymentType":next(iter(payment),None),"advObjectType":row.get("advObjectType")})
+    out.sort(key=lambda r:int(r["id"]))
+    return {"total":len(out),"nextOffset":offset+PAGE_SIZE if offset+PAGE_SIZE<len(out) else None,"list":out[offset:offset+PAGE_SIZE]}
+
