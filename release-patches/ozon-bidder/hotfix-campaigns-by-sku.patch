+        total = payload.get("total")
+        if total is not None:
+            if not re.fullmatch(r"[0-9]{1,12}", str(total)) or expected not in (None, int(total)):
+                raise Rejected("READ_CAMPAIGN_RESPONSE_MISMATCH")
