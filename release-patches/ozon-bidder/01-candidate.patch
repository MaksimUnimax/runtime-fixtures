+    ("setup.plan","Вызови list, затем catalog, затем preview с настройками и конечным выбором. Прочитай готовый план. Подтверждение разрешено только новым сообщением продавца с точным кодом или кнопкой в форме.",("настро","запус","созда"),("config","selection")),
+    ("action.pause","Пауза прекращает изменения биддером. Текущая реклама продолжает работать в Ozon.",("пауза","приостанов","останови"),("id","revision")),
+    ("reason.history","Сначала прочитай history. Назови время, фактическую причину и проверенное изменение. Если изменений ещё не было, так и скажи.",("почему","причин","вчера"),("id",)),
+    ("report.summary","Используй факты из журнала и назови период. Раздели заказы и выкупы, расходы и прибыль.",("итог","результат","покажи"),("id",)),
+)
+GOAL_TEXT = {
+    "N1":("Сколько рублей из каждых ста рублей заказов можно тратить на всю рекламу.",("доля рекламы","из заказов")),
+    "N2":("Сколько рублей из каждых ста рублей выручки должно остаться после учтённых расходов.",("каждых 100","каждых ста","маржиналь")),
+    "N3":("Сколько рублей должно остаться после расходов с каждого выкупленного товара.",("с каждой","с единицы","с одного")),
+    "N4":("Помогаю увеличить количество выкупленных товаров в пределах расходов. Для выбора ставки нужна история.",("продавать больше","больше выкупов")),
+    "N5":("Ищу вариант, при котором после учтённых расходов у магазина в сумме остаётся больше денег.",("общую прибыль","больше прибыли")),
+    "N6":("Перераспределяю деньги между выбранными кампаниями в пределах общего бюджета.",("распредел","между кампаниями")),
+}
+GUIDES = Guides([Guide(catalog.PLUGIN,key,1,key.split(".")[0],text,aliases,fields) for key,text,aliases,fields in ROWS] +
+                [Guide(catalog.PLUGIN,"goal."+k.lower(),1,"goal",t,a,("strategy","target")) for k,(t,a) in GOAL_TEXT.items()])
+
+
+def tools(store, scope):
+    if not catalog.attached(store._db, scope, catalog.PLUGIN):
+        return []
+    def describe(bound, args):
+        with store._lock:
+            catalog.require_plugin(store._db, bound)
+        return GUIDES.lookup(catalog.PLUGIN, args["query"])
+    def run(bound, args):
+        op, data = args["operation"], args.get("fields", {})
+        turn, _ = current_turn()
+        with store._write() as db:
+            if turn is None or not live(db, turn, bound):
+                raise PermissionError("Поручение завершилось.")
+            catalog.require_plugin(db, bound)
+            if op == "guide":
+                return GUIDES.lookup(catalog.PLUGIN, data.get("query","overview"))
+            if op == "confirm":
+                receipt = data.get("receipt", "")
+                if not receipt or turn.get("question","").strip().casefold() != ("подтверждаю "+receipt[:12]).casefold():
+                    return {"ok":False,"message":"Для запуска введите код из проверенного плана или нажмите кнопку в форме."}
+            if op == "stopAll":
+                return {"ok":False,"message":"Общая остановка доступна в форме плагина."}
+            db.execute("SAVEPOINT bidder_command")
