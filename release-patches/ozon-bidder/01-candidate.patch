index 0000000..e88be03
--- /dev/null
+++ b/products/harness-platform/platform_core/user_plugins/bidder/catalog.py
@@ -0,0 +1,121 @@
+"""Resolve a selection against one permission-checked catalogue receipt."""
+from collections import Counter
+from hashlib import sha256
+import json
+
+from starlette.exceptions import HTTPException
+
+from ... import market_access, market_data, market_query
+from ..registry import OZON, attached, store_row
+
+PLUGIN = "ozon-bidder"
+
+
+def encoded(value):
+    return json.dumps(value, separators=(",", ":"), ensure_ascii=False, sort_keys=True, allow_nan=False)
+
+
+def fingerprint(value):
+    return sha256(encoded(value).encode()).hexdigest()
+
+
+def require_plugin(db, scope):
+    if not attached(db, scope, PLUGIN):
+        raise HTTPException(403, "Включите «Биддер Ozon» в этом чате.")
+
+
+def stores(db, scope):
+    require_plugin(db, scope)
+    return [dict(id=cid, name=name) for cid, name in db.execute("""
+        SELECT i.id,i.name FROM account_integrations i JOIN market_data_links l ON l.cid=i.id
+        JOIN chat_integrations g ON g.connection_id=i.id JOIN market_data_stores s ON s.id=l.store
+        WHERE g.chat_id=? AND i.workspace=? AND s.workspace=i.workspace AND i.provider=s.provider
+        AND i.provider='ozon' AND i.version=l.version AND i.status='verified' ORDER BY i.name,i.id""",
+        (scope.chat_id, scope.workspace_id))]
+
+
+def binding(db, scope, cid, *, ads=False):
+    require_plugin(db, scope)
+    store_row(db, scope, OZON, cid)
+    found = market_data.binding(db, scope.workspace_id, cid)
+    if not found or found[1] != "ozon" or not market_access.allowed(db, cid, "catalog"):
+        raise HTTPException(403, "Подтвердите доступ к товарам этого магазина.")
+    if ads:
+        row = db.execute("""SELECT k.checks FROM integration_access_checks k JOIN account_integrations i
+            ON i.id=k.cid AND i.version=k.version WHERE i.id=?""", (cid,)).fetchone()
+        checks = json.loads(row[0]) if row else {}
+        if any(checks.get(key) != "verified" for key in ("Seller", "Performance")):
+            raise HTTPException(403, "Подтвердите доступ к товарам и рекламе магазина.")
+    version, = db.execute("SELECT version FROM account_integrations WHERE id=?", (cid,)).fetchone()
+    return found[0], version
+
+
+class Catalog:
+    def __init__(self, cards, observed):
+        self.rows, self.unavailable, self.categories = {}, Counter(), {}
+        self.observed = observed
+        for card in cards:
+            if card.get("archived") is not False or not card.get("skus"):
+                reason = "archive" if card.get("archived") is True else "missingSku" if not card.get("skus") else "unknownStatus"
+                self.unavailable[reason] += 1
+                continue
+            category = card.get("category") or ""
+            for sku in card["skus"]:
+                if sku in self.rows:
+                    raise HTTPException(409, "Один товар встречается в каталоге дважды. Обновите каталог.")
+                self.rows[sku] = dict(sku=sku, title=card["title"], offer=card["offer"], card=card["id"], category=category)
+            self.categories[category] = card.get("categoryName") or category or "Без категории"
+        self.revision = fingerprint(sorted((sku, row["card"], row["category"], row["offer"], row["title"]) for sku, row in self.rows.items()))
+
+    def matches(self, query):
+        query = query.strip().casefold()
+        return {sku for sku, r in self.rows.items() if not query or
+                any(query in r[k].casefold() for k in ("sku", "offer", "title"))}
+
+    def page(self, query, offset=0, category=None):
+        keys = sorted(k for k in self.matches(query) if category is None or self.rows[k]["category"] == category)
+        counts = Counter(r["category"] for r in self.rows.values())
+        return dict(revision=self.revision, total=len(keys), observed=self.observed,
+                    items=[self.rows[k] for k in keys[offset:offset + 100]], unavailable=self.unavailable,
+                    categories=[dict(id=k, label=v, count=counts[k]) for k, v in sorted(self.categories.items())])
+
+    def resolve(self, selection):
+        if not isinstance(selection, dict) or set(selection) - {"all", "categories", "include", "exclude", "search"}:
+            raise ValueError("Проверьте выбор товаров.")
+        if type(selection.get("all", False)) is not bool:
+            raise ValueError("Проверьте выбор всех товаров.")
+        keys = set(self.rows) if selection.get("all") else set()
+        for name in ("categories", "include", "exclude", "search"):
+            items = selection.get(name, [])
+            if not isinstance(items, list) or any(not isinstance(i, str) for i in items):
+                raise ValueError("Проверьте список товаров и категорий.")
+            items = set(items)
+            if name == "search":
+                for q in items:
+                    if not q.strip():
+                        raise ValueError("Введите название или артикул.")
+                    keys.update(self.matches(q))
+            elif name == "categories":
+                if items - self.categories.keys():
+                    raise HTTPException(409, "Список категорий изменился.")
+                keys.update(k for k, r in self.rows.items() if r["category"] in items)
+            elif items - self.rows.keys():
+                raise HTTPException(409, "Состав каталога изменился. Проверьте выбор.")
+            elif name == "include":
+                keys.update(items)
+        keys.difference_update(selection.get("exclude", []))
+        if not keys:
+            raise ValueError("Выберите хотя бы один доступный товар.")
+        return sorted(keys)
+
+
+def load(db, scope, cid):
+    sid, _ = binding(db, scope, cid)
+    path = market_query.main_path(db)
+    if market_data.path_for(path, scope.workspace_id, "ozon").is_file():
+        with market_data.local(path, scope.workspace_id, "ozon") as local:
+            hit = market_query.fetch(db, local, cid, sid, "catalog", "", "")
+            if hit:
+                body, observed = hit
+                return Catalog(body["cards"], observed)
+    raise HTTPException(409, "Ещё нет подтверждённого каталога. Обновите товары в плагине Ozon.")
