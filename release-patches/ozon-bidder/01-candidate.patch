+"""Persistent single-flight reads and storage for write reconciliation."""
+from math import ceil
+import random
+import time
+from uuid import uuid4
+
+from ...marketplace_matrix.store_currency import retry_time
+
+TTL = {"campaigns":900,"products":3600,"today":900,"yesterday":21600,"spend":1800,
+       "cpo":3600,"prices":1800,"stocks":1800,"orders":21600,"finance":86400,
+       "limits":86400,"history":86400,"coefficients":604800}
+SCHEMA = (
+    """CREATE TABLE IF NOT EXISTS bidder_reads(store TEXT,profile TEXT,source TEXT,query TEXT,scope TEXT,
+        next_at INTEGER NOT NULL,attempt INTEGER NOT NULL DEFAULT 0,lease TEXT,until INTEGER NOT NULL DEFAULT 0,
+        fact TEXT,observed INTEGER,report_id TEXT,error TEXT,PRIMARY KEY(store,profile,source,query,scope))""",
+    """CREATE TABLE IF NOT EXISTS bidder_request_counts(store TEXT,profile TEXT,day TEXT,count INTEGER,
+        PRIMARY KEY(store,profile,day))""",
+    """CREATE TABLE IF NOT EXISTS bidder_quota(store TEXT,profile TEXT,group_id TEXT,not_before INTEGER NOT NULL,
+        PRIMARY KEY(store,profile,group_id))""",
+    """CREATE TABLE IF NOT EXISTS bidder_writes(id TEXT PRIMARY KEY,rule TEXT NOT NULL REFERENCES bidder_rules ON DELETE CASCADE,
+        revision INTEGER NOT NULL,campaign TEXT NOT NULL,field TEXT NOT NULL,sku TEXT NOT NULL,
+        before_hash TEXT NOT NULL,before_state TEXT NOT NULL,target TEXT NOT NULL,state TEXT NOT NULL,
+        observed TEXT,at INTEGER NOT NULL,UNIQUE(rule,revision,campaign,field,sku,before_hash,target))""",
+    """CREATE TABLE IF NOT EXISTS bidder_inflight(store TEXT,kind TEXT,resource TEXT,operation TEXT NOT NULL,
+        PRIMARY KEY(store,kind,resource))""",
+    """CREATE TABLE IF NOT EXISTS bidder_changes(operation TEXT PRIMARY KEY,store TEXT,campaign TEXT,
+        field TEXT,sku TEXT,at INTEGER,window TEXT)""",
+    """CREATE INDEX IF NOT EXISTS bidder_changes_resource ON bidder_changes(store,campaign,field,sku,at)""",
+    """CREATE TABLE IF NOT EXISTS bidder_delivery(event INTEGER PRIMARY KEY REFERENCES bidder_events ON DELETE CASCADE,
+        state TEXT NOT NULL,due INTEGER NOT NULL DEFAULT 0)""",
+)
+
+
+def install(db):
+    from .observations import SCHEMA as observations
+    for stmt in (*SCHEMA,*observations):
+        db.execute(stmt)
+
+
+def cadence_minutes(desired, pages, quota, reserved=0):
+    usable = quota * 4 // 5 - reserved
+    return max(desired, ceil(1440 * pages / usable)) if usable > 0 else None
+
+
+def acquire(db, key, group, now):
+    db.execute("INSERT OR IGNORE INTO bidder_reads(store,profile,source,query,scope,next_at) VALUES(?,?,?,?,?,0)", key)
+    lease = uuid4().hex
+    changed = db.execute("""UPDATE bidder_reads SET lease=?,until=? WHERE
+        (store,profile,source,query,scope)=(?,?,?,?,?) AND next_at<=? AND until<=?
+        AND NOT EXISTS(SELECT 1 FROM bidder_quota WHERE store=? AND profile=? AND group_id IN (?, '*') AND not_before>?)""",
+        (lease, now + 120, *key, now, now, key[0], key[1], group, now)).rowcount
+    return lease if changed else None
+
+
+def finish(db, key, lease, fact, now, ttl):
+    return db.execute("""UPDATE bidder_reads SET fact=?,observed=?,next_at=?,attempt=0,lease=NULL,until=0,error=NULL
+        WHERE (store,profile,source,query,scope)=(?,?,?,?,?) AND lease=? AND until>?""",
+        (fact, now, now + ttl, *key, lease, now)).rowcount == 1
+
+
+def later(db, key, lease, group, status, headers, now, *, reset=0, spacing=0):
+    row = db.execute("SELECT attempt FROM bidder_reads WHERE (store,profile,source,query,scope)=(?,?,?,?,?) AND lease=?", (*key, lease)).fetchone()
+    if not row:
+        return None
+    attempt = row[0]
+    backoff = (7, 14, 28, 56, 112)[attempt] if attempt < 5 else 900
+    known = retry_time(headers, now)
+    until = ceil(max(reset, spacing, known if known is not None else now+backoff, now) + random.uniform(.01, 1))
+    if status == 429:
+        db.execute("""INSERT INTO bidder_quota VALUES(?,?,?,?) ON CONFLICT DO UPDATE
+            SET not_before=max(not_before,excluded.not_before)""", (*key[:2], group, until))
+        until = db.execute("SELECT max(not_before) FROM bidder_quota WHERE store=? AND profile=? AND group_id IN (?, '*')",
+                           (*key[:2], group)).fetchone()[0]
+    db.execute("""UPDATE bidder_reads SET next_at=?,attempt=attempt+1,lease=NULL,until=0,error=?
+        WHERE (store,profile,source,query,scope)=(?,?,?,?,?) AND lease=?""",
+        (until, str(status), *key, lease))
+    return until
+
+
+def seller_quota(db, key, lease, now):
+    from datetime import datetime, timedelta, time as day_start
+    from zoneinfo import ZoneInfo
+    tz = ZoneInfo("Europe/Moscow")
+    day = datetime.fromtimestamp(now,tz).date()
+    midnight = int(datetime.combine(day+timedelta(days=1),day_start(),tz).timestamp())
+    db.execute("INSERT OR IGNORE INTO bidder_request_counts VALUES(?,?,?,0)",(*key[:2],str(day)))
+    used = db.execute("UPDATE bidder_request_counts SET count=count+1 WHERE store=? AND profile=? AND day=? AND count<40",
+                      (*key[:2],str(day))).rowcount
+    due = now+61 if used else midnight
+    db.execute("""INSERT INTO bidder_quota VALUES(?,?,'orders-by-sku',?) ON CONFLICT DO UPDATE
+        SET not_before=max(not_before,excluded.not_before)""",(*key[:2],due))
+    if not used:
+        db.execute("""UPDATE bidder_reads SET next_at=?,until=0,lease=NULL WHERE
+            (store,profile,source,query,scope)=(?,?,?,?,?) AND lease=?""",(due,*key,lease))
+    return bool(used)
