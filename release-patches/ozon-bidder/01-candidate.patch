+        inv.update(externalCoverageVerified=True,outsideObligations=11500)
+        self.assertFalse(campaigns.campaign_plan(inv,["123"],cfg()|{"campaigns":["7"]})["ready"])
+
+    def test_write_units_and_keywords(self):
+        row=inventory("7")["campaigns"][0]
+        with self.assertRaises(ValueError): campaigns.change_payload("bid",row,"4.50","123")
+        row["products"]["123"].update(keywordsVerified=True,emptyKeywords=True)
+        self.assertEqual(campaigns.change_payload("bid",row,"4.50","123")[2]["bids"][0]["bid"],"4500000")
+        self.assertEqual(campaigns.change_payload("weeklyBudget",row,1000)[2],{"weeklyBudget":"1000000000"})
+
+    def test_waiting_and_no_duplicate_after_restart(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path=Path(directory)/"work.db"
+            key=("store","performance","today","day","version")
+            with sqlite3.connect(path) as db:
+                queue.install(db)
+                lease=queue.acquire(db,key,"stats",100)
+                self.assertIsNotNone(lease)
+                self.assertIsNone(queue.acquire(db,key,"stats",101))
+                when=queue.later(db,key,lease,"stats",429,{"Retry-After":"60"},100,reset=190)
+                self.assertGreaterEqual(when,190)
+            with sqlite3.connect(path) as db:
+                self.assertIsNone(queue.acquire(db,key,"stats",180))
+                self.assertIsNotNone(queue.acquire(db,key,"stats",when))
+                self.assertIsNotNone(queue.acquire(db,("other",*key[1:]),"stats",180))
+
+    def test_rate_dates_and_fallback(self):
+        key=("s","p","x","q","g")
+        with sqlite3.connect(":memory:") as db:
+            queue.install(db)
+            for attempt,wait in enumerate([7,14,28,56,112,900]):
+                now=attempt*1000
+                lease=queue.acquire(db,key,"x",now)
+                when=queue.later(db,key,lease,"x",429,{"Retry-After":"bad"},now)
+                self.assertTrue(now+wait<=when<=now+wait+1)
+            now=9000
+            when=queue.later(db,key,queue.acquire(db,key,"x",now),"x",429,{"Retry-After":"Thu, 01 Jan 1970 03:00:00 GMT"},now)
+            self.assertGreaterEqual(when,10800)
+        self.assertEqual(queue.cadence_minutes(5,2,100),36)
+        self.assertIsNone(queue.cadence_minutes(5,2,100,80))
