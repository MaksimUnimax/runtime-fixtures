+"""Scoped, paginated Performance reads. Secret material never enters snapshots."""
+import asyncio
+import json
+import time
+
+import httpx
+from starlette.exceptions import HTTPException
+
+from ...chat_connections import unseal
+from ...marketplace_matrix.ozon_campaign_actions import valid_id
+from . import catalog, queue
+from .economy import number
+
+ORIGIN = "https://api-performance.ozon.ru"
+ROOT = "/api/client/campaign"
+
+
+class Deferred(Exception):
+    pass
+
+
+def normalize_campaign(row, products):
+    strategy = row.get("productAutopilotStrategy")
+    if isinstance(strategy, dict):
+        strategy = strategy.get("strategy")
+    return {"id":str(row["id"]), "payment":row.get("PaymentType",row.get("paymentType")), "state":row["state"],
+            "strategy":strategy,"placement":row.get("placement"),
+            "weeklyRub":str(number(row["weeklyBudget"])/1_000_000) if row.get("weeklyBudget") is not None else None,
+            "addMode":(row.get("autopilot") or {}).get("skuAddMode"), "products":products}
+
+
+class Performance:
+    def __init__(self, app):
+        self.app = app
+        self.tokens = {}
+        self.token_lock = asyncio.Lock()
+
+    def check(self, db, scope, cid, pin):
+        if catalog.binding(db,scope,cid,ads=True) != pin:
+            raise HTTPException(403, "Подключение изменилось.")
+
+    async def token(self, scope, cid, pin):
+        async with self.token_lock:
+            with self.app.identity._lock:
+                db = self.app.identity._db
+                self.check(db,scope,cid,pin)
+                key = (scope.workspace_id,cid,pin[1])
+                found = self.tokens.get(key)
+                if found and found[1] > time.time():
+                    return found[0]
+                sealed, = db.execute("SELECT encrypted FROM account_integrations WHERE id=? AND workspace=?",
+                                      (cid,scope.workspace_id)).fetchone()
+                fields = unseal(scope.workspace_id,"ozon",cid,sealed)
+            reply = await self.app.http.post(ORIGIN+"/api/client/token",json={"client_id":fields["performance_id"],
+                "client_secret":fields["performance_secret"],"grant_type":"client_credentials"})
+            reply.raise_for_status()
+            payload = reply.json()
+            value = payload["access_token"]
+            if not isinstance(value,str) or not value or any(c.isspace() for c in value):
+                raise ValueError("Ozon не подтвердил доступ к рекламе.")
+            self.tokens = {k:v for k,v in self.tokens.items() if v[1] > time.time()}
+            self.tokens[key] = value, time.time()+max(0,int(payload["expires_in"])-30)
+            return value
+
+    async def read(self, scope, cid, pin, source, query, path, params=None, body=None, ttl=900, since=None, seller=False, stamps=None):
+        key = (pin[0],"seller" if seller else "performance",source,query,catalog.fingerprint([cid,pin[1]]))
+        if seller and (path != "/v1/analytics/data" or source != "orders-by-sku" or body is None):
+            raise ValueError("Неизвестный источник заказов.")
+        now = int(time.time())
+        with self.app.identity._write() as db:
+            self.check(db,scope,cid,pin)
+            cached = db.execute("""SELECT fact,observed FROM bidder_reads WHERE (store,profile,source,query,scope)=(?,?,?,?,?)
+                AND error IS NULL AND observed>?""", (*key,max(now-ttl,(since or 0)-1))).fetchone()
+            if cached and cached[0] is not None:
+                if stamps is not None:
+                    stamps.append(cached[1])
+                return json.loads(cached[0])
+            if since is not None:
+                db.execute("""UPDATE bidder_reads SET next_at=min(next_at,?) WHERE
+                    (store,profile,source,query,scope)=(?,?,?,?,?) AND observed<? AND error IS NULL""",(now,*key,since))
+            lease = queue.acquire(db,key,source,now)
+            if not lease:
+                raise Deferred()
+            if seller:
+                from .queue import seller_quota
+                if not seller_quota(db,key,lease,now):
+                    return None
+        try:
+            for attempt in range(2):
+                if seller:
+                    with self.app.identity._lock:
+                        db = self.app.identity._db
+                        self.check(db,scope,cid,pin)
+                        sealed, = db.execute("SELECT encrypted FROM account_integrations WHERE id=? AND workspace=?",
+                                             (cid,scope.workspace_id)).fetchone()
+                        fields = unseal(scope.workspace_id,"ozon",cid,sealed)
+                    headers = {"Client-Id":fields["client_id"],"Api-Key":fields["api_key"]}
+                    origin = "https://api-seller.ozon.ru"
+                else:
+                    token = await self.token(scope,cid,pin)
+                    with self.app.identity._lock:
+                        self.check(self.app.identity._db,scope,cid,pin)
+                    headers = {"Authorization":"Bearer "+token}
+                    origin = ORIGIN
+                reply = await self.app.http.request("GET" if body is None else "POST",origin+path,
+                    headers=headers,params=params,json=body,timeout=25)
+                if seller or reply.status_code != 401 or attempt:
+                    break
+                self.tokens.pop((scope.workspace_id,cid,pin[1]),None)
+            reply.raise_for_status()
+            result = reply.json()
+            if not isinstance(result,dict):
+                raise ValueError("Ozon вернул неполный ответ.")
+            with self.app.identity._write() as db:
+                self.check(db,scope,cid,pin)
+                observed = int(time.time())
+                if not queue.finish(db,key,lease,catalog.encoded(result),observed,ttl):
+                    raise Deferred()
+            if stamps is not None:
+                stamps.append(observed)
+            return result
+        except (httpx.HTTPError, ValueError, KeyError) as error:
+            response = getattr(error,"response",None)
+            status = response.status_code if response is not None else "network_or_schema"
+            headers = response.headers if response is not None else {}
+            with self.app.identity._write() as db:
+                queue.later(db,key,lease,"*",status,headers,int(time.time()),
+                            spacing=int(time.time())+86400 if status in (400,401,403) else 0)
+            raise Deferred("Ozon временно не подтвердил данные.") from None
+
+    async def inventory(self, scope, cid, *, since=None):
+        with self.app.identity._lock:
+            pin = catalog.binding(self.app.identity._db,scope,cid,ads=True)
+        stamps = []
+        payload = await self.read(scope,cid,pin,"campaigns","",ROOT,since=since,stamps=stamps)
+        rows = payload.get("list")
+        if not isinstance(rows,list) or int(payload.get("total",len(rows))) != len(rows):
+            raise Deferred("Ozon не подтвердил полный список кампаний.")
+        output, ids, unclassified = [], set(), False
+        for row in rows:
+            ident = str(row["id"])
+            if not valid_id(ident) or ident in ids:
+                raise Deferred("Ozon не подтвердил номера кампаний.")
+            ids.add(ident)
+            if row.get("state") in ("CAMPAIGN_STATE_ARCHIVED","CAMPAIGN_STATE_FINISHED"):
+                continue
+            payments = {row[k] for k in ("PaymentType", "paymentType") if k in row}
+            if payments != {"CPC"}:
+                unclassified = True
+                continue
+            members, page = {}, 1
+            while True:
+                data = await self.read(scope,cid,pin,"products",f"{ident}.{page}", ROOT+"/"+ident+"/v2/products",
+                                       {"page":page,"pageSize":100},ttl=900,since=since,stamps=stamps)
+                goods = data.get("products")
+                if not isinstance(goods,list) or len(goods)>100:
+                    raise Deferred("Ozon не подтвердил состав кампании.")
+                for product in goods:
+                    sku = str(product["sku"])
+                    if not valid_id(sku) or sku in members:
+                        raise Deferred("Повтор товара при чтении страниц кампании.")
+                    members[sku] = {k:product[k] for k in ("bid","targetCir","topPosition") if k in product}
+                    # A missing targeting field is not proof of an empty keyword list.
+                    members[sku]["keywordsVerified"] = isinstance(product.get("phrases"),list) and isinstance(product.get("stopWords"),list)
+                    members[sku]["emptyKeywords"] = product.get("phrases") == [] and product.get("stopWords") == []
+                if len(goods)<100:
+                    if "total" in data and int(data["total"]) != len(members):
+                        raise Deferred("Изменился состав кампании.")
+                    break
+                page += 1
+            output.append(normalize_campaign(row,members))
+        cpo, page, total = {}, 1, None
+        while True:
+            result = await self.read(scope,cid,pin,"cpo",str(page), ROOT+"/search_promo/v2/products",
+                                     body={"page":page,"pageSize":100},ttl=900,since=since,stamps=stamps)
+            goods, count = result["products"], int(result["total"])
+            if (total is not None and count!=total) or not isinstance(goods,list) or len(goods)>100:
+                raise Deferred("Ozon не подтвердил состав оплаты за заказ.")
+            total = count
+            for row in goods:
+                sku = str(row["sku"])
+                if not valid_id(sku) or sku in cpo or type(row.get("searchPromoStatus")) is not bool:
+                    raise Deferred("Некорректные сведения об оплате за заказ.")
+                cpo[sku] = row["searchPromoStatus"]
+            if len(cpo)==total:
+                break
+            if not goods or len(cpo)>total:
+                raise Deferred("Неполные сведения об оплате за заказ.")
+            page += 1
+        stamp=int(time.time())
+        inv={"complete":True,"at":stamp,"campaigns":output,"cpo":cpo}
+        key=(pin[0],"performance","inventory","",catalog.fingerprint([cid,pin[1]]))
+        with self.app.identity._write() as db:
+            self.check(db,scope,cid,pin)
+            if not stamps or not 0<=stamp-min(stamps)<=900:
+                raise Deferred("Данные о составе рекламы устарели.")
+            inv.update(at=min(stamps), unclassifiedSpend=unclassified)
+            db.execute("""INSERT INTO bidder_reads(store,profile,source,query,scope,next_at,fact,observed)
+                VALUES(?,?,?,?,?,?,?,?) ON CONFLICT DO UPDATE SET next_at=excluded.next_at,fact=excluded.fact,
+                observed=excluded.observed,error=NULL""",(*key,inv["at"]+900,catalog.encoded(inv),inv["at"]))
+        return inv
+
+    async def execute(self, scope, item, candidate, now):
+        """Send one confirmed intent. A transport error leaves the resource fenced."""
+        from . import executor, state
+        inv = await self.inventory(scope,item["cid"],since=int(time.time()))
+        row = next((r for r in inv["campaigns"] if r["id"]==candidate["campaign"]),None)
+        if row is None or catalog.fingerprint(row)!=candidate["baseline"]:
+            raise Deferred("Настройки рекламы изменились после расчёта.")
+        if inv.get("unclassifiedSpend") or not inv["complete"]:
+            raise Deferred("Изменилась полнота данных о других расходах.")
+        pin = item["store"],item["key_version"]
+        token = await self.token(scope,item["cid"],pin)
+        with self.app.identity._write() as db:
+            self.check(db,scope,item["cid"],pin)
+            proof = db.execute("""SELECT value,proof,observed FROM bidder_proposals
+                WHERE (rule,revision,window,campaign,sku,field)=(?,?,?,?,?,?)""",
+                (item["id"],item["revision"],candidate["window"],row["id"],candidate["sku"],candidate["field"])).fetchone()
+            if not proof or proof[:2]!=(candidate["value"],candidate["baseline"]) or not 0<=now-proof[2]<=60:
+                raise Deferred("Нужно повторить расчёт с текущими данными.")
+            intent = executor.open_intent(db,scope,item,row,candidate["field"],candidate["sku"],
+                                          candidate["value"],candidate["window"],int(time.time()))
+        if intent is None:
+            return
+        ident,method,suffix,body = intent
+        try:
+            reply = await self.app.http.request(method,ORIGIN+ROOT+"/"+row["id"]+suffix,
+                headers={"Authorization":"Bearer "+token},json=body,timeout=20)
+            if reply.status_code==429:
+                from ...marketplace_matrix.store_currency import retry_time
+                until = int(retry_time(reply.headers,time.time()) or time.time()+900)+1
+                with self.app.identity._write() as db:
+                    db.execute("""INSERT INTO bidder_quota VALUES(?,'performance','*',?) ON CONFLICT DO UPDATE
+                        SET not_before=max(not_before,excluded.not_before)""",(pin[0],until))
+        except httpx.HTTPError:
+            pass
+        # Even a 2xx reply does not release the fence.
+        after = int(time.time())+1
+        await asyncio.sleep(max(0,after-time.time()))
+        observed = await self.inventory(scope,item["cid"],since=after)
+        self.reconcile(scope,item,observed)
+
+    def reconcile(self, scope, item, inventory):
+        from . import executor
+        if not inventory.get("complete"):
+            return
+        by_id = {row["id"]:row for row in inventory["campaigns"]}
+        with self.app.identity._write() as db:
+            self.check(db,scope,item["cid"],(item["store"],item["key_version"]))
+            pending = db.execute("""SELECT w.id,w.campaign,w.at FROM bidder_writes w JOIN bidder_rules r ON r.id=w.rule
+                WHERE r.id=? AND r.cid=? AND w.state='unknown'""",(item["id"],item["cid"])).fetchall()
+            for ident,campaign,at in pending:
+                if inventory["at"]>at and campaign in by_id:
+                    executor.reconcile(db,ident,by_id[campaign])
