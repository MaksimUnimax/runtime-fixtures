+            db.execute("RELEASE bidder_command")
+            if op == "catalog":
+                return {**result, "items":result["items"][:12], "nextOffset":int(data.get("offset",0))+12 if result["total"]>int(data.get("offset",0))+12 else None}
+            if op in ("get","preview","confirm","pause","stop"):
+                return {k:v for k,v in result.items() if k in ("id","cid","revision","state","plan","receipt","config")} | {
+                    "selectedCount":len(result["skus"]), "confirmationText":"Подтверждаю "+result["receipt"][:12]}
+            if op == "history":
