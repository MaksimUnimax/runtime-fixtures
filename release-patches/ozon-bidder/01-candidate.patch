+def cfg(goal="N1", mode="observe"):
+    return dict(name="Example",strategy=goal,mode=mode,target="15",budget="12000",reserve="0",band="2",step="10",
+                parameterMax="8",campaigns=["7"] if mode=="auto" else [],growth=True,interval=15,days=list(range(7)),timezone="UTC",start="00:00",end="23:59:59")
+
+
+def inventory(*ids, products=None):
+    return {"at":int(time.time()),"complete":True,"cpo":{},"campaigns":[
+        dict(id=i,payment="CPC",state=campaigns.ACTIVE,strategy="TARGET_BIDS",addMode=campaigns.MANUAL,weeklyRub="1000",
+             products={s:{"bid":"5"} for s in (products or ["123"])}) for i in ids]}
