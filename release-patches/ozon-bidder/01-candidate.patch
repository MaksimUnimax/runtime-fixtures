@@ -0,0 +1,81 @@
+"""Durable journal for an authorized campaign operation and independent read-back."""
+import json
+from uuid import uuid4
+
+from starlette.exceptions import HTTPException
+
+from . import campaigns, catalog, economy, state
+
+
+def field_value(campaign, field, sku):
+    if field == "weeklyBudget":
+        return economy.number(campaign.get("weeklyRub"))
+    value = campaign["products"][sku].get(field)
+    if field == "bid":
+        return economy.number(value) / 1_000_000
+    if field == "targetCir":
+        return economy.number(value)
+    raise ValueError("Неизвестный параметр рекламы.")
+
+
+def open_intent(db, scope, item, before, field, sku, value, window, now):
+    revision, rule_id = item["revision"],item["id"]
+    latest = state.rule(db,scope,rule_id)
+    cfg = latest["config"]
+    if (latest["state"] != "active" or latest["revision"] != revision or cfg["mode"] != "auto"
+            or catalog.binding(db,scope,item["cid"],ads=True) != (item["store"],item["key_version"])
+            or state.next_time(cfg,now) != now):
+        raise ValueError("Управление приостановлено или изменились права.")
+    campaign = before["id"]
+    resources = [("campaign",campaign),*(("sku",s) for s in before["products"])]
+    if not before["products"] or before["state"]!=campaigns.ACTIVE or not set(before["products"])<=set(latest["skus"]):
+        raise ValueError("Изменился состав или состояние рекламы.")
+    for kind, resource in resources:
+        if not db.execute("""SELECT 1 FROM bidder_ownership WHERE (store,kind,resource,rule,revision)=(?,?,?,?,?)""",
+                (item["store"],kind,resource,rule_id,revision)).fetchone():
+            raise ValueError("Другая стратегия управляет рекламой.")
+        if db.execute("SELECT 1 FROM bidder_inflight WHERE (store,kind,resource)=(?,?,?)",(item["store"],kind,resource)).fetchone():
+            raise ValueError("Сначала нужно сверить предыдущую запись Ozon.")
+    prior = db.execute("""SELECT at,window FROM bidder_changes WHERE store=? AND campaign=? AND field=?
+            AND sku=? ORDER BY at DESC LIMIT 1""",(item["store"],campaign,field,sku)).fetchone()
+    if prior and (prior[1]>=window or now-prior[0]<cfg.get("changeHours",24)*3600):
+        raise ValueError("Ожидаю следующее независимое окно наблюдения.")
+    value = economy.number(value)
+    current = field_value(before,field,sku)
+    if value==current:
+        return None
+    if field != "weeklyBudget" and value>economy.number(cfg.get("parameterMax")) or (
+        field=="weeklyBudget" and value>economy.number(cfg["budget"])-economy.number(cfg.get("reserve",0))):
+        raise ValueError("Изменение превышает согласованный предел.")
+    if field!="weeklyBudget" and abs(value-current)>current*economy.number(cfg.get("step"))/100:
+        raise ValueError("Изменение превышает согласованный шаг.")
+    method, suffix, body = campaigns.change_payload(field,before,value,sku)
+    ident = uuid4().hex
+    ok = db.execute("""INSERT OR IGNORE INTO bidder_writes(id,rule,revision,campaign,field,sku,before_hash,before_state,
+        target,state,at) VALUES(?,?,?,?,?,?,?,?,?,'unknown',?)""",
+        (ident,rule_id,revision,campaign,field,sku,catalog.fingerprint(before),catalog.encoded(before),str(value),now)).rowcount
+    if not ok:
+        return None
+    db.executemany("INSERT INTO bidder_inflight VALUES(?,?,?,?)",[(item["store"],k,r,ident) for k,r in resources])
+    db.execute("INSERT INTO bidder_changes VALUES(?,?,?,?,?,?,?)",(ident,item["store"],campaign,field,sku,now,window))
+    return ident,method,suffix,body
+
+
+def reconcile(db, ident, observation):
+    row = db.execute("SELECT rule,revision,field,sku,before_state,target,state FROM bidder_writes WHERE id=?",(ident,)).fetchone()
+    if not row or row[-1]!="unknown":
+        return False
+    rule,rev,field,sku,raw,value,_ = row
+    expected = json.loads(raw)
+    if field=="weeklyBudget":
+        expected["weeklyRub"] = observation.get("weeklyRub")
+    elif sku in observation.get("products",{}):
+        expected["products"][sku][field] = observation["products"][sku].get(field)
+    if expected != observation or field_value(observation,field,sku) != economy.number(value):
+        return False
+    db.execute("UPDATE bidder_writes SET state='verified',observed=? WHERE id=?",(catalog.fingerprint(observation),ident))
+    db.execute("DELETE FROM bidder_inflight WHERE operation=?",(ident,))
+    state.event(db,rule,rev,"verified",{"campaign":observation["id"],"field":field,"value":value,
+                "message":"Ozon подтвердил изменение отдельным чтением."})
+    return True
+
