+"""One background loop. Only accepted rules can request current sources."""
+import asyncio
+from datetime import datetime, timedelta
+import json
+import logging
+import time
+from zoneinfo import ZoneInfo
+
+from starlette.exceptions import HTTPException
+
+from ... import market_access, market_data, market_query
+from ...storage import Scope
+from . import catalog, state, observations, economy
+from .queue import TTL
+
+SOURCE_SET = {"catalog":86400, "prices":TTL["prices"], "inventory":TTL["stocks"], "orders":TTL["orders"],
+              "advertising":TTL["history"], "realized-items":TTL["finance"], "finance":TTL["finance"],
+              "settled-advertising":TTL["history"]}
+
+
+def refresh(db, item, now):
+    """Reopen completed scoped jobs only when due; no seed or year-long import."""
+    end = datetime.fromtimestamp(now, ZoneInfo("Europe/Moscow")).date() - timedelta(days=1)
+    start = end - timedelta(days=item["config"].get("windowDays", 7) - 1)
+    coverage = {}
+    for source, ttl in SOURCE_SET.items():
+        if source in ("realized-items", "finance", "settled-advertising") and item["config"]["strategy"] == "N1":
+            continue
+        if not market_access.allowed(db, item["cid"], source):
+            coverage[source] = "denied"
+            continue
+        dates = ("","") if source in ("catalog", "prices", "inventory") else (str(start), str(end))
+        key = market_data.enqueue(db, item["store"], source, *dates, cid=item["cid"])
+        status, finished = db.execute("SELECT state,finished FROM market_data_tasks WHERE id=?", (key,)).fetchone()
+        if status in ("done","incomplete") and (finished is None or now - finished >= ttl):
+            db.execute("UPDATE market_data_tasks SET state='queued',due=? WHERE id=?", (now,key))
+            status = "queued"
+        coverage[source] = status
+    return coverage
+
+
+def record(db, item, reason, result):
+    previous = db.execute("SELECT kind,body FROM bidder_events WHERE rule=? ORDER BY id DESC LIMIT 1", (item["id"],)).fetchone()
+    body = catalog.encoded(result)
+    if previous == (reason, body):
+        return
+    state.event(db, item["id"], item["revision"], reason, result)
+    if item["config"].get("telegram"):
+        db.execute("INSERT INTO bidder_delivery(event,state) VALUES(last_insert_rowid(),'ready')")
+
+
+class Scheduler:
+    def __init__(self, app):
+        from .performance import Performance
+        self.app = app
+        self.pending = None
+        self.performance = Performance(app)
+        self.task = asyncio.create_task(self.run())
+
+    async def close(self):
+        self.task.cancel()
+        await asyncio.gather(self.task, return_exceptions=True)
+
+    def due(self, now):
+        with self.app.identity._write() as db:
+            due = db.execute("""SELECT w.owner_id,r.workspace,r.chat,r.id FROM bidder_rules r JOIN workspaces w
+                ON w.workspace_id=r.workspace WHERE r.state='active' AND r.next_at<=?
+                ORDER BY r.next_at,r.rowid LIMIT 1""", (now,)).fetchone()
+            if not due:
+                return False
+            scope = Scope(*due[:3])
+            ident = due[3]
+            item = state.rule(db, scope, ident)
+            cfg = item["config"]
+            check_at = state.next_time(cfg, now)
+            if check_at > now:
+                db.execute("UPDATE bidder_rules SET next_at=? WHERE id=?", (check_at, ident))
+                return True
+            try:
+                sid, generation = catalog.binding(db, scope, item["cid"], ads=cfg["mode"] == "auto")
+                if (sid, generation) != (item["store"],item["key_version"]):
+                    raise HTTPException(403, "Подключение изменилось.")
+                coverage = refresh(db, item, now)
+                self.pending = scope, item, coverage
+                db.execute("UPDATE bidder_rules SET next_at=? WHERE id=?", (state.next_time(cfg,now+60*cfg["interval"]),ident))
+            except HTTPException as error:
+                state.pause(db, scope, ident, item["revision"])
+                record(db, item, "accessChanged", {"message":str(error.detail)})
+        self.app.market_collector.wake.set()
+        return True
+
+    async def evaluate(self, scope, item, coverage):
+        from .performance import Deferred
+        now = int(time.time())
+        result = {"sources":coverage,"advertisingChanged":False,"count":len(item["skus"])}
+        reason = "observation"
+        try:
+            inv = await self.performance.inventory(scope,item["cid"])
+            await observations.collect(self.performance,scope,item,inv,now)
+            with self.app.identity._lock:
+                result.update(observations.snapshot(self.app.identity._db,scope,item,inv,now))
+            result.update(await observations.order_totals(self.performance,scope,item,result["from"],result["to"]))
+            with self.app.identity._lock:
+                decision = observations.assess(self.app.identity._db,scope,item,result,inv,now)
+            result.update(decision)
+        except (Deferred, HTTPException, KeyError, TypeError, ValueError) as error:
+            reason = "waiting"
+            result["message"] = error.detail if isinstance(error,HTTPException) else str(error) if isinstance(error,Deferred) and str(error) else "Ожидаю подтверждённую статистику магазина и рекламы."
+        with self.app.identity._write() as db:
+            current = state.rule(db,scope,item["id"])
+            if current["state"]=="active" and current["revision"]==item["revision"]:
+                record(db,item,reason,result)
+
+    async def deliver(self):
+        with self.app.identity._write() as db:
+            row = db.execute("""SELECT d.event,r.workspace,r.config,e.body FROM bidder_delivery d
+                JOIN bidder_events e ON e.id=d.event JOIN bidder_rules r ON r.id=e.rule
+                JOIN chat_plugins p ON p.workspace_id=r.workspace AND p.chat_id=r.chat AND p.plugin_id=?
+                WHERE d.state='ready' AND d.due<=unixepoch() AND e.revision=r.revision
+                AND r.state='active' ORDER BY d.event LIMIT 1""", (catalog.PLUGIN,)).fetchone()
+            if not row:
+                return
+            ident, workspace, cfg, body = row
+            # Persist unknown before network I/O. A crash after Telegram accepts a message must not resend it.
+            db.execute("UPDATE bidder_delivery SET state='unknown' WHERE event=?", (ident,))
+        try:
+            await self.app.telegram.send(workspace, json.loads(cfg)["name"] + " · " + json.loads(body)["message"])
+        except Exception as error:
+            status = getattr(error, "status", "unknown")
+            state_name = "disconnected" if status in ("blocked", "disconnected") else "unknown"
+        else:
+            state_name = "sent"
+        with self.app.identity._write() as db:
+            db.execute("UPDATE bidder_delivery SET state=? WHERE event=?", (state_name, ident))
+
+    async def run(self):
+        while True:
+            try:
+                busy = self.due(int(time.time()))
+                if self.pending:
+                    work = self.pending
+                    self.pending = None
+                    await self.evaluate(*work)
+                await self.deliver()
+            except Exception as error:
+                logging.getLogger(__name__).warning("Bidder scheduler deferred: %s", type(error).__name__)
+                busy = False
+            await asyncio.sleep(0.1 if busy else 10)
diff --git a/products/harness-platform/platform_core/user_plugins/bidder/state.py b/products/harness-platform/platform_core/user_plugins/bidder/state.py
new file mode 100644
index 0000000..95fef74
--- /dev/null
+++ b/products/harness-platform/platform_core/user_plugins/bidder/state.py
@@ -0,0 +1,206 @@
+"""Transactional strategy drafts, confirmations, ownership and decision history."""
+from datetime import datetime, time as wall_time, timedelta
+import json
+import sqlite3
+import time
+from uuid import uuid4
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+from starlette.exceptions import HTTPException
+
+from . import catalog
+from .catalog import encoded, fingerprint
+from .economy import GOALS, number
+
+SCHEMA = (
+    """CREATE TABLE IF NOT EXISTS bidder_rules(
+        id TEXT PRIMARY KEY,workspace TEXT NOT NULL,chat TEXT NOT NULL,cid TEXT NOT NULL REFERENCES account_integrations(id) ON DELETE CASCADE,
+        store TEXT NOT NULL REFERENCES market_data_stores(id) ON DELETE CASCADE,key_version INTEGER NOT NULL,revision INTEGER NOT NULL,
+        state TEXT NOT NULL,config TEXT NOT NULL,skus TEXT NOT NULL,plan TEXT NOT NULL,receipt TEXT NOT NULL,next_at INTEGER,
+        FOREIGN KEY(workspace,chat) REFERENCES chats(workspace_id,chat_id) ON DELETE CASCADE)""",
+    "CREATE INDEX IF NOT EXISTS bidder_due ON bidder_rules(next_at) WHERE state='active'",
+    """CREATE TABLE IF NOT EXISTS bidder_ownership(store TEXT NOT NULL,kind TEXT NOT NULL,resource TEXT NOT NULL,
+        rule TEXT NOT NULL REFERENCES bidder_rules(id) ON DELETE CASCADE,revision INTEGER NOT NULL,
+        PRIMARY KEY(store,kind,resource))""",
+    """CREATE TABLE IF NOT EXISTS bidder_events(id INTEGER PRIMARY KEY,rule TEXT NOT NULL REFERENCES bidder_rules(id) ON DELETE CASCADE,
+        at INTEGER NOT NULL,revision INTEGER NOT NULL,kind TEXT NOT NULL,body TEXT NOT NULL)""",
+    "CREATE INDEX IF NOT EXISTS bidder_journal ON bidder_events(rule,id)",
+    """CREATE TRIGGER IF NOT EXISTS bidder_disable AFTER DELETE ON chat_plugins
+        WHEN OLD.plugin_id IN ('ozon-bidder','ozon') BEGIN
+        UPDATE bidder_rules SET state='paused',revision=revision+1,next_at=NULL WHERE workspace=OLD.workspace_id AND chat=OLD.chat_id;
+        DELETE FROM bidder_ownership WHERE rule IN (SELECT id FROM bidder_rules WHERE workspace=OLD.workspace_id AND chat=OLD.chat_id);
+        END""",
+    """CREATE TRIGGER IF NOT EXISTS bidder_detach AFTER DELETE ON chat_integrations BEGIN
+        UPDATE bidder_rules SET state='paused',revision=revision+1,next_at=NULL WHERE chat=OLD.chat_id AND cid=OLD.connection_id;
+        DELETE FROM bidder_ownership WHERE rule IN (SELECT id FROM bidder_rules WHERE chat=OLD.chat_id AND cid=OLD.connection_id);
+        END""",
+    """CREATE TRIGGER IF NOT EXISTS bidder_rotate AFTER UPDATE OF version,status ON account_integrations
+        WHEN OLD.version<>NEW.version OR NEW.status<>'verified' BEGIN
+        UPDATE bidder_rules SET state='paused',revision=revision+1,next_at=NULL WHERE cid=NEW.id;
+        DELETE FROM bidder_ownership WHERE rule IN (SELECT id FROM bidder_rules WHERE cid=NEW.id);
+        END""",
+)
+
+
+def install(db):
+    for statement in SCHEMA:
+        db.execute(statement)
+
+
+def config(raw):
+    keys = {"name", "strategy", "target", "budget", "reserve", "growth", "step", "band", "mode", "interval",
+            "timezone", "days", "start", "end", "telegram", "objective", "parameterMax", "campaigns",
+            "minStock", "experiment", "windowDays", "changeHours", "minMargin"}
+    if not isinstance(raw, dict) or raw.keys() - keys:
+        raise ValueError("Неизвестные настройки стратегии.")
+    out = dict(raw)
+    if not isinstance(out.get("name"), str) or not 1 <= len(out["name"].strip()) <= 150:
+        raise ValueError("Укажите название до 150 символов.")
+    if out.get("strategy") not in GOALS or out.get("mode") not in ("observe", "auto"):
+        raise ValueError("Выберите цель и режим работы.")
+    for key, low, high in (("budget", "0.01", None), ("reserve", 0, None), ("step", "0.01", 100),
+                           ("band", 0, 100), ("minMargin", 0, 100), ("parameterMax", "0.01", None)):
+        if key not in out and key != "budget":
+            continue
+        out[key] = str(number(out.get(key), minimum=number(low), maximum=high))
+    if number(out.get("reserve", 0)) > number(out["budget"]):
+        raise ValueError("Резерв превышает недельный бюджет.")
+    if out["strategy"] in ("N1", "N2", "N3"):
+        out["target"] = str(number(out.get("target"), maximum=None if out["strategy"] == "N3" else 100))
+    if out["strategy"] == "N6" and out.get("objective") not in ("sales", "profit"):
+        raise ValueError("Выберите цель распределения бюджета.")
+    for key in ("growth", "telegram", "experiment"):
+        if type(out.get(key, False)) is not bool:
+            raise ValueError("Проверьте переключатели.")
+    for key, low, high in (("interval", 5, 1440), ("windowDays", 1, 365), ("changeHours", 1, 8760), ("minStock", 0, 10**9)):
+        if key in out or key == "interval":
+            if type(out.get(key)) is not int or not low <= out[key] <= high:
+                raise ValueError("Проверьте частоту, период и ограничения.")
+    days = out.get("days")
+    if not isinstance(days, list) or not days or any(type(d) is not int or not 0 <= d <= 6 for d in days):
+        raise ValueError("Выберите дни недели.")
+    try:
+        if not isinstance(out.get("timezone"), str):
+            raise ValueError
+        ZoneInfo(out["timezone"])
+        a, b = (wall_time.fromisoformat(out[k]) for k in ("start", "end"))
+        if a.tzinfo or b.tzinfo or a >= b:
+            raise ValueError
+    except (ZoneInfoNotFoundError, ValueError, TypeError, KeyError):
+        raise ValueError("Проверьте время начала, окончания и часовой пояс.") from None
+    ids = out.get("campaigns", [])
+    if not isinstance(ids, list) or any(not isinstance(i, str) or not i.isascii() or not i.isdigit() for i in ids):
+        raise ValueError("Некорректный список кампаний.")
+    out["campaigns"] = sorted(set(ids))
+    return out
+
+
+def next_time(settings, now):
+    tz = ZoneInfo(settings["timezone"])
+    at = datetime.fromtimestamp(now, tz)
+    for delta in range(8):
+        day = at.date() + timedelta(days=delta)
+        if day.weekday() not in settings["days"]:
+            continue
+        start = datetime.combine(day, wall_time.fromisoformat(settings["start"]), tz)
+        end = datetime.combine(day, wall_time.fromisoformat(settings["end"]), tz)
+        candidate = max(start.timestamp(), now)
+        if candidate < end.timestamp():
+            return int(candidate)
+    raise ValueError("Проверьте расписание.")
+
+
+def rule(db, scope, ident):
+    catalog.require_plugin(db, scope)
+    cur = db.execute("SELECT * FROM bidder_rules WHERE workspace=? AND chat=? AND id=?",
+                     (scope.workspace_id, scope.chat_id, ident))
+    row = cur.fetchone()
+    if row is None:
+        raise HTTPException(404, "Стратегия не найдена.")
+    result = dict(zip((c[0] for c in cur.description), row))
+    for field in ("config", "skus", "plan"):
+        result[field] = json.loads(result[field])
+    return result
+
+
+def event(db, ident, revision, kind, body):
+    db.execute("INSERT INTO bidder_events(rule,at,revision,kind,body) VALUES(?,unixepoch(),?,?,?)",
+               (ident, revision, kind, encoded(body)))
+
+
+def preview(db, scope, cid, revision, selection, settings, *, previous=None, expected=None, inventory=None):
+    settings = config(settings)
+    sid, version = catalog.binding(db, scope, cid, ads=settings["mode"] == "auto")
+    current = catalog.load(db, scope, cid)
+    if current.revision != revision:
+        raise HTTPException(409, "Каталог обновился. Проверьте состав товаров.")
+    if time.time() - current.observed > 86400:
+        raise HTTPException(409, "Каталог старше суток. Обновите товары.")
+    skus = current.resolve(selection)
+    from .campaigns import campaign_plan
+    ads = campaign_plan(inventory, skus, settings)
+    plan = dict(catalogRevision=revision, count=len(skus), ads=ads, observed=current.observed)
+    ident = previous or uuid4().hex
+    if previous:
+        old = rule(db, scope, previous)
+        if old["revision"] != expected:
+            raise HTTPException(409, "Стратегию уже изменили. Откройте актуальную версию.")
+        if old["state"] == "active":
+            raise HTTPException(409, "Приостановите управление перед изменением стратегии.")
+        if old["cid"] != cid:
+            raise ValueError("Для другого магазина создайте отдельную стратегию.")
+    rev = expected + 1 if previous else 1
+    receipt = fingerprint([ident, rev, sid, version, skus, settings, plan])
+    db.execute("""INSERT INTO bidder_rules VALUES(?,?,?,?,?,?,?,'draft',?,?,?,?,NULL)
+        ON CONFLICT(id) DO UPDATE SET key_version=excluded.key_version,revision=excluded.revision,state='draft',
+        config=excluded.config,skus=excluded.skus,plan=excluded.plan,receipt=excluded.receipt,next_at=NULL""",
+        (ident, scope.workspace_id, scope.chat_id, cid, sid, version, rev, encoded(settings), encoded(skus), encoded(plan), receipt))
+    event(db, ident, rev, "preview", {"count":len(skus), "mode":settings["mode"]})
+    return rule(db, scope, ident)
+
+
+def confirm(db, scope, ident, revision, receipt, *, inventory=None):
+    item = rule(db, scope, ident)
+    if item["revision"] != revision or item["receipt"] != receipt:
+        raise HTTPException(409, "План изменился. Проверьте новую версию.")
+    if item["state"] == "active":
+        return item
+    if item["state"] != "draft":
+        raise HTTPException(409, "Для возобновления проверьте товары и подтвердите свежий план.")
+    settings = item["config"]
+    sid, version = catalog.binding(db, scope, item["cid"], ads=settings["mode"] == "auto")
+    current = catalog.load(db, scope, item["cid"])
+    if (sid != item["store"] or version != item["key_version"] or current.revision != item["plan"]["catalogRevision"]
+            or time.time() - current.observed > 86400):
+        raise HTTPException(409, "Магазин или каталог изменился. Проверьте план ещё раз.")
+    if settings["mode"] == "auto":
+        from .campaigns import campaign_plan
+        ads = campaign_plan(inventory, item["skus"], settings)
+        if ads != item["plan"]["ads"] or not ads["ready"]:
+            raise HTTPException(409, ads["reason"] or "Настройки рекламы изменились.")
+        resources = [("sku", k) for k in item["skus"]] + [("campaign", k) for k in ads["campaigns"]]
+        if any(db.execute("SELECT 1 FROM bidder_inflight WHERE (store,kind,resource)=(?,?,?)",(sid,kind,key)).fetchone()
+               for kind,key in resources):
+            raise HTTPException(409, "Ожидается проверка предыдущей записи в Ozon.")
+        try:
+            db.executemany("INSERT INTO bidder_ownership VALUES(?,?,?,?,?)",
+                           [(sid, kind, key, ident, revision) for kind, key in resources])
+        except sqlite3.IntegrityError:
+            raise HTTPException(409, "Другой биддер уже управляет товаром или кампанией.") from None
+    due = next_time(settings, int(time.time()))
+    db.execute("UPDATE bidder_rules SET state='active',next_at=? WHERE id=?", (due, ident))
+    event(db, ident, revision, "confirmed", {"receipt":receipt, "count":len(item["skus"])})
+    return rule(db, scope, ident)
+
+
+def pause(db, scope, ident, revision, stop=False):
+    item = rule(db, scope, ident)
+    status = "stopped" if stop else "paused"
+    if item["state"] == status:
+        return item
+    if item["revision"] != revision:
+        raise HTTPException(409, "Стратегию уже изменили.")
+    db.execute("UPDATE bidder_rules SET state=?,revision=revision+1,next_at=NULL WHERE id=?", (status, ident))
+    db.execute("DELETE FROM bidder_ownership WHERE rule=?", (ident,))
+    event(db, ident, revision + 1, status, {"advertisingChanged":False})
+    return rule(db, scope, ident)
