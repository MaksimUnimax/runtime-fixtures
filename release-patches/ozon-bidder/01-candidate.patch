+"""Plan advertising only from a complete, current inventory."""
+from decimal import Decimal
+import time
+
+from .catalog import fingerprint
+from .economy import number
+
+MANUAL = "PRODUCT_CAMPAIGN_SKU_ADD_MODE_MANUAL"
+ACTIVE = "CAMPAIGN_STATE_RUNNING"
+INACTIVE = "CAMPAIGN_STATE_INACTIVE"
+
+
+def campaign_plan(inventory, skus, settings):
+    result = {"ready":False, "reason":"Ожидаю проверенные настройки и состав рекламы.", "campaigns":[], "actions":[]}
+    if not inventory or inventory.get("complete") is not True or not 0 <= time.time()-inventory["at"] <= 900:
+        return result
+    selected = set(skus)
+    relevant = {}
+    for row in inventory["campaigns"]:
+        members = set(row["products"])
+        if selected & members:
+            relevant[row["id"]] = row
+    explicit = set(settings.get("campaigns", ()))
+    if explicit - relevant.keys():
+        result["reason"] = "В выбранных кампаниях изменился состав товаров."
+        return result
+    outside = sorted(relevant.keys() - explicit) if explicit else []
+    if any(inventory.get("cpo", {}).get(sku) is True for sku in selected) and inventory.get("cpoCoverageVerified") is not True:
+        result["reason"] = "Нужно сверить расходы на рекламу с оплатой за заказ и сумму резерва."
+        return result
+    if inventory.get("unclassifiedSpend"):
+        result["reason"] = "Нужно сверить расходы рекламных размещений без разбивки по выбранным товарам."
+        return result
+    if outside:
+        result["externalCampaigns"] = outside
+        if inventory.get("externalCoverageVerified") is not True or inventory.get("outsideObligations") is None:
+            result["reason"] = "Нужно сверить расходы другой рекламы этих товаров. Её настройки сохранятся."
+            return result
+    covered, authorized = set(), []
+    for key, row in relevant.items():
+        if explicit and key not in explicit:
+            continue
+        members = set(row["products"])
+        if row["payment"] != "CPC" or row["strategy"] not in ("TARGET_BIDS", "TARGET_CIR"):
+            result["actions"].append({"campaign":key, "action":"reviewType"})
+            continue
+        if row["addMode"] != MANUAL or members - selected:
+            result["reason"] = "Кампания может добавить товары или изменить рекламу товаров вне выбранного списка."
+            return result
+        if covered & members:
+            result["reason"] = "Товар продвигается сразу в нескольких кампаниях. Выберите, какой управлять."
+            return result
+        if row["state"] not in (ACTIVE, INACTIVE) or row.get("weeklyRub") is None or number(row["weeklyRub"]) <= 0:
+            result["reason"] = "Проверьте состояние и конечный бюджет кампании."
+            return result
+        action = "reuse" if row["state"] == ACTIVE else "activate"
+        result["actions"].append({"campaign":key,"action":action,"baseline":fingerprint(row)})
+        authorized.append(key)
+        covered.update(members)
+    if selected - covered:
+        result["actions"].append({"action":"createOrTransfer","count":len(selected-covered)})
+        result["reason"] = "Для части товаров требуется согласовать создание рекламы или перенос."
+        return result
+    if any(a["action"] != "reuse" for a in result["actions"]):
+        result["reason"] = "Проверьте план изменения кампаний перед запуском."
+        return result
+    if settings["strategy"] == "N6" and len(authorized) < 2:
+        result["reason"] = "Для распределения бюджета выберите две независимые кампании."
+        return result
+    weekly = sum(number(relevant[c]["weeklyRub"]) for c in authorized)
+    if weekly + number(settings.get("reserve", 0)) + number(inventory.get("outsideObligations", 0) if outside or inventory.get("cpoCoverageVerified") else 0) > number(settings["budget"]):
+        result["reason"] = "Действующие лимиты и резерв превышают согласованный бюджет."
+        return result
+    result.update(ready=True, reason="", campaigns=sorted(authorized))
+    return result
+
+
+def change_payload(operation, before, value, sku=None):
+    """Only fields with a verifiable round trip may be submitted."""
+    money = number(value, minimum=Decimal("0.01"))
+    if before.get("addMode") != MANUAL:
+        raise ValueError("Не подтверждён фиксированный состав кампании.")
+    if operation == "weeklyBudget":
+        return "PATCH", "", {"weeklyBudget":micros(money)}
+    if sku not in before["products"]:
+        raise ValueError("Товар не входит в кампанию.")
+    current = before["products"][sku]
+    if not (current.get("keywordsVerified") is True and current.get("emptyKeywords") is True):
+        raise ValueError("Сохранность поисковых фраз и стоп-слов не подтверждена.")
+    if operation == "bid" and before["strategy"] == "TARGET_BIDS":
+        parameter = {"bid":micros(money)}
+    elif operation == "targetCir" and before["strategy"] == "TARGET_CIR" and 10 <= money <= 100 and money == int(money):
+        parameter = {"targetCir":int(money)}
+    else:
+        raise ValueError("Параметр несовместим с этой рекламой.")
+    return "PUT", "/products", {"bids":[{"sku":sku, **parameter}]}
+
+
+def micros(value):
+    result = value * 1_000_000
+    if result != int(result) or not 0 < result < 2**64:
+        raise ValueError("Проверьте размерность денежного параметра.")
+    return str(int(result))
diff --git a/products/harness-platform/platform_core/user_plugins/bidder/catalog.py b/products/harness-platform/platform_core/user_plugins/bidder/catalog.py
