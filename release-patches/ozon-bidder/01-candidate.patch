+"""Versioned plugin help, read on demand by an already-scoped help or setup action."""
+from dataclasses import asdict, dataclass
+
+
+@dataclass(frozen=True)
+class Guide:
+    plugin: str
+    id: str
+    version: int
+    purpose: str
+    text: str
+    aliases: tuple[str, ...] = ()
+    fields: tuple[str, ...] = ()
+
+
+class Guides:
+    def __init__(self, entries):
+        self.by_id = {(e.plugin, e.id): e for e in entries}
+        if len(self.by_id) != len(entries):
+            raise ValueError("Duplicate guide identifiers")
+
+    def lookup(self, plugin, query):
+        query = query.strip().casefold()
+        exact = self.by_id.get((plugin, query))
+        if exact is None:
+            candidates = ((sum(alias in query for alias in e.aliases),e.id,e) for e in self.by_id.values() if e.plugin == plugin)
+            score, _, exact = max(candidates, default=(0,"",None))
+            if not score:
+                exact = self.by_id.get((plugin,"overview"))
+        if exact is None:
+            return None
+        return {"plugin":plugin,"guide":exact.id,"version":exact.version,"purpose":exact.purpose,
+                "text":exact.text,"fields":list(exact.fields)}
