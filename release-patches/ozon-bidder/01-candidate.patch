@@ -0,0 +1,166 @@
+"""Calculate limits in rubles on comparable, closed observation windows."""
+from dataclasses import dataclass
+from decimal import Decimal, InvalidOperation, ROUND_DOWN
+
+D = Decimal
+CENT = D("0.01")
+HUNDRED = D(100)
+GOALS = {
+    "N1": "Ограничить долю рекламы в заказах",
+    "N2": "Оставлять долю выручки после расходов",
+    "N3": "Оставлять сумму с выкупленного товара",
+    "N4": "Увеличить количество выкупленных товаров",
+    "N5": "Увеличить общую прибыль",
+    "N6": "Распределить бюджет между кампаниями",
+}
+
+
+class Missing(ValueError):
+    pass
+
+
+def number(value, *, minimum=0, maximum=None):
+    if type(value) not in (str, int, Decimal) or len(str(value)) > 40:
+        raise Missing("Укажите число.")
+    try:
+        value = D(str(value).replace(",", "."))
+    except InvalidOperation:
+        raise Missing("Укажите число.") from None
+    if (not value.is_finite() or abs(value.as_tuple().exponent) > 12 or value.adjusted() > 15
+            or minimum is not None and value < minimum or maximum is not None and value > maximum):
+        raise Missing("Проверьте значение и единицы измерения.")
+    return value
+
+
+@dataclass(frozen=True)
+class Decision:
+    reason: str
+    value: Decimal | None = None
+    allowance: Decimal | None = None
+
+
+def regulate(goal, target, fact, limits):
+    """Inputs are normalized by the collector, never supplied as observed facts by a client."""
+    if not all(fact.get(k) is True for k in ("fresh", "mature", "comparable", "newWindow")):
+        return Decision("WAIT_DATA")
+    try:
+        other = number(fact.get("otherAds"))
+        spend = number(fact.get("controlledAds"))
+        weekly_room = number(fact.get("availableToSpend"))
+        target = number(target, maximum=None if goal == "N3" else 100)
+        if goal == "N1":
+            revenue = number(fact.get("orderedRevenue"), minimum=CENT)
+            cap = revenue * target / HUNDRED - other
+            distance = (spend + other) * HUNDRED / revenue - target
+        elif goal in ("N2", "N3"):
+            revenue = number(fact.get("realizedRevenue"), minimum=CENT)
+            units = number(fact.get("realizedUnits"), minimum=1)
+            if units != units.to_integral_value() or fact.get("costCoverage") != "complete":
+                return Decision("WAIT_COST")
+            costs = number(fact.get("nonAdCosts"))
+            required = revenue * target / HUNDRED if goal == "N2" else units * target
+            cap = revenue - costs - other - required - number(limits.get("reserve"))
+            distance = (spend - cap) * HUNDRED / revenue
+        else:
+            raise ValueError("Неизвестная финансовая цель.")
+        if cap <= 0 or weekly_room == 0:
+            return Decision("NO_ALLOWANCE", allowance=cap)
+        cap = min(cap, weekly_room)
+        native = fact.get("mechanism")
+        if native == "TARGET_BIDS":
+            denominator = number(fact.get("forecastClicks"), minimum=1)
+            ceiling = cap / denominator
+        elif native == "TARGET_CIR" and fact.get("attributionVerified") is True:
+            ceiling = min(HUNDRED, HUNDRED * cap / number(fact.get("attributedRevenue"), minimum=CENT))
+        else:
+            return Decision("INCOMPATIBLE", allowance=cap)
+        minimum = number(fact.get("minimum"), minimum=CENT)
+        maximum = min(number(limits.get("parameterMax"), minimum=CENT), number(fact.get("maximum"), minimum=CENT), ceiling)
+        quantum = number(fact.get("increment"), minimum=CENT)
+        maximum = (maximum / quantum).to_integral_value(rounding=ROUND_DOWN) * quantum
+        if maximum < minimum:
+            return Decision("BELOW_MINIMUM", allowance=cap)
+        current = number(fact.get("current"), minimum=CENT)
+        band = number(limits.get("band"), maximum=100)
+        step = number(limits.get("step"), minimum=CENT, maximum=100) / HUNDRED
+        if distance > band or current > maximum:
+            proposed = min(maximum, max(minimum, current * (1 - step)))
+        elif distance < -band and limits.get("growth") is True and fact.get("stockRoom") is True:
+            proposed = min(maximum, current * (1 + step))
+        else:
+            return Decision("HOLD", allowance=cap)
+        proposed = (proposed / quantum).to_integral_value(rounding=ROUND_DOWN) * quantum
+        if proposed < minimum or proposed == current:
+            return Decision("HOLD", allowance=cap)
+        return Decision("DECREASE" if proposed < current else "INCREASE", proposed, cap)
+    except Missing:
+        return Decision("INCOMPLETE")
+
+
+def optimize(goal, observations, baseline, budget, stock, min_margin):
+    """Compare conservative bounds with the baseline from the same experiment."""
+    if goal not in ("N4", "N5"):
+        raise ValueError("Неизвестная цель оптимизации.")
+    try:
+        budget, stock, min_margin = number(budget), number(stock), number(min_margin)
+        candidates = []
+        before = None
+        for o in observations:
+            if o.get("comparable") is not True or o.get("mature") is not True or o.get("incrementality") is not True:
+                continue
+            revenue = number(o.get("realizedRevenue"), minimum=CENT)
+            ad = number(o.get("otherAds")) + number(o.get("controlledAds"))
+            units = number(o.get("realizedUnits"))
+            profit = revenue - number(o.get("nonAdCosts")) - ad
+            error = number(o.get("profitError"))
+            value, spread = (units, number(o.get("unitsError"))) if goal == "N4" else (profit, error)
+            setting = number(o.get("setting"), minimum=CENT)
+            if setting == baseline:
+                before = value + spread if before is None else max(before, value + spread)
+            if (ad <= budget and number(o.get("orderedUnits"), minimum=units) <= stock
+                    and HUNDRED * (profit - error) / revenue >= min_margin):
+                candidates.append((value - spread, -ad, setting))
+        if before is None or not candidates:
+            return Decision("WAIT_HISTORY")
+        score, _, setting = max(candidates)
+        if setting == baseline or score <= before:
+            return Decision("HOLD")
+        return Decision("CHANGE", setting)
+    except Missing:
+        return Decision("INCOMPLETE")
+
+
+def allocate(campaigns, total, reserved, outside):
+    """Multiple-choice knapsack on measured options. Prune dominated partial portfolios."""
+    pool = number(total) - number(reserved) - number(outside)
+    if not campaigns or pool <= 0:
+        return "NO_ALLOWANCE", {}
+    used_skus = set()
+    states = {D(0): (D(0), ())}
+    ids = []
+    for campaign in campaigns:
+        skus = set(campaign["skus"])
+        if not skus or skus & used_skus or campaign["id"] in ids:
+            return "CONFLICT", {}
+        used_skus.update(skus)
+        ids.append(campaign["id"])
+        minimum = max(number(campaign["minimum"]), number(campaign["spent"]) + number(campaign["pending"]))
+        maximum = number(campaign["maximum"])
+        options = [(number(limit), number(score, minimum=None)) for limit, score in campaign["options"]]
+        merged = {}
+        for cost, (value, selected) in states.items():
+            for limit, score in options:
+                new_cost = cost + limit
+                if minimum <= limit <= maximum and new_cost <= pool:
+                    previous = merged.get(new_cost)
+                    if previous is None or value + score > previous[0]:
+                        merged[new_cost] = value + score, (*selected, limit)
+        states, best = {}, None
+        for cost in sorted(merged):
+            if best is None or merged[cost][0] > best:
+                states[cost] = merged[cost]
+                best = merged[cost][0]
+        if not states:
+            return "INFEASIBLE", {}
+    _, selected = max(states.values(), key=lambda v: v[0])
+    return "PLAN", dict(zip(ids, selected, strict=True))
