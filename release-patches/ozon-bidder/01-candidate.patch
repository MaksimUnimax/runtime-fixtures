+class Financial(unittest.TestCase):
+    def setUp(self):
+        self.fact = dict(otherAds=800,controlledAds=1200,availableToSpend=9000,orderedRevenue=10000,forecastClicks=140,
+                         fresh=True,mature=True,comparable=True,newWindow=True,current=5,minimum=1,maximum=50,
+                         increment="0.01",mechanism="TARGET_BIDS",stockRoom=True)
+
+    def test_n1_example(self):
+        d=economy.regulate("N1",15,self.fact,cfg())
+        self.assertEqual((d.reason,d.value,d.allowance),("DECREASE",D("4.50"),D("700")))
+
+    def test_n1_deadband(self):
+        self.assertEqual(economy.regulate("N1",15,self.fact|{"controlledAds":700},cfg()).reason,"HOLD")
+
+    def test_n1_no_unknown_or_stale(self):
+        for change in ({"fresh":False},{"orderedRevenue":0},{"otherAds":None},{"otherAds":1500},{"minimum":8}):
+            self.assertIsNone(economy.regulate("N1",15,self.fact|change,cfg()).value)
+
+    def test_finance_bases(self):
+        fact=self.fact|dict(otherAds=100,realizedRevenue=1000,realizedUnits=1,costCoverage="complete",nonAdCosts=600,forecastClicks=25)
+        for goal,target,revenue,cap in [("N2",15,1000,150),("N2",15,900,65),("N3",200,1000,100)]:
+            with self.subTest(goal=goal,revenue=revenue):
+                self.assertEqual(economy.regulate(goal,target,fact|{"realizedRevenue":revenue},cfg()).allowance,D(cap))
+
+    def test_incomplete_finances(self):
+        self.assertIsNone(economy.regulate("N3",200,self.fact,cfg()).value)
+
+    def test_cir_uses_attributed_base(self):
+        f=self.fact|dict(otherAds=100,realizedRevenue=1000,realizedUnits=1,costCoverage="complete",nonAdCosts=600,
+                         mechanism="TARGET_CIR",attributionVerified=True,attributedRevenue=1250,current=16,minimum=10,maximum=100,increment=1)
+        self.assertEqual(economy.regulate("N2",15,f,cfg()|{"parameterMax":100}).value,D("12"))
+
+    def test_optimization(self):
+        rows=[]
+        for bid,units,ad in [(4,30,5000),(7,50,9200),(12,60,15000),(20,60,18000)]:
+            rows.append(dict(setting=bid,realizedUnits=units,orderedUnits=units,otherAds=0,controlledAds=ad,realizedRevenue=units*1000,
+                             nonAdCosts=units*600,profitError=0,unitsError=0,mature=True,comparable=True,incrementality=True))
+        self.assertEqual(economy.optimize("N4",rows,D(4),15000,100,10).value,D(12))
+        self.assertEqual(economy.optimize("N5",rows,D(4),15000,100,10).value,D(7))
+        self.assertIsNone(economy.optimize("N4",rows,D(12),15000,100,10).value)
+        self.assertIsNone(economy.optimize("N5",[],D(4),15000,100,10).value)
+
+    def test_allocation(self):
+        a=dict(id="a",skus=["1"],minimum=3000,maximum=6000,spent=3000,pending=300,options=[(4000,100),(5000,130)])
+        b=a|dict(id="b",skus=["2"],options=[(4000,50),(5000,95)])
+        self.assertEqual(economy.allocate([a,b],12000,2000,1000),("PLAN",{"a":D(4000),"b":D(5000)}))
+        self.assertEqual(economy.allocate([a,b|{"skus":["1"]}],12000,0,0)[0],"CONFLICT")
+        self.assertEqual(economy.allocate([a,b],5000,0,0)[0],"INFEASIBLE")
+
+
+class ProductChoice(unittest.TestCase):
+    def test_combination_and_search(self):
+        cards=[dict(id=str(i),skus=[str(i)],archived=False,offer="ring-"+str(i),title="Кольцо",category=str(i%2),categoryName="Категория") for i in range(5000)]
+        c=catalog.Catalog(cards,1)
+        self.assertEqual(len(c.page("кольц",4900)["items"]),100)
+        choice=c.resolve({"categories":["0"],"include":["1","2"],"exclude":["4"]})
+        self.assertEqual(len(choice),2500)
+        self.assertEqual(len(c.resolve({"search":["КОЛЬЦО"],"exclude":["4"]})),4999)
+        self.assertEqual(len(c.page("ring-4900")["items"]),1)
+        self.assertNotIn("5000",choice)
+
+    def test_unknown_archive_is_not_eligible(self):
+        cards=[dict(id="p",skus=["10","20"],archived=False,offer="test",title="Тест"),dict(id="q",skus=["30"],archived=None),
+               dict(id="r",skus=[],archived=False),dict(id="s",skus=["40"],archived=True)]
+        c=catalog.Catalog(cards,1)
+        self.assertEqual(c.resolve({"all":True}),["10","20"])
+        self.assertEqual(sum(c.unavailable.values()),3)
+
+    def test_incompatible_or_expanding_campaign(self):
+        for key,value in (("addMode","AUTO"),("state","unknown"),("weeklyRub",None)):
+            inv=inventory("7");inv["campaigns"][0][key]=value
+            self.assertFalse(campaigns.campaign_plan(inv,["123"],cfg())["ready"])
+
+    def test_external_budget_is_not_hidden(self):
