+"""Store comparable Ozon observations with credential generation and Moscow business date."""
+from datetime import datetime, timedelta
+from decimal import Decimal
+import json
+import time
+from zoneinfo import ZoneInfo
+
+from ... import market_data, market_query
+from . import catalog, economy
+
+SCHEMA = (
+    """CREATE TABLE IF NOT EXISTS bidder_samples(store TEXT,cid TEXT,generation INTEGER,day TEXT,campaign TEXT,
+        sku TEXT,observed INTEGER,setting TEXT,clicks INTEGER,expense TEXT,views INTEGER,receipt TEXT,
+        PRIMARY KEY(store,cid,generation,day,campaign,sku))""",
+    """CREATE TABLE IF NOT EXISTS bidder_proposals(rule TEXT,revision INTEGER,window TEXT,campaign TEXT,sku TEXT,
+        field TEXT,value TEXT,proof TEXT,observed INTEGER,PRIMARY KEY(rule,revision,window,campaign,sku,field))""",
+)
+
+
+def stats_rows(raw, campaigns, day):
+    rows = raw.get("rows")
+    if not isinstance(rows,list) or raw.get("total", len(rows)) != len(rows):
+        raise ValueError("Ozon не подтвердил полный состав строк рекламной статистики.")
+    total = {}
+    for row in rows:
+        if not isinstance(row,dict):
+            raise ValueError("Неполная строка рекламы.")
+        if row.get("date") != str(day):
+            raise ValueError("Статистика пришла за другой день.")
+        cid = str(row.get("campaignId",""))
+        if not cid and len(campaigns) == 1:
+            cid = next(iter(campaigns))
+        sku = str(row.get("sku",""))
+        if cid not in campaigns or sku not in campaigns[cid]["products"]:
+            raise ValueError("У строки статистики нет подтверждённой связи с кампанией и товаром.")
+        if (cid,sku) in total:
+            raise ValueError("У Ozon несколько строк на товар и кампанию, нужна сверка.")
+        spend = row.get("expense")
+        if isinstance(spend,float):
+            spend = str(spend)
+        expense = economy.number(spend)
+        clicks, views = [economy.number(row.get(k)) for k in ("clicks","views")]
+        if clicks != int(clicks) or views != int(views):
+            raise ValueError("Показатели активности пришли в неизвестных единицах.")
+        total[cid,sku] = int(clicks),str(expense),int(views)
+    return total
+
+
+async def collect(performance, scope, item, inventory, now):
+    from .performance import Deferred
+    pin = item["store"],item["key_version"]
+    cid = item["cid"]
+    today = datetime.fromtimestamp(now, ZoneInfo("Europe/Moscow")).date()
+    selected = set(item["skus"])
+    campaigns = {c["id"]:c for c in inventory["campaigns"] if selected.intersection(c["products"])}
+    keys = sorted(campaigns)
+    for day in (today, today-timedelta(days=1)):
+        ttl = 900 if day==today else 21600
+        for offset in range(0,len(keys),10):
+            batch = keys[offset:offset+10]
+            query = catalog.fingerprint([batch, str(day)])
+            payload = await performance.read(scope,cid,pin,"sku-stats",query,"/api/client/statistics/products/sku",
+                    body={"campaignIds":batch,"dateFrom":str(day),"dateTo":str(day)},ttl=ttl)
+            rows = stats_rows(payload,{k:campaigns[k] for k in batch},day)
+            with performance.app.identity._write() as db:
+                performance.check(db,scope,cid,pin)
+                proof = db.execute("""SELECT observed FROM bidder_reads WHERE store=? AND profile='performance'
+                    AND source='sku-stats' AND query=? AND scope=? AND error IS NULL""",
+                    (pin[0],query,catalog.fingerprint([cid,pin[1]]))).fetchone()
+                if not proof or not 0 <= now-proof[0] <= ttl:
+                    raise Deferred("Статистика требует обновления.")
+                for (campaign,sku),(clicks,expense,views) in rows.items():
+                    product = campaigns[campaign]["products"][sku]
+                    # A current bid cannot describe a previous day's effective bid.
+                    setting = catalog.encoded(product) if day==today else None
+                    db.execute("""INSERT INTO bidder_samples VALUES(?,?,?,?,?,?,?,?,?,?,?,?)
+                        ON CONFLICT DO UPDATE SET observed=excluded.observed, clicks=excluded.clicks,
+                        expense=excluded.expense,views=excluded.views,receipt=excluded.receipt,
+                        setting=coalesce(excluded.setting,bidder_samples.setting)
+                        WHERE excluded.observed>=bidder_samples.observed""",
+                        (pin[0],cid,pin[1],str(day),campaign,sku,proof[0],setting,clicks,expense,views,
+                         catalog.fingerprint([query,day.isoformat(),campaign,sku,clicks,expense,views])))
+    return keys
+
+
+def snapshot(db, scope, item, inv, now):
+    cfg, sid, cid = item["config"],item["store"],item["cid"]
+    through = datetime.fromtimestamp(now,ZoneInfo("Europe/Moscow")).date()-timedelta(days=1)
+    since = through-timedelta(days=cfg.get("windowDays",7)-1)
+    keys = [c for c in inv["campaigns"] if set(item["skus"]).intersection(c["products"])]
+    owned = set(item["plan"]["ads"].get("campaigns",[]))
+    missing = set()
+    samples, clicks, spend, other = 0,0,Decimal(0),Decimal(0)
+    sku_set = set(item["skus"])
+    by_campaign = {r["id"]:r for r in keys}
+    rows = db.execute("""SELECT day,campaign,sku,clicks,expense FROM bidder_samples WHERE store=? AND cid=?
+          AND generation=? AND day BETWEEN ? AND ?""",(sid,cid,item["key_version"],str(since),str(through)))
+    for day,campaign,sku,n,amount in rows:
+        if campaign in by_campaign and sku in sku_set:
+            samples += 1
+            if campaign in owned:
+                clicks += n
+                spend += economy.number(amount)
+            else:
+                other += economy.number(amount)
+    if not keys or samples < cfg.get("windowDays",7)*sum(len(sku_set.intersection(c["products"])) for c in keys):
+        missing.add("закрытая история рекламных расходов за весь период")
+    if inv.get("unclassifiedSpend") or any(inv["cpo"].get(k) for k in sku_set):
+        missing.add("сверка расходов других размещений и оплаты за заказ")
+    costs = {}
+    path = market_query.main_path(db)
+    if market_data.path_for(path,scope.workspace_id,"ozon").is_file():
+        with market_data.local(path,scope.workspace_id,"ozon") as data:
+            for sku in item["skus"]:
+                cost = data.execute("""SELECT amount FROM costs WHERE store=? AND (sku=? OR sku='') AND since<=?
+                    ORDER BY (sku=?) DESC,since DESC LIMIT 1""",(sid,sku,str(through),sku)).fetchone()
+                if cost:
+                    costs[sku] = cost[0]
+    if cfg["strategy"] in ("N2","N3","N4","N5") and len(costs)!=len(item["skus"]):
+        missing.add("себестоимость выбранных товаров")
+    return {"from":str(since),"to":str(through),"campaigns":sorted(by_campaign),"rows":samples,
+            "controlledAds":str(spend),"externalCpc":str(other),"clicks":clicks,"coveredCosts":len(costs),
+            "missing":sorted(missing)}
+
+
+async def order_totals(performance, scope, item, first, last):
+    """Only basic Seller analytics, paginated by SKU. The same cache serves all shop rules."""
+    from .performance import Deferred
+    pin = item["store"],item["key_version"]
+    selected = set(item["skus"])
+    totals, seen, offset = {}, set(), 0
+    while True:
+        body = {"date_from":first,"date_to":last,"metrics":["ordered_units","revenue"],"dimension":["sku"],
+                "sort":[{"key":"revenue","order":"DESC"}],"limit":1000,"offset":offset}
+        page = await performance.read(scope,item["cid"],pin,"orders-by-sku",catalog.fingerprint(body),
+            "/v1/analytics/data",body=body,ttl=21600,seller=True)
+        if page is None:
+            raise Deferred("Ожидаю квоту данных о заказах.")
+        rows = page.get("result",{}).get("data")
+        if not isinstance(rows,list) or len(rows)>1000:
+            raise ValueError("Ozon не подтвердил группировку заказов по товарам.")
+        for row in rows:
+            dimensions,metrics = row.get("dimensions"),row.get("metrics")
+            if not isinstance(dimensions,list) or len(dimensions)!=1 or not isinstance(metrics,list) or len(metrics)!=2:
+                raise ValueError("Не совпала детализация заказов.")
+            sku = str(dimensions[0]["id"])
+            if not sku.isascii() or not sku.isdecimal() or sku in seen:
+                raise ValueError("Нужно сверить страницы отчёта о заказах.")
+            seen.add(sku)
+            if sku in selected:
+                units,revenue = (economy.number(str(value)) for value in metrics)
+                if units != int(units):
+                    raise ValueError("Неизвестные единицы количества заказов.")
+                totals[sku] = (int(units),revenue)
+        if len(rows)<1000:
+            break
+        offset += len(rows)
+    return {"orderedUnits":sum(v[0] for v in totals.values()),
+            "orderedRevenue":str(sum((v[1] for v in totals.values()),Decimal(0))),"productsWithOrders":len(totals)}
+
+
+def assess(db, scope, item, summary, inventory, now):
+    """Use only confirmed facts, reporting usable partial data alongside each missing source."""
+    goal = item["config"]["strategy"]
+    missing = set(summary["missing"])
+    owned = set(item["plan"]["ads"].get("campaigns",[]))
+    campaigns = [c for c in inventory["campaigns"] if c["id"] in owned]
+    result = {}
+    cfg = item["config"]
+    if goal in ("N2","N3","N4","N5") or goal=="N6" and cfg.get("objective")=="profit":
+        amounts, units = Decimal(0),Decimal(0)
+        for sku in item["skus"]:
+            ledger = market_query.economics(db,scope.workspace_id,item["cid"],item["store"],"ozon",
+                        summary["from"],summary["to"],sku=sku)
+            if ledger.get("complete") is not True or not 0<=now-ledger.get("observed",0)<=86400:
+                missing.add("сверенные расходы и выкупы по выбранным товарам")
+                break
+            amounts += economy.number(ledger["result"].get("revenueRub"))
+            units += economy.number(ledger["totalUnits"])
+        else:
+            result.update(realizedRevenue=str(amounts),realizedUnits=str(units))
+    if goal in ("N1","N2","N3"):
+        controlled = economy.number(summary["controlledAds"])
+        other = economy.number(summary["externalCpc"])
+        revenue = economy.number(summary["orderedRevenue"])
+        if not missing and goal=="N1" and revenue>0:
+            result["observedAdPercent"] = str((100*(controlled+other)/revenue).quantize(Decimal("0.01")))
+        # No data source currently certifies all weekly obligations and SKU-level bid units.
+        # Never convert missing budget headroom to the configured limit.
+        fact = dict(comparable=not missing,mature=not missing,fresh=True,newWindow=True,
+                    orderedRevenue=str(revenue),controlledAds=str(controlled),otherAds=str(other),
+                    forecastClicks=summary["clicks"],**{k:v for k,v in result.items() if k.startswith("realized")})
+        decision = economy.regulate(goal,cfg["target"],fact,cfg)
+        missing.add("доступный остаток недельного бюджета с учётом всех списаний")
+        if campaigns:
+            missing.add("подтверждённые параметры и допустимые ставки для выбранных товаров")
+        result["decision"] = decision.reason
+    elif goal in ("N4","N5"):
+        # A setting snapshot is not a measured campaign experiment with a control interval.
+        result["decision"] = economy.optimize(goal,[],Decimal(0),cfg["budget"],0,cfg.get("minMargin",0)).reason
+        missing.add("сопоставимые завершённые периоды до и после изменения рекламы")
+    else:
+        result["decision"] = "WAIT_HISTORY"
+        if len(campaigns)<2:
+            missing.add("две независимые кампании с разными товарами")
+        missing.add("проверенные варианты бюджета и их результат по каждой кампании")
+    result["missing"] = sorted(missing)
+    result["message"] = "Период с " + summary["from"] + " по " + summary["to"] + ". Для решения нужны " + ", ".join(result["missing"]) + "."
+    return result
