+"""Shared authenticated commands for the settings screen and Octopus."""
+from datetime import datetime
+import json
+import time
+
+from starlette.exceptions import HTTPException
+from starlette.responses import JSONResponse
+from starlette.routing import Route
+
+from ...chat_connections import scope_for
+from . import catalog, state
+from .economy import GOALS
+
+BASE = "/api/chats/{chat_id}/plugins/ozon-bidder"
+
+
+def command(db, scope, op, args):
+    catalog.require_plugin(db, scope)
+    if op == "list":
+        rules = db.execute("""SELECT id,revision,state,config,json_array_length(skus),next_at FROM bidder_rules
+            WHERE workspace=? AND chat=? ORDER BY rowid DESC""", (scope.workspace_id, scope.chat_id))
+        return {"stores":catalog.stores(db, scope), "goals":GOALS, "rules":[
+            dict(id=i, revision=r, state=s, name=json.loads(c)["name"], count=n, nextAt=t) for i,r,s,c,n,t in rules]}
+    if op == "catalog":
+        cat = catalog.load(db, scope, args["cid"])
+        offset = int(args.get("offset", 0))
+        if offset < 0:
+            raise ValueError("Проверьте страницу.")
+        return cat.page(args.get("query", ""), offset, args.get("category"))
+    if op == "preview":
+        return state.preview(db, scope, args["cid"], args["catalogRevision"], args["selection"], args["config"],
+                             previous=args.get("id"), expected=args.get("revision"),
+                             inventory=inventory(db, scope, args["cid"]))
+    if op == "stopAll":
+        items = db.execute("SELECT id,revision FROM bidder_rules WHERE workspace=? AND chat=? AND state<>'stopped'",
+                           (scope.workspace_id, scope.chat_id)).fetchall()
+        for ident, revision in items:
+            state.pause(db, scope, ident, revision, stop=True)
+        return {"stopped":len(items), "advertisingChanged":False}
+    item = state.rule(db, scope, args["id"])
+    if op in ("pause", "stop"):
+        return state.pause(db, scope, item["id"], args["revision"], op == "stop")
+    catalog.binding(db, scope, item["cid"])
+    if op == "get":
+        return item
+    if op == "confirm":
+        return state.confirm(db, scope, item["id"], args["revision"], args["receipt"],
+                             inventory=inventory(db, scope, item["cid"]))
+    if op == "check":
+        if item["state"] != "active" or item["revision"] != args["revision"]:
+            raise HTTPException(409, "Проверьте состояние и версию стратегии.")
+        db.execute("UPDATE bidder_rules SET next_at=unixepoch() WHERE id=?", (item["id"],))
+        return {"state":"queued"}
+    if op == "history":
+        rows = db.execute("""SELECT id,at,revision,kind,body FROM bidder_events WHERE rule=? ORDER BY id DESC LIMIT 100""", (item["id"],))
+        return {"events":[dict(id=k,at=t,revision=r,kind=e,result=json.loads(v)) for k,t,r,e,v in rows]}
+    raise ValueError("Неизвестная операция.")
+
+
+def inventory(db, scope, cid):
+    sid, version = catalog.binding(db, scope, cid)
+    row = db.execute("""SELECT fact FROM bidder_reads WHERE store=? AND profile='performance' AND source='inventory'
+        AND query='' AND scope=? AND error IS NULL AND observed>=unixepoch()-900""",
+        (sid, catalog.fingerprint([cid,version]))).fetchone()
+    return json.loads(row[0]) if row and row[0] else None
+
+
+def routes(get_token, body):
+    async def handle(req):
+        token = get_token(req, allow_cookie=True)
+        identity = req.app.state.identity
+        if req.method == "GET":
+            op, args = "list", {}
+        else:
+            data = await body(req, "op", "args", limit=2*1024*1024)
+            op, args = data["op"], data["args"]
+            if not isinstance(op, str) or not isinstance(args, dict):
+                raise ValueError("Проверьте параметры.")
+        if op in ("preview", "confirm"):
+            with identity._lock:
+                db = identity._db
+                scope = scope_for(db, token, req.path_params["chat_id"])
+                cid = args.get("cid") if op == "preview" else state.rule(db,scope,args.get("id"))["cid"]
+                cached = inventory(db, scope, cid)
+            if cached is None:
+                from .performance import Deferred
+                try:
+                    await req.app.state.bidder.performance.inventory(scope, cid)
+                except (Deferred, HTTPException, KeyError, ValueError):
+                    pass  # Observation remains available. Confirmation independently checks complete inventory.
+        with identity._write() if req.method == "POST" else identity._lock:
+            db = identity._db
+            scope = scope_for(db, token, req.path_params["chat_id"])
+            try:
+                result = command(db, scope, op, args)
+            except (KeyError, TypeError) as error:
+                raise HTTPException(400, "Проверьте параметры формы.") from error
+        return JSONResponse(result)
+    return [Route(BASE, handle, methods=["GET","POST"])]
