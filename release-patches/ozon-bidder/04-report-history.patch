+    def test_closed_day_report_recovers_a_lost_post_without_repeating_it(self):
+        import asyncio
+        import httpx
+        from unittest.mock import AsyncMock
+        from platform_core.user_plugins.bidder import history, performance
+        item = self.confirm(self.scope,self.preview(self.scope,"observe"))
+        now = int(time.time())
+        uid = "a644ebbb-f477-463b-b165-8a7aecefbd61"
+        request = {}
+        posts = []
+        def provider(req):
+            path = req.url.path
+            if req.method == "POST":
+                import json
+                request.update(json.loads(req.content))
+                posts.append(path)
+                raise httpx.ReadTimeout("response lost",request=req)
+            meta = {"UUID":uid,"state":"OK","kind":"STATS","request":request,
+                    "createdAt":datetime.fromtimestamp(now,UTC).isoformat()}
+            if path.endswith("/externallist"):
+                return httpx.Response(200,json={"items":[{"meta":meta}],"total":"1"})
+            if path.endswith("/"+uid):
+                return httpx.Response(200,json=meta)
+            self.assertEqual((path,req.url.params["UUID"]),("/api/client/statistics/report",uid))
+            return httpx.Response(200,content="SKU;Показы;Клики;Расход, Р, с НДС\n123;10;2;3,55".encode())
+        async def check():
+            async with httpx.AsyncClient(transport=httpx.MockTransport(provider)) as http:
+                app = SimpleNamespace(identity=self.server,http=http)
+                transport = performance.Performance(app)
+                transport.token = AsyncMock(return_value="fixture")
+                await history.backfill(transport,self.scope,item,inventory("7"),now)
+                with self.server._write() as db:
+                    self.assertEqual(db.execute("SELECT state,uuid FROM bidder_history_reports").fetchone(),("sending",None))
+                    db.execute("UPDATE bidder_history_reports SET next_at=0")
+                # A fresh client simulates a scheduler restart after the server accepted the first POST.
+                transport = performance.Performance(app)
+                transport.token = AsyncMock(return_value="fixture")
+                await history.backfill(transport,self.scope,item,inventory("7"),now+1)
+                with self.server._lock:
+                    db = self.server._db
+                    self.assertEqual(db.execute("SELECT state,uuid FROM bidder_history_reports").fetchone(),("done",uid))
+                    self.assertEqual(db.execute("SELECT campaign,sku,clicks,expense,views FROM bidder_samples").fetchone(),
+                                     ("7","123",2,"3.55",10))
+                    self.assertEqual(db.execute("SELECT count(*) FROM coin_attempts").fetchone(),(0,))
+        asyncio.run(check())
+        self.assertEqual(posts,["/api/client/statistics"])
+
+    def test_report_rejects_wrong_campaign_and_ambiguous_amounts(self):
+        from io import BytesIO
+        from zipfile import ZipFile
+        from platform_core.user_plugins.bidder import history
+        raw = "SKU;Показы;Клики;Расход, Р, с НДС\n123;10;2;3,55\n".encode()
+        archive = BytesIO()
+        with ZipFile(archive,"w") as z:
+            for campaign in ("7","8"):
+                z.writestr(campaign+".csv",raw)
+        self.assertEqual(len(history.parse_file(archive.getvalue(),["7","8"])),2)
+        with self.assertRaises(ValueError):
+            history.parse_file(archive.getvalue(),["7","9"])
+        with self.assertRaises(ValueError):
+            history.parse_file(raw + raw.splitlines()[1],["7"])
+        with self.assertRaises(ValueError):
+            history.parse_file(raw.replace("НДС".encode(),b"USD"),["7"])
+
