@@ -0,0 +1,63 @@
+"""One dispatch contract for mature observations, bounded settings and portfolio changes."""
+from . import catalog, economy, executor
+
+
+def calculate(item, inventory, evidence):
+    cfg = item["config"]
+    grade = evidence.get("coverage",{})
+    missing = sorted(k for k,v in grade.items() if v is not True)
+    if missing or not grade or not all(grade.get(k) is True for k in ("composition","period","otherAds","week","costs")):
+        return "WAIT_DATA",[],missing
+    approved = {c["id"]:c for c in inventory["campaigns"] if c["id"] in item["plan"]["ads"]["campaigns"]}
+    if not approved or not inventory.get("complete") or not evidence.get("window"):
+        return "WAIT_DATA",[],["composition"]
+    proposals = []
+    def proposal(campaign, field, sku, amount):
+        if campaign not in approved or sku and sku not in approved[campaign]["products"]:
+            raise ValueError("Изменился состав выбранной рекламы.")
+        proposals.append(dict(campaign=campaign,field=field,sku=sku,value=str(amount),window=evidence["window"],
+                              baseline=catalog.fingerprint(approved[campaign])))
+    goal = cfg["strategy"]
+    if goal=="N6":
+        choices = evidence.get("portfolio",[])
+        if len(choices)<2 or {c["id"] for c in choices}!=set(approved):
+            return "WAIT_HISTORY",[],["portfolio"]
+        if any(set(c["skus"])!=set(approved[c["id"]]["products"]) for c in choices):
+            return "CONFLICT",[],["composition"]
+        status,targets = economy.allocate(choices,cfg["budget"],cfg["reserve"],evidence["outsideObligations"])
+        if status!="PLAN":
+            return status,[],[]
+        for key,value in targets.items():
+            if value != executor.field_value(approved[key],"weeklyBudget",""):
+                proposal(key,"weeklyBudget","",value)
+        # On the following check, recompute the whole portfolio after one verified change.
+        proposals.sort(key=lambda p:economy.number(p["value"])-executor.field_value(approved[p["campaign"]],"weeklyBudget",""))
+    else:
+        facts = evidence.get("products",[])
+        if not facts:
+            return "WAIT_DATA",[],["products"]
+        for datum in facts:
+            cid,sku = datum["campaign"],datum["sku"]
+            if cid not in approved or sku not in approved[cid]["products"]:
+                return "CONFLICT",[],["composition"]
+            if goal in ("N1","N2","N3"):
+                result = economy.regulate(goal,cfg["target"],datum,cfg)
+            else:
+                result = economy.optimize(goal,datum.get("history",[]),economy.number(datum["current"]),
+                    datum["availableToSpend"],datum["availableStock"],cfg.get("minMargin",0))
+            if result.value is None:
+                continue
+            field = {"TARGET_BIDS":"bid","TARGET_CIR":"targetCir"}.get(approved[cid]["strategy"])
+            if not field:
+                continue
+            current = executor.field_value(approved[cid],field,sku)
+            if current!=economy.number(datum["current"]):
+                return "WAIT_DATA",[],["current"]
+            if result.value>current and not cfg.get("growth"):
+                continue
+            if result.value>economy.number(cfg.get("parameterMax")):
+                continue
+            if abs(result.value-current)>current*economy.number(cfg.get("step"))/100:
+                continue
+            proposal(cid,field,sku,result.value)
+    return ("PROPOSE" if proposals else "HOLD"),proposals,[]
