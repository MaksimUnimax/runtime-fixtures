+def run():
+ f=fbase();d={'phase':'cards','targets':['200001']};Source.sent=[];Source.polled=[]
+ with tempfile.TemporaryDirectory() as tmp:
+  path=Path(tmp)/'db';db=setup(path,f,d);db.execute('PRAGMA foreign_keys=ON')
+  with patch.object(service,'permitted'),patch.object(service,'connection',return_value=(1,None)),patch.object(service,'unseal',return_value={'token':Source.key}),patch.object(service,'Parser',Source):
+   assert service.tick(path)
