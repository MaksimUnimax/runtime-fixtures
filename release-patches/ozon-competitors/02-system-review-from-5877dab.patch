index 0000000..7899028
--- /dev/null
+++ b/products/harness-platform/platform_core/competitors/facts.py
@@ -0,0 +1,51 @@
+"""Reconcile observations for a fixed research row without losing confirmed facts."""
+from collections import defaultdict, deque
+
+
+def retained(previous, current, reason):
+    return {**previous, 'lastAttempt': {k:current.get(k) for k in ('order','code','label','region','collected')},
+            'attemptError': reason}
+
+
+def merge_result(kind, previous, current):
+    if not previous or previous.get('error'):
+        return current
+    if current.get('error'):
+        return retained(previous,current,current['error'])
+    if kind=='reviews':
+        # Match repeated identical texts by occurrence. Ratings can be enriched
+        # independently without duplicating the text or changing source order.
+        fields=('Published','Title','Comment','Pro','Contra')
+        key=lambda r:tuple(r.get(k) for k in fields)
+        indexes=defaultdict(deque)
+        out=list(previous.get('reviews',[]))
+        for i,row in enumerate(out):
+            indexes[key(row)].append(i)
+        missing=len(out)
+        for row in current.get('reviews',[]):
+            queue=indexes[key(row)]
+            if queue:
+                i=queue.popleft()
+                out[i]={**out[i],**{k:v for k,v in row.items() if v is not None}}
+                missing-=1
+            else:
+                out.append(row)
+        result={**current,'reviews':out}
+        if missing:
+            return retained(result,current,'В новом ответе отсутствуют сохранённые отзывы')
+        return result
+    if kind=='search':
+        if current.get('state')!='OK':
+            old={(v.get('sku'),v.get('index')) for v in previous.get('hits',[]) if v.get('sku')}
+            new={(v.get('sku'),v.get('index')) for v in current.get('hits',[]) if v.get('sku')}
+            if old-new:
+                return retained(previous,current,'Повторная выдача неполна')
+        return current
+    # Keep directly verified fields of the same card when rereading the same
+    # order. A separately purchased report has its own time and provenance.
+    if str(previous.get('order'))==str(current.get('order')):
+        missing={k:v for k,v in previous.items() if k not in ('attemptError','lastAttempt')
+                 and v not in (None,'',[],{}) and current.get(k) in (None,'',[],{})}
+        if missing:
+            return retained({**current,**missing},current,'В новом ответе отсутствуют сохранённые поля карточки')
+    return current
