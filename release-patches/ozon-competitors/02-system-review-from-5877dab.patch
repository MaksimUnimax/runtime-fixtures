+"""Financial, classification and source-coverage invariants across research lifecycles."""
+import json
+import sqlite3
+import tempfile
+import time
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from platform_core.competitors import analysis, own, routes, service
+from platform_core.competitors.coverage import quality
+from platform_core.competitors.jobs import Journal
+from platform_core.competitors.parser import products
+from platform_core.storage import Scope
+
+
+class Source:
+    key='offline-account'
+    def __init__(self):
+        self.orders={}
+        self.states={}
+    def authorize(self): pass
+    def balance(self): return 20,0
+    def submit(self,kind,region,label,rows):
+        oid=str(100+len(self.orders))
+        self.orders[label]=oid,rows
+        return oid
+    def poll(self,label):
+        if label in self.states:
+            return self.states[label],None
+        oid,rows=self.orders[label]
+        return 'completed',{'id':oid,'used_checks_total':len(rows),'regioncode':'москва',
+                            'data':[{**r,'offers':[{'Marketid':r['name'],'Name':'Товар'}]} for r in rows]}
+
+
+class Financial(unittest.TestCase):
+    def setUp(self):
+        tmp=tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.path=Path(tmp.name)/'db'
+        self.j=Journal(self.path)
+        self.addCleanup(self.j.close)
+        self.source=Source()
+        self.rows=products('cards',['101'])
+    def send(self):
+        self.j.step('study','cards','cards','Москва',self.rows,1,self.source)
+        self.j.db.execute('UPDATE competitor_jobs SET due=0')
+        return self.j.get('study','cards')
+    def test_late_poll_is_fenced_even_after_same_order_completes(self):
+        job=self.send()
+        other=Journal(self.path)
+        self.addCleanup(other.close)
+        ordinary=self.source.poll
+        def late(label):
+            other.db.execute('UPDATE competitor_jobs SET due=0')
+            with patch.object(self.source,'poll',side_effect=ordinary):
+                self.assertTrue(other.poll_existing(other.get('study','cards'),self.source))
+            state,report=ordinary(label)
+            report['used_checks_total']=9
+            return state,report
+        with patch.object(self.source,'poll',side_effect=late):
+            self.assertIsNone(self.j.poll_existing(job,self.source))
+        self.assertEqual(tuple(self.j.db.execute('SELECT used,state FROM competitor_jobs').fetchone()),(1,'completed'))
+    def test_scope_lost_between_balance_and_reservation(self):
+        def revoked():
+            raise PermissionError('scope revoked')
+        self.j.authorize_commit=revoked
+        with self.assertRaises(PermissionError):
+            self.send()
+        self.assertFalse(self.source.orders)
+        self.assertIsNone(self.j.get('study','cards'))
+
+    def test_late_acknowledgement_preserves_detached_order_without_material(self):
+        def delayed(kind,region,label,rows):
+            self.j.db.execute("UPDATE competitor_jobs SET state='detached-pending',rows='[]' WHERE label=?",(label,))
+            return '341'
+        with patch.object(self.source,'submit',side_effect=delayed):
+            row=self.send()
+        self.assertEqual((row['state'],row['order_id'],row['rows']),('detached-pending','341','[]'))
+
+    def test_terminal_then_receipt_settles_one_order(self):
+        job=self.send()
+        self.source.states[job['label']]='cancelled'
+        self.j.poll_existing(job,self.source)
+        self.assertEqual(self.j.get('study','cards')['state'],'awaiting-receipt')
+        self.source.states.clear()
+        self.j.db.execute('UPDATE competitor_jobs SET due=0')
+        self.j.poll_existing(self.j.get('study','cards'),self.source)
+        self.assertEqual(self.j.get('study','cards')['used'],1)
+        self.assertEqual(len(self.source.orders),1)
+    def test_deleted_research_late_account_reconciliation_has_no_material(self):
+        job=self.send()
+        self.j.db.execute("UPDATE competitor_jobs SET state='detached-pending',rows='[]',data=NULL")
+        self.j.reconcile_detached(job['account'],self.source,manual=True)
+        new=self.j.get('study','cards')
+        self.assertEqual((new['state'],new['rows'],new['data'],new['used']),('detached-settled','[]',None,1))
+        self.assertEqual(self.j.db.execute('SELECT count(*) FROM competitor_receipts').fetchone()[0],1)
+    def test_parse_crash_reopens_on_same_receipt_without_resubmit(self):
+        job=self.send()
+        with patch('platform_core.competitors.jobs.parse_batch',side_effect=RuntimeError('restart')):
+            with self.assertRaises(RuntimeError):
+                self.j.poll_existing(job,self.source)
+        self.j.db.execute('UPDATE competitor_jobs SET due=0')
+        restored=Journal(self.path)
+        self.addCleanup(restored.close)
+        self.assertEqual(restored.step('study','cards','cards','Москва',self.rows,1,self.source)['101']['sku'],'101')
+        self.assertEqual(len(self.source.orders),1)
+
