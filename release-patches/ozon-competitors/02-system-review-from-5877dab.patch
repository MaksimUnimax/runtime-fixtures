+"""Two real SQLite workers on separate tenants at each persisted result boundary."""
+import json
+import sqlite3
+import tempfile
+import threading
+from contextlib import ExitStack
+from pathlib import Path
+from unittest.mock import patch
+
+from platform_core.competitors import service,jobs
+from platform_core.admin_statistics import purge_workspace
+from platform_core.operation_grants import ensure_operation_schema
+from positive import setup,fbase,endpoint,Source
+
+
+def scenario(boundary,action):
+    with tempfile.TemporaryDirectory() as temp:
+        path=Path(temp)/'db'
+        db=setup(path,fbase(),{'phase':'cards','targets':['200001']})
+        db.execute('PRAGMA foreign_keys=ON')
+        db.execute("ALTER TABLE workspaces ADD COLUMN owner_id TEXT")
+        db.execute("UPDATE workspaces SET owner_id='actor'")
+        db.execute("ALTER TABLE chats ADD COLUMN workspace_id TEXT")
+        db.execute("UPDATE chats SET workspace_id='workspace'")
+        db.execute("ALTER TABLE account_integrations ADD COLUMN workspace TEXT")
+        ensure_operation_schema(db)
+        entered=threading.Event()
+        released=threading.Event()
+        errors=[]
+        sent={}
+        class Provider(Source):
+            def submit(self,kind,region,label,rows):
+                self.authorize()
+                assert label not in sent
+                sent[label]=(str(len(sent)+71),rows)
+                return sent[label][0]
+            def poll(self,label):
+                self.authorize()
+                order,rows=sent[label]
+                return 'completed',{'id':order,'used_checks_total':len(rows),'data':[
+                    dict(row,offers=[dict(Marketid=row['name'],Name='Товар')]) for row in rows]}
+        def pause():
+            if threading.current_thread().name=='first' and not entered.is_set():
+                entered.set()
+                assert released.wait(10)
+        mod,name,position={
+            'receipt':(jobs,'parse_batch','before'),'parse':(jobs,'parse_batch','after'),
+            'checkpoint':(service,'advance','after'),'before-wallet':(service,'record_receipts','before'),
+            'after-wallet':(service,'record_receipts','after')}[boundary]
+        original=getattr(mod,name)
+        def around(*args,**kwargs):
+            if position=='before':pause()
+            result=original(*args,**kwargs)
+            if position=='after':pause()
+            return result
+        def worker():
+            try:
+                service.tick(path)
+            except BaseException as exc:
+                errors.append(str(exc))
+        with ExitStack() as stack:
+            for k,v in [('permitted',lambda *a:None),('connection',lambda *a:(1,None)),
+                        ('unseal',lambda *a:{'token':Provider.key}),('Parser',Provider)]:
+                stack.enter_context(patch.object(service,k,v))
+            assert service.tick(path)
+            db.execute('UPDATE competitor_jobs SET due=0')
+            db.execute('UPDATE competitor_studies SET due=0')
+            stack.enter_context(patch.object(mod,name,side_effect=around))
+            t=threading.Thread(name='first',target=worker)
+            t.start()
+            try:
+                assert entered.wait(5),boundary
+                db.execute("INSERT INTO chats VALUES('chat2','workspace2')")
+                db.execute("INSERT INTO workspaces VALUES('workspace2','actor2')")
+                db.execute("INSERT INTO identity_sessions SELECT x'02','actor2',expires_at FROM identity_sessions LIMIT 1")
+                db.execute("""INSERT INTO competitor_studies SELECT 'next','workspace2','chat2','actor2',x'02',form,
+                           '{"phase":"cards","targets":["200002"]}','running','',NULL,0,created+1 FROM competitor_studies WHERE id='study'""")
+                if action=='stop':endpoint(db,'stop',{'id':'study'})
+                elif action=='expire':db.execute("UPDATE identity_sessions SET expires_at=0 WHERE actor_id='actor'")
+                elif action=='revoke':db.execute("UPDATE competitor_studies SET status='revoked',lease=NULL WHERE id='study'")
+                elif action=='delete-chat':db.execute("DELETE FROM chats WHERE chat_id='chat'")
+                else:
+                    db.execute('BEGIN IMMEDIATE')
+                    purge_workspace(db,'actor','workspace')
+                    db.commit()
+                # Give the second tenant the first turn after the interleaving.
+                db.execute("UPDATE competitor_studies SET due=9999999999 WHERE id='study'")
+                assert service.tick(path)
+                assert db.execute("SELECT count(*) FROM competitor_jobs WHERE research='next'").fetchone()[0]==1
+            finally:
+                released.set()
+                t.join(10)
+            assert not errors and not t.is_alive(),errors
+            db.execute("UPDATE competitor_jobs SET due=0 WHERE research='next'")
+            db.execute("UPDATE competitor_studies SET due=0 WHERE id='next'")
+            db.execute("UPDATE competitor_studies SET due=9999999999 WHERE id='study'")
+            assert service.tick(path)
+            row=db.execute("SELECT state,used,data FROM competitor_jobs WHERE research='study'").fetchone()
+            if action.startswith('delete'):
+                assert row==('detached-settled',1,None),row
+            assert db.execute("SELECT count(*) FROM competitor_receipts").fetchone()[0]==2
+            assert len(sent)==2
+            assert db.execute("SELECT count(*) FROM usage_operations WHERE workspace_id='workspace2'").fetchone()[0]==1
+        db.close()
+        return {'checkpoint':boundary,'action':action,'submissions':len(sent),'receipts':2,'secondTenantProgress':True}
+
+
+if __name__=='__main__':
+    print(json.dumps([scenario(boundary,action) for boundary in ('receipt','parse','checkpoint','before-wallet','after-wallet')
+                      for action in ('stop','expire','revoke','delete-chat','delete-account')],indent=1))
