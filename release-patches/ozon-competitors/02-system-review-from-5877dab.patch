diff --git a/products/harness-platform/deploy/competitors/ROLLBACK_RU.md b/products/harness-platform/deploy/competitors/ROLLBACK_RU.md
new file mode 100644
index 0000000..972b7cd
--- /dev/null
+++ b/products/harness-platform/deploy/competitors/ROLLBACK_RU.md
@@ -0,0 +1,8 @@
+# Восстановление версии плагина
+
+Схема применяется при старте платформы функцией `platform_core.competitors.service.install`. Она оставляет прежние столбцы исследования и заказов и добавляет таблицы квитанций, повторов, временных ограничений и восстановления сессии. Первый запуск заменяет старый триггер удаления использованных заказов и очищает материалы уже удалённых исследований. Эти материалы не восстанавливаются при откате. Журнал поставщика хранит минимальные технические идентификаторы и расход.
+
+1. По штатному регламенту релиза зафиксировать фактический путь `current`, версию исполняемой среды, состояние процессов, подтверждённый снимок SQLite и соответствующий журнал отзывов. Для production требуется допуск владельца.
+2. Остановить новые исследования, дождаться завершения рабочих процессов и сохранить текущий журнал заказов и квитанций. Сверить принятые идентификаторы, неизвестные исходы, карантин и фактические `used_checks_total`. Для карантина сохранить обе наблюдаемые величины и ответ поставщика. Старый worker не понимает новые состояния журнала.
+3. Возвращать только предыдущий согласованный релиз через штатный механизм выкладки. Пока есть незавершённые исследования, квитанции с расхождениями или ожидающие авторизации, использовать для отката сборку без включённого плагина. При возврате к его старой версии сначала завершить финансовую сверку и остановить доступ к новому и старому обработчикам конкурентного анализа.
+4. Сохранить новые таблицы и журнал отзывов. Переключение версии приложения не требует восстановления устаревшей базы поверх последующих заказов. Проверить чат, базовые плагины и кошелёк, целостность БД, отсутствие новых обращений поставщику. При повторном обновлении сверить число и сумму квитанций, неизменность идентификаторов и доступность старых отчётов.
diff --git a/products/harness-platform/deploy/competitors/migration.sql b/products/harness-platform/deploy/competitors/migration.sql
new file mode 100644
index 0000000..c0223e1
--- /dev/null
+++ b/products/harness-platform/deploy/competitors/migration.sql
@@ -0,0 +1,80 @@
+PRAGMA foreign_keys=ON;
+
+BEGIN IMMEDIATE;
+
+DROP TRIGGER IF EXISTS competitor_forget;
+
+CREATE TABLE IF NOT EXISTS competitor_studies(
+        id TEXT PRIMARY KEY, workspace TEXT NOT NULL REFERENCES workspaces ON DELETE CASCADE,
+        chat TEXT NOT NULL REFERENCES chats ON DELETE CASCADE, actor TEXT NOT NULL, digest BLOB NOT NULL,
+        form TEXT NOT NULL, result TEXT NOT NULL, status TEXT NOT NULL, error TEXT NOT NULL DEFAULT '',
+        lease TEXT, due REAL NOT NULL DEFAULT 0, created REAL NOT NULL);
+
+CREATE TABLE IF NOT EXISTS competitor_assets(id TEXT PRIMARY KEY,research TEXT NOT NULL REFERENCES competitor_studies ON DELETE CASCADE,
+        sku TEXT NOT NULL,url TEXT NOT NULL,mime TEXT NOT NULL,digest TEXT NOT NULL,content BLOB NOT NULL,selected INTEGER NOT NULL,
+        UNIQUE(research,sku,url));
+
+CREATE TABLE IF NOT EXISTS competitor_drafts(chat TEXT PRIMARY KEY REFERENCES chats ON DELETE CASCADE,revision INTEGER NOT NULL,form TEXT NOT NULL);
+
+CREATE TABLE IF NOT EXISTS competitor_exchanges(chat TEXT REFERENCES chats ON DELETE CASCADE,request TEXT,text TEXT,answer TEXT,PRIMARY KEY(chat,request));
+
+CREATE TABLE IF NOT EXISTS competitor_jobs(
+      research TEXT NOT NULL, phase TEXT NOT NULL, label TEXT NOT NULL UNIQUE, account TEXT NOT NULL,
+      kind TEXT NOT NULL, region TEXT NOT NULL, rows TEXT NOT NULL, reserved INTEGER NOT NULL,
+      state TEXT NOT NULL, due REAL NOT NULL, order_id TEXT, used INTEGER, data TEXT, error TEXT,
+      PRIMARY KEY(research,phase));
+
+CREATE TABLE IF NOT EXISTS competitor_receipts(
+       account TEXT NOT NULL,order_id TEXT NOT NULL,label TEXT NOT NULL UNIQUE,used INTEGER NOT NULL CHECK(used>=0),
+       PRIMARY KEY(account,order_id));
+
+CREATE TABLE IF NOT EXISTS competitor_backoff(account TEXT PRIMARY KEY,label TEXT NOT NULL,due REAL NOT NULL);
+
+CREATE TABLE IF NOT EXISTS competitor_attempts(label TEXT PRIMARY KEY,attempts INTEGER NOT NULL);
+
+CREATE TABLE IF NOT EXISTS competitor_polls(label TEXT PRIMARY KEY,attempts INTEGER NOT NULL DEFAULT 0);
+
+CREATE TABLE IF NOT EXISTS competitor_incidents(label TEXT NOT NULL,reason TEXT NOT NULL,
+        accepted_id TEXT,reported_id TEXT,accepted_checks INTEGER,reported_checks INTEGER,created REAL NOT NULL,
+        PRIMARY KEY(label,reason));
+
+CREATE INDEX IF NOT EXISTS competitor_jobs_account ON competitor_jobs(account,state);
+
+CREATE TABLE IF NOT EXISTS competitor_seller_cache(cid TEXT REFERENCES account_integrations(id) ON DELETE CASCADE,
+       version INTEGER,since TEXT,until TEXT,sku TEXT,payload TEXT NOT NULL,PRIMARY KEY(cid,version,since,until,sku));
+
+CREATE TRIGGER IF NOT EXISTS competitor_detach AFTER DELETE ON chat_plugins WHEN OLD.plugin_id='ozon-competitors'
+        BEGIN UPDATE competitor_studies SET status='revoked',lease=NULL WHERE chat=OLD.chat_id;
+        DELETE FROM competitor_drafts WHERE chat=OLD.chat_id; END;
+
+CREATE TRIGGER IF NOT EXISTS competitor_revoke AFTER DELETE ON chat_integrations
+        BEGIN UPDATE competitor_studies SET status='revoked',lease=NULL WHERE chat=OLD.chat_id AND
+        OLD.connection_id IN (json_extract(form,'$.parser'),json_extract(form,'$.store')); END;
+
+CREATE TRIGGER IF NOT EXISTS competitor_reconcile_revoked AFTER UPDATE OF status ON competitor_studies
+       WHEN NEW.status='revoked' BEGIN
+       UPDATE competitor_jobs SET error='Сверка ожидает восстановления доступа к исходному заказу'
+       WHERE research=NEW.id AND used IS NULL AND state NOT IN ('declined','not-sent'); END;
+
+CREATE TRIGGER IF NOT EXISTS competitor_finance_revocation AFTER UPDATE OF status ON competitor_studies
+       WHEN NEW.status='revoked' BEGIN
+       UPDATE competitor_jobs SET state=CASE WHEN state='rate-limited' THEN 'not-sent' ELSE 'detached-pending' END,
+         used=CASE WHEN state='rate-limited' THEN 0 ELSE used END,due=0,rows='[]',data=NULL,
+         error='Требуется авторизованная сверка' WHERE research=NEW.id AND used IS NULL AND state<>'quarantine';
+       END;
+
+CREATE TABLE IF NOT EXISTS competitor_auth_pause(research TEXT PRIMARY KEY REFERENCES competitor_studies(id)
+       ON DELETE CASCADE, execution TEXT NOT NULL);
+
+CREATE TRIGGER IF NOT EXISTS competitor_detach_finance AFTER DELETE ON competitor_studies BEGIN
+       UPDATE competitor_jobs SET rows='[]',data=NULL,region='',kind='',error=NULL,
+         state=CASE WHEN state='quarantine' THEN state WHEN used IS NOT NULL OR state='rate-limited' THEN 'detached-settled' ELSE 'detached-pending' END,
+         used=CASE WHEN state='rate-limited' THEN 0 ELSE used END,due=0 WHERE research=OLD.id;
+       END;
+
+UPDATE competitor_jobs SET rows='[]',data=NULL,region='',kind='',error=NULL,due=0,
+        state=CASE WHEN used IS NULL THEN 'detached-pending' ELSE 'detached-settled' END
+        WHERE state NOT IN ('detached-pending','detached-settled','quarantine')
+        AND NOT EXISTS(SELECT 1 FROM competitor_studies r WHERE r.id=competitor_jobs.research AND r.status<>'revoked');
+
+COMMIT;
