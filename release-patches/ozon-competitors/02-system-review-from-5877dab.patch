+class Facts(unittest.TestCase):
+    def test_pump_with_different_connector_has_same_primary_purpose(self):
+        def card(title):
+            return dict(title=title,type='Насос',breadcrumbs=['Спорт','Насосы'],characteristics={'Назначение насоса':['Велосипедный насос']})
+        self.assertEqual(analysis.decision('2',card('Насос с головкой на шланге'),[],set(),[analysis.profile(card('Насос под ниппель'))])[0],'ELIGIBLE')
+    def test_title_suffix_and_inflection_do_not_override_mount(self):
+        a=dict(type='Аксессуар',breadcrumbs=['Декор'],title='Подвеска на зеркало',description='Крепится на зеркале.')
+        b=dict(a,title='Декор в автомобиль / рисунок на дереве / для удачи',description='Можно повесить на зеркало, носить с собой.')
+        self.assertEqual(analysis.decision('2',b,[],set(),[analysis.profile(a)])[0],'ELIGIBLE')
+        b['description']='Нельзя повесить на зеркало.'
+        self.assertNotEqual(analysis.decision('2',b,[],set(),[analysis.profile(a)])[0],'ELIGIBLE')
+
+    def test_different_category_namespaces_remain_uncertain(self):
+        a=dict(type='Весы',breadcrumbs=['Кухня','Весы'],title='Весы')
+        b={**a,'publicCategories':[{'url':'https://www.ozon.ru/category/vesy-456/'}]}
+        self.assertEqual(analysis.decision('2',a,[],set(),[analysis.profile(b)])[0],'NEEDS_CHECK')
+    def test_equal_leaf_names_in_distinct_paths(self):
+        a=dict(type='Фильтр',breadcrumbs=['Аквариумистика','Фильтры'])
+        b=dict(a,breadcrumbs=['Водопровод','Фильтры'])
+        self.assertEqual(analysis.decision('2',a,[],set(),[analysis.profile(b)])[0],'OTHER_CATEGORY')
+    def test_saved_error_receipt_cannot_authorize_another(self):
+        rows=products('search',['поиск'],32)
+        result={'search':{'поиск':{'depth':32,'order':'100','label':'a','code':'Q1','state':'ERROR'}}}
+        self.assertFalse(routes.failed_items('search',rows,result,'101','verify','b'))
+        self.assertTrue(routes.failed_items('search',rows,result,'100','verify','a'))
+    def test_revised_target_list_scopes_photos_and_chosen_references(self):
+        db=sqlite3.connect(':memory:')
+        self.addCleanup(db.close)
+        db.execute('CREATE TABLE competitor_assets(research,sku,selected)')
+        db.executemany('INSERT INTO competitor_assets VALUES(?,?,?)',[('r','1',1),('r','2',0),('other','2',1)])
+        args=routes.asset_scope('r',{'targets':['2']})
+        self.assertEqual(db.execute('SELECT count(*),sum(selected) FROM competitor_assets WHERE '+routes.ASSET_SCOPE,args).fetchone(),(1,0))
+        self.assertFalse(db.execute('UPDATE competitor_assets SET selected=1 WHERE '+routes.ASSET_SCOPE+' AND sku=?',(*args,'1')).rowcount)
+
+    def test_no_measurements_when_all_csv_rows_fail(self):
+        parsed=own.performance_csv('Отчёт\nSKU;Поисковый запрос;Показы;Клики\n101;поиск;-10;0\n'.encode())
+        self.assertEqual(parsed['invalidRows'],[3])
+        self.assertIsNone(parsed['totals']['all']['impressions'])
+    def test_coverage_keeps_found_position_in_incomplete_sample(self):
+        rows=products('search',['запрос'],3)
+        src=analysis.parse_batch('search',rows,{'id':'1','data':[{**rows[0],'offers':[None,{'Marketid':'111'}]}]})
+        kernel=analysis.observed(['111'],['запрос'],src)
+        fact=kernel['111']['phrases']['запрос']
+        self.assertEqual((fact['status'],fact['response_index'],fact['coverage']),('FOUND',2,'INCOMPLETE'))
+        q=quality({'targets':['111'],'kernel':kernel,'cards':{'111':{'sku':'111'}}})
+        self.assertTrue(q['partial'])
+    def test_research_selection_follows_scope_and_exact_subject(self):
+        db=sqlite3.connect(':memory:')
+        self.addCleanup(db.close)
+        db.executescript('CREATE TABLE competitor_studies(id,workspace,chat,actor,status,created,form,result,error);CREATE TABLE competitor_exchanges(chat,text);')
+        scope=Scope('u','w','c')
+        for rid,actor,skus in [('1','u',['123456','345678']),('2','u',['234567','345678']),('other','v',['123456'])]:
+            db.execute('INSERT INTO competitor_studies VALUES(?,?,?,?,?,?,?,?,?)',(rid,'w','c',actor,'done',1,'{}',json.dumps({'targets':skus}),''))
+        with patch('platform_core.user_plugins.registry.attached',return_value=True),patch.object(routes,'permitted'):
+            self.assertEqual(routes.resolve(db,scope,'Покажи фото конкурента 123456').research,'1')
+            self.assertEqual(routes.resolve(db,scope,'Покажи фото конкурента 345678').action,'clarify')
+            self.assertEqual(routes.resolve(db,scope,'Проанализируй конкурента 987654 по фразам').action,'new')
+            self.assertEqual(routes.resolve(db,scope,'Погода завтра').action,'other')
