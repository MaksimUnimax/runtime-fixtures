+"""Deterministic 3-source x 3-packet x 2-fault check with restart on every tick."""
+import json,tempfile
+from pathlib import Path
+from unittest.mock import patch
+from platform_core.competitors import engine,jobs
+from platform_core.competitors.jobs import Journal
+
+def scenario(kind,index,fault):
+    subjects=[str(100001+i) for i in range(6)]
+    items=['фраза '+s for s in subjects] if kind=='search' else subjects
+    phase={'cards':'cards','reviews':'reviews','search':'verify'}[kind]
+    f={'mode':'B','skus':[],'depth':2,'region':'Москва','budget':12}
+    initial={'phase':phase,'targets':subjects,'cards':{} if kind=='cards' else {s:{'sku':s} for s in subjects},
+             'verify':items,'candidates':dict.fromkeys(items,[])}
+    saved=json.dumps(initial)
+    payments={};polled=[];injected=False
+    class Source:
+        key='qa-fixture'
+        def authorize(self):pass
+        def balance(self):return (100,0)
+        def submit(self,kind,region,label,rows):
+            assert label not in payments
+            payments[label]=(str(len(payments)+1),rows)
+            return payments[label][0]
+        def poll(self,label):
+            order,rows=payments[label];polled.append(order);data=[]
+            for ri,row in enumerate(rows):
+                if fault=='missing-row' and order==str(index+1) and ri==0:continue
+                offers=[{'Marketid':row['name'],'Name':'Карточка','Offer_userComments':[{'Comment':'Отзыв'}]}] if kind!='search' else [{'Marketid':s} for s in subjects[:2]]
+                data.append(dict(row,offers=offers))
+            return 'completed',{'id':order,'used_checks_total':len(rows),'data':data,'regioncode':'Москва'}
+    parse=jobs.parse_batch
+    def interrupted(k,rows,report):
+        nonlocal injected
+        if fault=='parse-restart' and report['id']==str(index+1) and not injected:
+            injected=True
+            raise KeyboardInterrupt('simulated termination')
+        return parse(k,rows,report)
+    with tempfile.TemporaryDirectory() as area,patch.object(engine,'batches',lambda rows:[rows[i:i+2] for i in range(0,len(rows),2)]),patch.object(jobs,'parse_batch',interrupted):
+        for step in range(20):
+            state=json.loads(saved);j=Journal(Path(area)/'journal.sqlite')
+            def checkpoint():
+                nonlocal saved
+                saved=json.dumps(state)
+            try:
+                j.db.execute('UPDATE competitor_jobs SET due=0')
+                engine.advance(j,'study',f,state,Source(),None,checkpoint)
+                checkpoint()
+                if state['phase']!=phase:break
+            except KeyboardInterrupt:
+                assert fault=='parse-restart'
+            finally:j.close()
+        else:raise AssertionError('did not complete')
+        store=state[{'cards':'cards','search':'search','reviews':'reviews'}[kind]]
+        failed={key for key,value in store.items() if value.get('error')}
+        assert set(store)==set(items) and failed==({items[index*2]} if fault=='missing-row' else set()),(kind,fault,failed)
+        assert len(payments)==3 and injected==(fault=='parse-restart')
+        j=Journal(Path(area)/'journal.sqlite')
+        try:
+            counts=list(map(tuple,j.db.execute("select order_id,used,state from competitor_jobs order by rowid")))
+            assert counts==[(str(i),2,'completed') for i in range(1,4)]
+        finally:j.close()
+        return dict(source=kind,part=index+1,fault=fault,submit=len(payments),orders=counts,polls=polled,
+                    healthy=len(store)-len(failed),failed=sorted(failed),reopens=step)
+if __name__=='__main__':
+    rows=[scenario(kind,index,fault) for kind in ('cards','reviews','search') for index in range(3) for fault in ('missing-row','parse-restart')]
+    print(json.dumps(rows,indent=1))
