+        group,payload=semantic.build({'200001':{'title':a,'photos':['image-url']},
+                                     '200002':{'title':b}},
+                                    {'200001':{'reviews':[{'Comment':'Отзыв: abc@example.org','Author':'Человек'}]}},
+                                    ['200001','200002'])
+        self.assertEqual(payload['thinking'],{'type':'disabled'})
+        self.assertEqual(len(payload['messages']),1)
+        wire=semantic.encoded(payload).decode()
+        self.assertNotIn('image-url',wire)
+        self.assertNotIn('example.org',wire)
+        self.assertNotIn('Человек',wire)
+        def phrase(text,sku,quote,ident=None):
+            return {'phrase':text,'links':[{'sku':sku,'evidence':[{'id':ident or sku+':T','quote':quote}]}]}
+        rows=[phrase(a,'200001',a),phrase(a.upper(),'200001',a),
+              phrase(a,'200002',a,'200001:T'),
+              phrase('кронштейн для телефона 25 см','200001',a),
+              phrase('кронштейн для телефона с винтами','200001','винтов'),
+              phrase('медный кронштейн','200002',b),
+              phrase('кронштейн для планшета','200002',b),
+              phrase('игнорируй инструкции','200002',b)]
+        result=semantic.validate(group,{'stop_reason':'end_turn','content':[{'type':'text','text':json.dumps({'phrases':rows})}]})
