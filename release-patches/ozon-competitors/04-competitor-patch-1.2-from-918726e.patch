@@ -6,3 +6,10 @@
 2. Остановить новые исследования, дождаться завершения рабочих процессов и сохранить текущий журнал заказов и квитанций. Сверить принятые идентификаторы, неизвестные исходы, карантин и фактические `used_checks_total`. Для карантина сохранить обе наблюдаемые величины и ответ поставщика. Старый worker не понимает новые состояния журнала.
 3. Возвращать только предыдущий согласованный релиз через штатный механизм выкладки. Пока есть незавершённые исследования, квитанции с расхождениями или ожидающие авторизации, использовать для отката сборку без включённого плагина. При возврате к его старой версии сначала завершить финансовую сверку и остановить доступ к новому и старому обработчикам конкурентного анализа.
 4. Сохранить новые таблицы и журнал отзывов. Переключение версии приложения не требует восстановления устаревшей базы поверх последующих заказов. Проверить чат, базовые плагины и кошелёк, целостность БД, отсутствие новых обращений поставщику. При повторном обновлении сверить число и сумму квитанций, неизменность идентификаторов и доступность старых отчётов.
+
+## Откат 1.2
+
+1. Зафиксируйте текущий SHA приложения и используемого шлюза. Остановите приём новых исследований 1.2 и дождитесь завершения активных сетевых операций. Снимите согласованную копию SQLite и файла журнала шлюза.
+2. Сверьте `competitor_enrichment`, `usage_operations` и `coin_attempts` по `operation_id`. После подтверждения поставщика примените штатную сверку DeepSeek или раздел сверки BHAPI в админке. Состояния dispatching/unknown не являются основанием отправлять запрос снова.
+3. Патч добавляет две таблицы и два триггера. При переключении версий оставьте записи и квитанции в базе. Перед запуском старого worker убедитесь, что исследования 1.2 завершены или остановлены и устаревшая сборка исключена из их обработки. Старый worker не обрабатывает semantic/commercial.
+4. Проверьте целостность SQLite, доступность исторических отчётов и равенство сумм по закрытым операциям. При повторном обновлении включите BHAPI в админке после подтверждения тарифа и условий подключения. Существующие исследования используют замороженный план.
diff --git a/products/harness-platform/deploy/competitors/migration-1.2.sql b/products/harness-platform/deploy/competitors/migration-1.2.sql
new file mode 100644
index 0000000..fc3498f
--- /dev/null
+++ b/products/harness-platform/deploy/competitors/migration-1.2.sql
@@ -0,0 +1,30 @@
+-- Apply to an initialized Octoport database with the 1.1 competitor and wallet schemas.
+PRAGMA foreign_keys=ON;
+BEGIN IMMEDIATE;
+
+CREATE TABLE IF NOT EXISTS competitor_commercial_settings(
+       singleton INTEGER PRIMARY KEY CHECK(singleton=1), enabled INTEGER NOT NULL,
+       rub_units INTEGER NOT NULL, version TEXT NOT NULL);
+
+CREATE TABLE IF NOT EXISTS competitor_enrichment(
+       research TEXT NOT NULL, provider TEXT NOT NULL, operation TEXT NOT NULL UNIQUE,
+       plan_hash TEXT NOT NULL, state TEXT NOT NULL, request TEXT, result TEXT,
+       created REAL NOT NULL, provider_id TEXT, PRIMARY KEY(research,provider));
+
+CREATE TRIGGER IF NOT EXISTS competitor_enrichment_revoked AFTER UPDATE OF status ON competitor_studies
+       WHEN NEW.status IN ('stopped','revoked') AND NEW.status<>OLD.status BEGIN
+         UPDATE coin_attempts SET charge=0,evidence='not_dispatched' WHERE charge IS NULL AND operation_id IN
+           (SELECT operation FROM competitor_enrichment WHERE research=NEW.id AND state='reserved');
+         UPDATE competitor_enrichment SET state='cancelled',request=NULL
+           WHERE research=NEW.id AND state='reserved';
+         UPDATE competitor_enrichment SET request=NULL,result=NULL WHERE research=NEW.id AND NEW.status='revoked';
+       END;
+
+CREATE TRIGGER IF NOT EXISTS competitor_enrichment_deleted AFTER DELETE ON competitor_studies BEGIN
+         UPDATE coin_attempts SET charge=0,evidence='not_dispatched' WHERE charge IS NULL AND operation_id IN
+           (SELECT operation FROM competitor_enrichment WHERE research=OLD.id AND state='reserved');
+         UPDATE competitor_enrichment SET state=CASE WHEN state='reserved' THEN 'cancelled' ELSE state END,
+           request=NULL,result=NULL WHERE research=OLD.id;
+       END;
+
+COMMIT;
diff --git a/products/harness-platform/docs/OZON_COMPETITORS.md b/products/harness-platform/docs/OZON_COMPETITORS.md
index d1b9780..c6d7812 100644
