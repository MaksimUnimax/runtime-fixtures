diff --git a/products/harness-platform/platform_core/competitors/enrichment.py b/products/harness-platform/platform_core/competitors/enrichment.py
new file mode 100644
index 0000000..e8bb34a
--- /dev/null
+++ b/products/harness-platform/platform_core/competitors/enrichment.py
@@ -0,0 +1,336 @@
+"""Durable enrichment operations using the same wallet as the model gateway."""
+import hashlib
+import json
+import os
+import re
+import time
+from uuid import uuid4
+
+import httpx
+
+from .. import coins, provider_keys
+from ..operation_grants import ensure_operation_schema, issue_grant, revoke_grant
+from . import bhapi, semantic
+from .jobs import transaction
+
+DS = 'competitors.semantic'
+BH = 'competitors.bhapi'
+HOLD = 'competitor-semantic-hold-v1'
+BH_RATE = 'bhapi-v1'
+SCHEMA = (
+    """CREATE TABLE IF NOT EXISTS competitor_commercial_settings(
+       singleton INTEGER PRIMARY KEY CHECK(singleton=1), enabled INTEGER NOT NULL,
+       rub_units INTEGER NOT NULL, version TEXT NOT NULL)""",
+    """CREATE TABLE IF NOT EXISTS competitor_enrichment(
+       research TEXT NOT NULL, provider TEXT NOT NULL, operation TEXT NOT NULL UNIQUE,
+       plan_hash TEXT NOT NULL, state TEXT NOT NULL, request TEXT, result TEXT,
+       created REAL NOT NULL, provider_id TEXT, PRIMARY KEY(research,provider))""",
+)
+FINANCE_TRIGGERS = (
+    """CREATE TRIGGER IF NOT EXISTS competitor_enrichment_revoked AFTER UPDATE OF status ON competitor_studies
+       WHEN NEW.status IN ('stopped','revoked') AND NEW.status<>OLD.status BEGIN
+         UPDATE coin_attempts SET charge=0,evidence='not_dispatched' WHERE charge IS NULL AND operation_id IN
+           (SELECT operation FROM competitor_enrichment WHERE research=NEW.id AND state='reserved');
+         UPDATE competitor_enrichment SET state='cancelled',request=NULL
+           WHERE research=NEW.id AND state='reserved';
+         UPDATE competitor_enrichment SET request=NULL,result=NULL WHERE research=NEW.id AND NEW.status='revoked';
+       END""",
+    """CREATE TRIGGER IF NOT EXISTS competitor_enrichment_deleted AFTER DELETE ON competitor_studies BEGIN
+         UPDATE coin_attempts SET charge=0,evidence='not_dispatched' WHERE charge IS NULL AND operation_id IN
+           (SELECT operation FROM competitor_enrichment WHERE research=OLD.id AND state='reserved');
+         UPDATE competitor_enrichment SET state=CASE WHEN state='reserved' THEN 'cancelled' ELSE state END,
+           request=NULL,result=NULL WHERE research=OLD.id;
+       END""",
+)
+
+
+def key_version(key):
+    return hashlib.sha256(key.encode()).hexdigest() if key else None
+
+
+def settings(db):
+    exists=db.execute("SELECT 1 FROM sqlite_master WHERE name='competitor_commercial_settings'").fetchone()
+    row=db.execute('SELECT enabled,rub_units,version FROM competitor_commercial_settings WHERE singleton=1').fetchone() if exists else None
+    key=provider_keys.read('bhapi')
+    return {'configured':bool(key),'enabled':bool(row and row[0]),'rub':coins.display(row[1]) if row else '',
+            'version':row[2] if row else None}
+
+
+def save_settings(db, enabled, rub):
+    if type(enabled) is not bool:
+        raise ValueError('Проверьте состояние подключения BHAPI')
+    units=coins.parse_amount(rub,allow_zero=True)
+    if enabled and not provider_keys.read('bhapi'):
+        raise ValueError('Сначала сохраните ключ аналитики BHAPI')
+    db.execute('INSERT OR REPLACE INTO competitor_commercial_settings VALUES (1,?,?,?)',(int(enabled),units,uuid4().hex))
+
+
+def semantic_bound(fx):
+    # Same peak rates and byte-based upper bound as gateway/coin-billing.mjs.
+    # Include the gateway-generated metadata and Messages framing.
+    weighted=300000*(semantic.MAX_INPUT_BYTES+1500)+1200000*semantic.MAX_TOKENS
+    return (weighted*fx+9999)//10000
+
+
+def configuration(db, gateway=None):
+    settings_now=settings(db)
+    fx=coins.rub_rate()
+    deepseek_key=provider_keys.read('deepseek')
+    configured_gateway=gateway or os.getenv('HARNESS_MODEL_GATEWAY_URL')
+    return {'version':1, 'semantic':bool(configured_gateway and os.getenv('HARNESS_OFFLINE_MODEL')!='1'),
+            'semanticKey':key_version(deepseek_key), 'semanticLimit':semantic_bound(fx), 'fx':fx,
+            'commercial':settings_now['enabled'] and settings_now['configured'],
+            'bhapiKey':key_version(provider_keys.read('bhapi')) if settings_now['enabled'] else None,
+            'bhapiTariff':settings_now['version'], 'bhapiUnits':coins.parse_amount(settings_now['rub'],allow_zero=True)
+                if settings_now['enabled'] else 0}
+
+
+def fingerprint(plan):
+    return hashlib.sha256(json.dumps(plan,sort_keys=True,separators=(',',':')).encode()).hexdigest()
+
+
+def estimate(plan):
+    return {'confirmation':fingerprint(plan), 'deepseek':{'calls':int(plan['semantic']),
+                'maxRub':coins.display(plan['semanticLimit']) if plan['semantic'] else None,
+                'configured':plan['semantic']},
+            'bhapi':{'calls':int(plan['commercial']), 'rubPerSuccess':coins.display(plan['bhapiUnits'])
+                     if plan['commercial'] else None,'configured':plan['commercial']}}
+
+
+def record(db,scope,rid,provider,request,bound,config):
+    operation=uuid4().hex
+    db.execute('INSERT INTO usage_operations VALUES (?,?,?,?,?,?)',
+               (operation,scope.actor_id,scope.workspace_id,scope.chat_id,provider,rid))
+    db.execute('INSERT INTO coin_orders(operation_id,workspace_id,cap,markup,coins_per_usd) VALUES(?,?,?,0,1)',
+               (operation,scope.workspace_id,bound))
+    db.execute('INSERT INTO coin_ruble_orders VALUES (?,?)',(operation,config['fx']))
+    now=time.time()
+    db.execute("""INSERT INTO coin_attempts(attempt_id,operation_id,bound,model,started_ms,rate_version,period)
+                  VALUES(?,?,?,?,?,?,?)""",
+               ('hold:'+operation,operation,bound,'BHAPI' if provider==BH else semantic.MODEL,int(now*1000),
+                BH_RATE if provider==BH else HOLD,'fixed' if provider==BH else 'reservation'))
+    db.execute('INSERT INTO competitor_enrichment VALUES (?,?,?,?,?,?,NULL,?,NULL)',
+               (rid,provider,operation,fingerprint({'request':request,'config':config}), 'reserved',
+                json.dumps(request,ensure_ascii=False),now))
+
+
+def targets_for_commerce(data,form):
+    if 'commercialTargets' in data:
+        return data['commercialTargets']
+    return [s for s in data['targets'] if s not in form.get('own',[])]
+
+
+def reserve(db,scope,rid,form,data,authorize,group):
+    config=form['enrichment']
+    targets=targets_for_commerce(data,form)
+    bill=[]
+    if group and config['semantic']:
+        bill.append((DS,{'skus':[item['sku'] for item in group],'inputHash':fingerprint(group)},config['semanticLimit']))
+    if targets and config['commercial']:
+        request,period=bhapi.plan(targets)
+        bill.append((BH,{'body':request,'period':period},config['bhapiUnits']))
+    if not bill:
+        return {}
+    with transaction(db):
+        authorize()
+        ensure_operation_schema(db)
+        for sql in FINANCE_TRIGGERS:
+            db.execute(sql)
+        if db.execute('SELECT 1 FROM competitor_enrichment WHERE research=?',(rid,)).fetchone():
+            return {}
+        coins.close_orders(db,scope.workspace_id)
+        remaining=coins.balances(db,scope.workspace_id)[0]
+        # Insufficient funds for one provider do not discard the independent affordable stage.
+        blocked={}
+        for provider,request,bound in bill:
+            if provider==DS and not db.execute('SELECT 1 FROM workspace_paid_model_access WHERE workspace_id=?',
+                                               (scope.workspace_id,)).fetchone():
+                blocked[provider]='Для DeepSeek нужен оплаченный доступ'
+            elif remaining<bound:
+                blocked[provider]='Недостаточно монет для согласованного резерва'
+            else:
+                record(db,scope,rid,provider,request,bound,config)
+                remaining-=bound
+        return blocked
+
+
+def receipt(db,operation):
+    entries=db.execute('SELECT bound,charge,provider_id,usage_json,rate_version,evidence FROM coin_attempts WHERE operation_id=?',
+                       (operation,)).fetchall()
+    valid=[r for r in entries if r[4]!=HOLD]
+    return {'operationId':operation,'reservedRub':coins.display(sum(r[0] for r in entries if r[1] is None)),
+            'chargedRub':None if any(r[1] is None for r in entries) else coins.display(sum(r[1] for r in entries)),
+            'providerId':next((r[2] for r in valid if r[2]),None),
+            'usage':next((json.loads(r[3]) for r in valid if r[3]),None)}
+
+
+def public_receipts(db,rid):
+    return {provider.rsplit('.',1)[-1]:{'state':state,**receipt(db,operation)}
+            for provider,operation,state in db.execute(
+                'SELECT provider,operation,state FROM competitor_enrichment WHERE research=?',(rid,))}
+
+
+def finish(db,rid,provider,operation,result,charge=None,provider_id=None,release_semantic=False):
+    with transaction(db):
+        if provider==BH and charge is not None:
+            db.execute('UPDATE coin_attempts SET charge=?,provider_id=?,evidence=? WHERE attempt_id=? AND charge IS NULL',
+                       (charge,provider_id,result['state'],'hold:'+operation))
+        if provider==DS and release_semantic:
+            db.execute("UPDATE coin_attempts SET charge=0,evidence='not_metered' WHERE attempt_id=? AND charge IS NULL",
+                       ('hold:'+operation,))
+        # A late provider response records settlement but cannot reattach removed content.
+        db.execute("""UPDATE competitor_enrichment SET state=?,provider_id=?,
+                      result=CASE WHEN EXISTS(SELECT 1 FROM competitor_studies WHERE id=? AND status<>'revoked')
+                                  THEN ? ELSE NULL END
+                      WHERE research=? AND provider=? AND state IN ('dispatching','unknown')""",
+                   (result['state'],provider_id,rid,json.dumps(result,ensure_ascii=False),rid,provider))
+        coins.close_orders(db)
+
+
+def pending_bhapi(db):
+    return [{'operationId':op,'reservedRub':coins.display(bound),'created':created,'providerId':provider_id}
+            for op,bound,created,provider_id in db.execute("""
+                SELECT e.operation,a.bound,e.created,e.provider_id FROM competitor_enrichment e
+                JOIN coin_attempts a ON a.operation_id=e.operation
+                WHERE e.provider=? AND a.charge IS NULL AND (e.state='unknown' OR
+                        (e.state='dispatching' AND e.created<unixepoch()-300))
+                ORDER BY e.created LIMIT 100""",(BH,))]
+
+
+def reconcile_bhapi(db, operation, charged, evidence):
+    if (not isinstance(operation,str) or not re.fullmatch('[0-9a-f]{32}',operation)
+            or type(charged) is not bool or not isinstance(evidence,str)
+            or not re.fullmatch(r'[\w .:/-]{5,120}',evidence)):
+        raise ValueError('Укажите операцию, исход и ссылку на квитанцию или идентификатор сверки')
+    matched=db.execute("""
+        SELECT a.attempt_id,a.bound,a.charge,e.state FROM competitor_enrichment e
+        JOIN coin_attempts a ON a.operation_id=e.operation WHERE e.operation=? AND e.provider=?
+           AND (e.state IN ('unknown','reconciled') OR
+                   (e.state='dispatching' AND e.created<unixepoch()-300))""",(operation,BH)).fetchone()
+    if not matched:
+        raise ValueError('Операция недоступна для ручной сверки')
+    attempt, bound, prior, state = matched
+    charge=bound if charged else 0
+    if prior is not None and prior!=charge:
+        raise ValueError('Решение противоречит уже проведённой сверке')
+    if state!='reconciled':
+        db.execute('UPDATE coin_attempts SET charge=?,evidence=? WHERE attempt_id=? AND charge IS NULL',
+                   (charge,'bhapi-reviewed:'+evidence,attempt))
+        db.execute("UPDATE competitor_enrichment SET state='reconciled' WHERE operation=?",(operation,))
+        coins.close_orders(db)
+    return {'operationId':operation,'chargedRub':coins.display(charge)}
+
+def model_call(path,scope,rid,gateway,group,payload,authorize,version):
+    if not gateway:
+        return {'state':'unavailable','reason':'Шлюз DeepSeek недоступен'},None
+    grant=issue_grant(path,scope,source=DS,run_key=rid,direct_fallback=(semantic.MODEL,'off'),
+                      direct_override=(semantic.MODEL,'off'))
+    try:
+        authorize()
+        with httpx.Client(timeout=75,follow_redirects=False,trust_env=False) as client:
+            headers={'x-api-key':grant.token,'content-type':'application/json','anthropic-version':'2023-06-01'}
+            if version:
+                headers['x-octoport-semantic-key']=version
+            with client.stream('POST',gateway.rstrip('/')+'/v1/messages',content=semantic.encoded(payload),
+                               headers=headers) as response:
+                if response.status_code!=200:
+                    return ({'state':'error','reason':f'DeepSeek через шлюз HTTP {response.status_code}'},None)
+                raw=bytearray()
+                for chunk in response.iter_bytes():
+                    raw.extend(chunk)
+                    if len(raw)>1024*1024:
+                        return ({'state':'error','reason':'Ответ DeepSeek превысил лимит'},None)
+        obj=json.loads(raw)
+        try:
+            parsed=semantic.validate(group,obj)
+        except (ValueError,TypeError,RecursionError):
+            return ({'state':'error','reason':'DeepSeek не вернул проверяемый JSON со ссылками на данные'},obj.get('id') if isinstance(obj,dict) else None)
+        parsed['usage']=obj.get('usage')
+        parsed['state']='partial' if parsed['rejected'] or not parsed['phrases'] else 'complete'
+        return parsed,obj.get('id')
+    finally:
+        revoke_grant(path,grant.token)
+
+
+def run(db,path,scope,rid,provider,form,group,payload,gateway,authorize,blocked):
+    summary='DeepSeek' if provider==DS else 'BHAPI'
+    with transaction(db):
+        authorize()
+        row=db.execute('SELECT operation,state,request,result FROM competitor_enrichment WHERE research=? AND provider=?',
+                       (rid,provider)).fetchone()
+        if not row:
+            return {'state':'unavailable','reason':blocked.get(provider,summary+' недоступен для этого исследования')}
+        operation,state,raw_request,saved=row
+        if saved:
+            return json.loads(saved)
+        if state=='reserved':
+            db.execute("UPDATE competitor_enrichment SET state='dispatching' WHERE research=? AND provider=?",
+                       (rid,provider))
+    if state in ('dispatching','unknown'):
+        result={'state':'unknown','reason':'Исход отправки требует сверки. Повтор отключён'}
+        # DeepSeek wallet admission is fenced by state=dispatching. Once the
+        # study lease is lost, an unused placeholder can safely be released.
+        finish(db,rid,provider,operation,result,release_semantic=(provider==DS))
+        return result
+    if state!='reserved':
+        return {'state':state,'reason':'Отправка не выполнялась'}
+    config=form['enrichment']
+    request=json.loads(raw_request)
+    try:
+        authorize()
+    except Exception:
