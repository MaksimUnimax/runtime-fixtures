+    def test_insufficient_balance_and_own_only(self):
+        self.db.execute('DELETE FROM coin_grants')
+        rid='e'*32
+        form,data=self.study(rid,['123001'])
+        blocked=enrichment.reserve(self.db,self.scope,rid,form,data,self.authorize,[{'sku':'123001'}])
+        self.assertEqual(set(blocked),{enrichment.DS,enrichment.BH})
+        self.assertEqual(enrichment.public_receipts(self.db,rid),{})
+        rid='f'*32
+        form,data=self.study(rid,['123001'],['123001'])
+        self.assertEqual(enrichment.reserve(self.db,self.scope,rid,form,data,self.authorize,[]),{})
+        self.assertEqual(enrichment.public_receipts(self.db,rid),{})
+
+    def test_one_bhapi_attempt_for_each_final_group_size(self):
+        for count in (0,1,3,5,10):
+            with self.subTest(count=count):
+                rid=f'{count+123:032x}'
+                targets=[str(200001+i) for i in range(count)]
+                self.db.execute('DELETE FROM coin_grants')
+                coins.grant(self.db,'test',rid,self.scope.workspace_id,'50','Test funds')
+                form,data=self.study(rid,targets)
+                enrichment.reserve(self.db,self.scope,rid,form,data,self.authorize,[])
+                with patch.object(bhapi,'send',return_value=(200,{'status':'success','data':{'items':[]}},None)) as send:
+                    if targets:
+                        self.assertEqual(self.run_stage(rid,enrichment.BH,form,targets)['state'],'partial')
+                        self.run_stage(rid,enrichment.BH,form,targets)
+                        send.assert_called_once()
+                        self.assertEqual(send.call_args.args[1]['product_ids'],targets)
+                    else:
+                        self.assertEqual(enrichment.public_receipts(self.db,rid),{})
+                        send.assert_not_called()
+
+    def test_known_errors_and_manual_settlement_of_unknown(self):
+        for status in (301,400,401,402,403,429,503):
+            with self.subTest(status=status):
+                rid=f'{status:032x}'
+                self.db.execute('DELETE FROM coin_grants')
+                coins.grant(self.db,'test',rid,self.scope.workspace_id,'50','Test funds')
+                form,data=self.study(rid,['123001'])
+                enrichment.reserve(self.db,self.scope,rid,form,data,self.authorize,[])
+                with patch.object(bhapi,'send',return_value=(status,None,'qa-error-id')) as send:
+                    result=self.run_stage(rid,enrichment.BH,form,data['targets'])
+                    self.run_stage(rid,enrichment.BH,form,data['targets'])
+                    send.assert_called_once()
+                receipt=enrichment.public_receipts(self.db,rid)['bhapi']
+                self.assertEqual(receipt['providerId'],'qa-error-id' if status not in (301,503) else None)
+                if status in (301,503):
+                    self.assertEqual(result['state'],'unknown')
+                    self.assertIsNone(receipt['chargedRub'])
+                    with service.transaction(self.db):
+                        first=enrichment.reconcile_bhapi(self.db,receipt['operationId'],True,'fixture-provider-id')
+                        self.assertEqual(first['chargedRub'],'2.79')
+                        replay=enrichment.reconcile_bhapi(self.db,receipt['operationId'],True,'fixture-provider-id')
+                        self.assertEqual(replay,first)
+                        with self.assertRaises(ValueError):
+                            enrichment.reconcile_bhapi(self.db,receipt['operationId'],False,'fixture-other-id')
+                else:
+                    self.assertEqual(receipt['chargedRub'],'0')
+
+    def test_reference_mode_excludes_only_authorized_own_cards_from_bhapi(self):
+        self.db.executescript("""
+            CREATE TABLE account_integrations(id TEXT,workspace TEXT,provider TEXT,status TEXT);
+            CREATE TABLE user_plugin_products(cid TEXT,plugin TEXT,sku TEXT);
+        """)
+        ws=self.scope.workspace_id
+        for ident,workspace,chat,sku in [('own',ws,self.scope.chat_id,'200001'),
+                                          ('elsewhere','other',self.scope.chat_id,'200002'),
+                                          ('no-chat',ws,'another-chat','200003')]:
+            self.db.execute("INSERT INTO account_integrations VALUES (?,?,'ozon','verified')",(ident,workspace))
+            self.db.execute("INSERT INTO chat_integrations VALUES (?,?)",(ident,chat))
+            self.db.execute("INSERT INTO user_plugin_products VALUES (?,'ozon',?)",(ident,sku))
+        with patch.object(service,'allowed',return_value=True):
+            external=service.commercial_targets(self.db,self.scope,{'mode':'B','own':[]},
+                                                ['200001','200002','200003'])
+        self.assertEqual(external,['200002','200003'])
+
+    def test_concurrent_workers_claim_only_one_request(self):
+        rid='9'*32
+        form,data=self.study(rid,['123001'])
+        enrichment.reserve(self.db,self.scope,rid,form,data,self.authorize,[])
+        counted=Event()
+        complete=Event()
+        def provider_call(*_):
+            counted.set()
+            self.assertTrue(complete.wait(5))
+            return 200,{'status':'success','data':{'items':[{'product_id':'123001','sales_units':1}]}},'qa-success'
+        def worker():
+            with sqlite3.connect(self.path,isolation_level=None) as db:
+                return enrichment.run(db,self.path,self.scope,rid,enrichment.BH,form,[],None,None,self.authorize,{})
+        with patch.object(bhapi,'send',side_effect=provider_call) as send,ThreadPoolExecutor(2) as pool:
+            first=pool.submit(worker)
+            self.assertTrue(counted.wait(5))
+            try:
+                second=pool.submit(worker)
+                self.assertEqual(second.result(timeout=5)['state'],'unknown')
+            finally:
+                complete.set()
+            self.assertEqual(first.result(timeout=5)['state'],'complete')
+            send.assert_called_once()
+        self.assertEqual(enrichment.public_receipts(self.db,rid)['bhapi']['chargedRub'],'2.79')
