+def discovery_seeds(card):
+    """Use the complete product label and anchored variants for discovery only."""
+    title=' '.join((card.get('title') or '').split())
+    fields=card.get('characteristics',{})
+    kind=card.get('type') or next(iter(fields.get('Тип',[])), '')
+    designations=[]
+    for name,values in fields.items():
+        if re.search(r'модел|маркиров|совместим|символ|серия|версия|назначен|размер|диаметр|ёмкост|объем|мощност|model|compatib',name,re.I):
+            designations.extend(v for v in values if 1<=len(v.split())<=9 and len(v)<=80)
+    # Keep a cohesive designation after a title separator before generic
+    # introductory wording. Do not remove a model, number, or a negation.
+    quoted=re.findall(r'[«"“]([^»"”]{2,80})[»"”]',title)
+    without_quotes=re.sub(r'[«"“][^»"”]*[»"”]',' ',title)
+    clauses=re.split(r'\s+[–—-]\s+|[,;]|(?<=[а-яa-z])\.\s+',without_quotes,flags=re.I)
+    specific=max((x.strip() for x in clauses if x.strip()),key=lambda x:len(x.split()),default='')
+    label=' '.join(specific.split()).strip(' .,!?:—-').casefold()
+    full=' '.join(re.sub(r'[«»"“”/:;,]+',' ', title).split()).casefold()
+    base=label if len(label.split())>=2 else full
+    if quoted and base and normalized(quoted[0]) not in normalized(base):
+        base+=' '+quoted[0].casefold()
+    if not base or len(base.split())<2:
+        base=' '.join(x for x in (kind,base) if x)
+    if not base:
+        base=(card.get('breadcrumbs') or [''])[-1]
+    variants=[base.strip(' .,!?:—-')]
+    for v in designations:
+        if normalized(v) not in normalized(base):
+            variants.append(base+' '+v.casefold())
+            break
+    if full and len(full.split())>=2:
+        variants.append(full.strip(' .,!?:—-'))
+    return list(dict.fromkeys(q for q in variants if 2<=len(q)<=180))[:3]
