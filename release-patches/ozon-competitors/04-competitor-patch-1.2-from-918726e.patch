+def plan(targets, today=None):
+    month=(today or datetime.now(timezone.utc).date()).replace(day=1)
+    end=month-timedelta(days=1)
+    return ({'product_ids':sorted(set(targets),key=int),'page':1,'page_size':20,'search_date':str(month),
+             'orders':[{'field':'sales_revenue','direction':'desc'}]},
+            {'start':str(end.replace(day=1)),'end':str(end)})
+
+
+def safe_value(value, depth=0):
+    if depth>6:
+        return None
+    if type(value) in (bool,int) or value is None:
+        return value
+    if isinstance(value,float):
+        return value if abs(value)<1e18 else None
+    if isinstance(value,str):
+        return value[:2000] if not re.search(r'https?://|[?&](?:key|token|sig)=|\bBearer\s+',value,re.I) else None
+    if isinstance(value,list):
+        return [safe_value(v,depth+1) for v in value[:50]]
+    if isinstance(value,dict):
+        return {k:safe_value(v,depth+1) for k,v in list(value.items())[:200]
+                if re.fullmatch(r'[\w -]{1,80}',k) and not re.search(r'token|secret|password|authorization|api.?key',k,re.I)}
+    return None
+
+
+def numeric(value):
+    if type(value) not in (int,float,str) or len(str(value))>40:
+        return None
+    try:
+        n=Decimal(str(value))
+    except InvalidOperation:
+        return None
+    return n if n.is_finite() and abs(n)<Decimal('1e18') else None
+
+
+def normalize(obj, request, requested_period):
+    if not isinstance(obj,dict) or obj.get('status')!='success' or not isinstance(obj.get('data'),dict):
+        raise ValueError('Некорректная оболочка ответа BHAPI')
+    received=obj['data'].get('items')
+    if not isinstance(received,list) or len(received)>20:
+        raise ValueError('Некорректный список товаров BHAPI')
+    expected=request['product_ids']
+    rows={}
+    duplicate=set()
+    errors=[]
+    for item in received:
+        sku=str(item.get('product_id','')) if isinstance(item,dict) else ''
+        if sku not in expected:
+            errors.append('Ответ содержит незапрошенный SKU')
+            continue
+        if sku in rows or sku in duplicate:
+            duplicate.add(sku)
+            rows.pop(sku,None)
+            errors.append('Повтор SKU '+sku)
+            continue
+        data=safe_value(item)
+        category=data.get('category_info')
+        if not data.get('category_path') and isinstance(category,dict):
+            data['category_path']=category.get('title_path')
+        notes=dict(DISPUTED)
+        for key in ('cart_conversion_percent','order_conversion_percent'):
+            value=numeric(data.get(key))
+            if value is not None and not 0<=value<=100:
+                notes[key]='Значение за пределами 0–100%. Методика не подтверждена'
+        metrics={k:data.get(k) if k in TEXT_FIELDS or numeric(data.get(k)) is not None else None for k in FIELDS}
+        rows[sku]={'sku':sku,'metrics':metrics,'providerFields':data,
+                   'notes':{k:note for k,note in notes.items() if data.get(k) is not None}}
+    meta=obj.get('meta')
+    meta=safe_value(meta) if isinstance(meta,dict) else {}
+    missing=[sku for sku in expected if sku not in rows]
+    provider_warnings=meta.get('warnings',[])
+    if not isinstance(provider_warnings,list):
+        provider_warnings=[]
+    return {'source':'BHAPI','state':'partial' if missing or errors else 'complete',
+            'requestedPeriod':requested_period,'resolvedPeriod':meta.get('resolved_period'),
+            'meta':meta,'received':len(rows),'requested':len(expected),'missing':missing,
+            'warnings':errors+[v for v in provider_warnings if isinstance(v,str)],'rows':[rows[sku] for sku in expected if sku in rows]}
+
+
+def send(key, request):
+    # No redirects, proxy environment, connect retries or pagination.
+    with httpx.Client(transport=httpx.HTTPTransport(retries=0),trust_env=False,follow_redirects=False,
+                      timeout=httpx.Timeout(35,connect=8)) as http:
+        with http.stream('POST',URL,json=request,headers={'X-API-Token':key}) as response:
+            if response.status_code!=200:
+                return response.status_code,None,response.headers.get('x-request-id')
+            raw=bytearray()
+            for chunk in response.iter_bytes():
+                raw.extend(chunk)
+                if len(raw)>MAX_RESPONSE:
+                    raise ValueError('Ответ BHAPI превысил лимит')
+            return response.status_code,json.loads(raw,parse_constant=lambda _:None),response.headers.get('x-request-id')
