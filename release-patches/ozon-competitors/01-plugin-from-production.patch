+"""Read-only analytics of products owned by the selected Ozon seller."""
+import csv
+import io
+import json
+import time
+from datetime import datetime, timedelta, timezone
+from uuid import UUID
+
+import httpx
+from .contracts import number,text,external_error
+
+
+class OzonError(ValueError):
+    pass
+
+
+def periods(now=None):
+    end=(now or datetime.now(timezone.utc)).date()-timedelta(days=1)
+    return {'date_from':str(end-timedelta(days=28))+'T00:00:00Z','date_to':str(end)+'T00:00:00Z'}, {
+        'dateFrom':str(end-timedelta(days=6)), 'dateTo':str(end)}
+
+
+def performance_csv(payload, skus=None):
+    if len(payload)>24*1024*1024:
+        raise OzonError('Превышен размер CSV Performance')
+    src=io.StringIO(payload.decode('utf-8-sig'),newline='')
+    src.readline()
+    reader=csv.DictReader(src,delimiter=';')
+    expected={'SKU','Поисковый запрос','Показы','Клики'}
+    if not expected.issubset(reader.fieldnames or []):
+        raise OzonError('Неизвестный заголовок CSV Performance')
+    rows=[]
+    invalid=[]
+    for index,row in enumerate(reader,3):
+        sku=text(row.get('SKU'),20)
+        if sku and sku.isdecimal() and skus is not None and sku not in skus:
+            continue
+        phrase=text(row.get('Поисковый запрос'),500)
+        raw=[(row.get(k) or '').replace(' ','') for k in ('Показы','Клики')]
+        if not sku or not sku.isascii() or not sku.isdecimal() or not phrase or not all(v.isascii() and v.isdecimal() and len(v)<=15 for v in raw):
+            invalid.append(index)
+            continue
+        impressions,clicks=map(int,raw)
+        rows.append(dict(sku=sku,phrase=phrase,kind='catalog' if phrase.casefold().endswith('(каталог)') else 'search',
+                         impressions=impressions,clicks=clicks))
+    totals=ad_totals(rows)
+    if invalid and not rows:
+        for v in totals.values():
+            v.update(impressions=None,clicks=None)
+    return dict(rows=rows,totals=totals,invalidRows=invalid)
+
+
+
+def ad_totals(rows):
+    totals={}
+    for kind in ('all','search','catalog'):
+        group=[r for r in rows if kind=='all' or r['kind']==kind]
+        imp=sum(r['impressions'] for r in group)
+        clicks=sum(r['clicks'] for r in group)
+        totals[kind]=dict(rows=len(group),phrases=len({r['phrase'] for r in group}),impressions=imp,clicks=clicks,ctr=100*clicks/imp if imp else None)
+    return totals
+
+
+class Own:
+    def __init__(self,fields,guard):
+        self.fields=fields
+        self.guard=guard
+        self.bearer=None
+        self.skipped=[]
+
+    def request(self,method,path,**kwargs):
+        try:
+            return self._request(method,path,**kwargs)
+        except (httpx.TransportError,UnicodeError,json.JSONDecodeError) as exc:
+            raise OzonError('Ozon '+type(exc).__name__) from None
+
+    def _request(self,method,path,*,performance=False,params=None,body=None,csv_report=False):
+        self.guard('advertising' if performance else 'catalog')
+        if performance:
+            origin='https://api-performance.ozon.ru'
+            if path=='/api/client/token':
+                headers={}
+            else:
+                if not self.bearer:
+                    auth=self.request('POST','/api/client/token',performance=True,body={
+                        'client_id':self.fields['performance_id'],'client_secret':self.fields['performance_secret'],'grant_type':'client_credentials'})
+                    self.bearer=auth['access_token']
+                headers={'Authorization':'Bearer '+self.bearer}
+        else:
+            origin='https://api-seller.ozon.ru'
+            headers={'Client-Id':self.fields['client_id'],'Api-Key':self.fields['api_key']}
+        for attempt in range(3):
+            self.guard('advertising' if performance else 'catalog')
+            with httpx.stream(method,origin+path,headers=headers,params=params,json=body,timeout=40,follow_redirects=False) as res:
+                delay=res.headers.get('retry-after','5')
+                if res.status_code==429 and attempt<2 and delay.isdecimal() and int(delay)<=45:
+                    wait=max(1,int(delay))
+                else:
+                    result=bytearray()
+                    for chunk in res.iter_bytes():
+                        result.extend(chunk)
+                        if len(result)>24*1024*1024:
+                            raise OzonError('Превышен размер ответа Ozon')
+                    if res.status_code!=200:
+                        try:
+                            obj=json.loads(result)
+                            detail=str(obj.get('message') or obj.get('error') or '')[:200]
+                        except (ValueError,AttributeError):
+                            detail=''
+                        raise OzonError(f'{path} HTTP {res.status_code} {external_error(detail)}')
+                    return bytes(result) if csv_report else json.loads(result)
+            time.sleep(wait)
+
+    def seller(self,skus,period,*,cache=None):
+        """Read both free orderings once per authorized store, UTC period and SKU."""
+        self.guard('catalog')
+        skus=list(dict.fromkeys(skus))
+        per_sku={}
+        keys=('BY_SEARCHES','BY_GMV')
+        errors=[]
+        def save(sku):
+            if cache:
+                self.guard('catalog')
+                db.execute("INSERT OR REPLACE INTO competitor_seller_cache VALUES(?,?,?,?,?,?)",
+                    (cid,version,period['date_from'],period['date_to'],sku,json.dumps(per_sku[sku],ensure_ascii=False,allow_nan=False)))
+        for sku in skus:
+            item={'summary':{},'queries':{},'parts':[]}
+            if cache:
+                db,cid,version=cache
+                stored=db.execute("SELECT payload FROM competitor_seller_cache WHERE cid=? AND version=? AND since=? AND until=? AND sku=?",
+                                   (cid,version,period['date_from'],period['date_to'],sku)).fetchone()
+                if stored:
+                    item=json.loads(stored[0])
+                    # Earlier releases wrote a cache entry only after all four calls succeeded.
+                    item.setdefault('parts',[k+suffix for k in keys for suffix in ('/details','/summary')])
+            per_sku[sku]=item
+        cached=sum(len(v['parts'])==4 for v in per_sku.values())
+        metrics=('unique_search_users','gmv','order_count','position','unique_view_users','view_conversion','query_index')
+        for sort in keys:
+            for detail,size in ((False,1000),(True,6)):
+                part=sort+('/details' if detail else '/summary')
+                missing=[sku for sku in skus if part not in per_sku[sku]['parts']]
+                for start in range(0,len(missing),size):
+                    batch=missing[start:start+size]
+                    body={**period,'skus':batch,'sort_by':sort,'sort_dir':'DESCENDING','page_size':100 if detail else 1000}
+                    path='/v1/analytics/product-queries'
+                    if detail:
+                        path+='/details'
+                        body['limit_by_sku']=15
+                    try:
+                        res=self.request('POST',path,body=body)
+                        rows=res.get('queries' if detail else 'items') if isinstance(res,dict) else None
+                        if not isinstance(rows,list) or res.get('page_count',1) not in (0,1) or res.get('total',len(rows))!=len(rows):
+                            raise OzonError('Неполный ответ Seller')
+                    except (OzonError,httpx.TransportError) as exc:
+                        errors.append(dict(part=part,skus=batch,error=str(exc) if isinstance(exc,OzonError) else type(exc).__name__))
+                        continue
+                    seen=set()
+                    invalid=set()
+                    counts={}
+                    for i,row in enumerate(rows):
+                        sku=str(row.get('sku')) if isinstance(row,dict) else ''
+                        key=text(row.get('query'),500) if detail and isinstance(row,dict) else ''
+                        counts[sku]=counts.get(sku,0)+1
+                        if sku not in batch or (detail and counts[sku]>15) or (detail and not key) or (sku,key) in seen or any(
+                                row.get(m) is not None and number(row[m]) is None for m in metrics):
+                            invalid.update([sku] if sku in batch else batch)
+                            errors.append(dict(part=part,row=i+1,error='Некорректная или повторная строка Seller'))
+                            continue
+                        seen.add((sku,key))
+                        item=per_sku[sku]
+                        safe={m:row[m] for m in ('sku','query','currency',*metrics) if m in row}
+                        if detail:
+                            fact=item['queries'].get(key)
+                            if fact and any(fact.get(m)!=safe.get(m) for m in ('currency',*metrics[:-1])):
+                                errors.append(dict(part=part,sku=sku,error='Расхождение показателей между срезами Seller'))
+                                fact['conflict']=True
+                                invalid.add(sku)
+                                continue
+                            if not fact:
+                                fact=item['queries'][key]={**safe,'sorts':[],'rankBySort':{}}
+                            if sort not in fact['sorts']:
+                                fact['sorts'].append(sort)
+                            fact['rankBySort'][sort]=safe.get('query_index')
+                        else:
+                            item['summary'][sort]=safe
+                    for sku in batch:
+                        if sku not in invalid:
+                            per_sku[sku]['parts'].append(part)
+                        save(sku)
+        self.guard('catalog')
+        if cache:
+            db.execute("DELETE FROM competitor_seller_cache WHERE cid=? AND (version<>? OR until<?)",(cid,version,period['date_to']))
+        summaries=[v['summary']['BY_SEARCHES'] for v in per_sku.values() if 'BY_SEARCHES' in v['summary']]
+        result=dict(errors=errors,period=period,limitBySku=15,sorts=['BY_SEARCHES','BY_GMV'],cachedSkus=cached,
+                    summary=summaries,summaryBySort={s:[v['summary'][s] for v in per_sku.values() if s in v['summary']] for s in ('BY_SEARCHES','BY_GMV')},
+                    queries=[q for v in per_sku.values() for q in v['queries'].values() if not q.get('conflict')],
+                    missingSummary=[k for k,v in per_sku.items() if len(v['summary'])!=2],
+                    withoutQueries=[k for k,v in per_sku.items() if not v['queries']])
+
+        # Preserve the existing caller contract for mutually contradictory
+        # reports while allowing the research to retain the independent facts.
+        conflicts=[v for v in errors if v['error'].startswith('Расхождение')]
+        if conflicts:
+            exc=OzonError(conflicts[0]['error'])
+            exc.partial=result
+            raise exc
+        return result
+
+    def campaigns(self,skus,period=None):
+        result=[]
+        campaigns=self.request('GET','/api/client/campaign',performance=True).get('list',[])
+        for c in campaigns:
+            if c.get('PaymentType',c.get('paymentType'))!='CPC' or 'PLACEMENT_TOP_PROMOTION' not in (c.get('placement') or []):
+                continue
+            if period and (c.get('fromDate','')>period['dateTo'] or (c.get('toDate') and c['toDate']<period['dateFrom']) or (c.get('state')=='CAMPAIGN_STATE_INACTIVE' and (c.get('updatedAt') or '9999')[:10]<period['dateFrom'])):
+                continue
+            if 'ARCHIV' in str(c.get('state','')).upper():
+                continue
+            cid=str(c['id'])
+            if not cid.isdecimal():
+                continue
+            page=1
+            while True:
+                try:
+                    obj=self.request('GET',f'/api/client/campaign/{cid}/v2/products',performance=True,params={'page':page,'pageSize':100})
+                except OzonError as exc:
+                    if 'HTTP 400' in str(exc) and 'архив' in str(exc).casefold():
+                        self.skipped.append({'campaign':cid,'reason':str(exc)})
+                        break
+                    raise
+                products=obj.get('products',obj.get('list',[]))
+                if any(str(p.get('sku')) in skus for p in products):
+                    result.append(cid)
+                    break
+                if len(products)<100 or page*100>=int(obj.get('total',page*100+1)):
+                    break
+                page+=1
+                if page>1000:
+                    raise OzonError('Превышен предел страниц кампании')
+        return sorted(set(result))
+
+    def order_phrases(self,campaigns,period):
+        res=self.request('POST','/api/client/statistics/phrases',performance=True,body={
+            'campaigns':campaigns,**period,'groupBy':'NO_GROUP_BY'})
+        return str(UUID(res['UUID']))
+
+    def phrases(self,uid,skus):
+        uid=str(UUID(uid))
+        status=self.request('GET','/api/client/statistics/'+uid,performance=True)
+        if status.get('state')!='OK':
+            return status.get('state'),None
+        data=self.request('GET','/api/client/statistics/report',performance=True,params={'UUID':uid},csv_report=True)
+        return 'OK',performance_csv(data,skus)
+
