diff --git a/products/harness-platform/platform_core/competitors/analysis.py b/products/harness-platform/platform_core/competitors/analysis.py
new file mode 100644
index 0000000..855dad4
--- /dev/null
+++ b/products/harness-platform/platform_core/competitors/analysis.py
@@ -0,0 +1,449 @@
+"""Deterministic research, keeping original labels and observed positions."""
+import json
+import re
+import statistics
+from collections import defaultdict
+from datetime import datetime,timezone
+from urllib.parse import urlsplit
+
+from .contracts import number, text
+from .parser import exact, unique, match_rows
+
+
+def characteristics(value):
+    if isinstance(value,str):
+        try:
+            value=json.loads(value)
+        except ValueError:
+            return {'Текст': [value[:12000]]} if value.strip() else {}
+    fields=defaultdict(list)
+    def visit(node):
+        if isinstance(node,list):
+            for child in node:
+                visit(child)
+        elif isinstance(node,dict):
+            if text(node.get('name')) and isinstance(node.get('values'),list):
+                fields[text(node['name'])].extend(text(v['text'],2000) for v in node['values'] if isinstance(v,dict) and text(v.get('text')))
+            else:
+                for k in ('characteristics','short','long','full','groups','items'):
+                    visit(node.get(k))
+    visit(value)
+    return {k:unique(v) for k,v in fields.items() if v}
+
+
+def photo_url(url):
+    if not isinstance(url,str) or len(url)>2048:
+        return False
+    try:
+        p=urlsplit(url)
+    except ValueError:
+        return False
+    return p.scheme=='https' and bool(re.fullmatch(r'(?:ir|cdn[0-9]*)\.ozone\.ru',p.netloc.lower())) and p.path.startswith('/')
+
+
+def category_path(breadcrumbs):
+    result=[]
+    for item in breadcrumbs or []:
+        if not isinstance(item,dict) or not text(item.get('name')):
+            continue
+        link=urlsplit(str(item.get('link') or ''))
+        if link.scheme!='https' or link.netloc.lower() not in ('www.ozon.ru','ozon.ru'):
+            continue
+        if re.fullmatch(r'/category/[\w-]+-[0-9]+/?',link.path):
+            result.append({'name':text(item['name']),'url':link._replace(query='',fragment='').geturl()})
+    return result
+
+
+def shop_url(value):
+    if isinstance(value,str):
+        try:
+            u=urlsplit(value)
+            if u.scheme=='https' and u.netloc.lower() in ('ozon.ru','www.ozon.ru') and u.path.startswith('/seller/'):
+                return u._replace(fragment='',query='').geturl()
+        except ValueError:
+            pass
+    return None
+
+
+def review_rows(comments):
+    if not isinstance(comments,list):
+        return {'error':'MISSING_REVIEWS'}
+    rows=[]
+    invalid=0
+    for c in comments:
+        if not isinstance(c,dict) or not any(text(c.get(k)) for k in ('Comment','Pro','Contra','Title','Published')):
+            invalid+=1
+            continue
+        row={k:text(c.get(k),12000) for k in ('Published','Comment','Pro','Contra','Title')}
+        rating=number(c.get('Rating'),0,5,integer=True)
+        # The supplier uses numeric zero for an unpublished individual rating.
+        row['Rating']=rating or None
+        if c.get('Rating') is not None and rating is None:
+            invalid+=1
+        rows.append(row)
+    return {'reviews':rows,'invalidRows':invalid}
+
+
+def card(offer):
+    attrs=characteristics(offer.get('CharacteristicsObject') or offer.get('Characteristics'))
+    for field in ('Breadcrumbs', 'Offer_pics'):
+        if offer.get(field) is not None and not isinstance(offer[field], list):
+            raise ValueError('INVALID_FIELD: '+field)
+    for field in ('Name', 'Seo_description'):
+        if offer.get(field) is not None and not isinstance(offer[field], str):
+            raise ValueError('INVALID_FIELD: '+field)
+    path=category_path(offer.get('Breadcrumbs'))
+    crumbs=[b['name'] for b in path]
+    result={'sku':exact(offer),'title':text(offer.get('Name'),2000),'description':text(offer.get('Seo_description'),80000),
+            'characteristics':attrs,'breadcrumbs':crumbs,'publicCategories':path,'type':next(iter(attrs.get('Тип',[])),None),
+            'photos':unique([u for u in offer.get('Offer_pics') or [] if photo_url(u)]),
+            'url':f"https://www.ozon.ru/product/{exact(offer)}/",'sellerRating':number(offer.get('ShopRating'),0,5) or None,
+            'brand':text(offer.get('Brand_found')),'questions':number(offer.get('SkuQuestions'),integer=True),
+            'seller':text(offer.get('ShopName')),'sellerId':text(offer.get('ShopId')) or number(offer.get('ShopId'),integer=True),'sellerUrl':shop_url(offer.get('ShopUrl')),
+            'rating':number(offer.get('SkuRating'),0,5) or None,'ratingCount':number(offer.get('SkuRates'),integer=True),
+            'delivery':text(offer.get('DeliveryTerm')) or number(offer.get('DeliveryTerm')),'available':offer.get('Ozon_available') if type(offer.get('Ozon_available')) is bool else None,
+            'stock':number(offer.get('Ozon_stockcount'),integer=True),'source':'parser.market'}
+    for k in ('Price','PromoPrice','OldPrice','Ozon_sellerprice','OZON_couponPrice'):
+        value=offer.get(k)
+        result[k]=number(value) or None
+    return result
+
+
+def parse_batch(kind,rows,report):
+    data={}
+    for row,error,item in match_rows(rows,report):
+        key=row['name']
+        offers=item['offers'] if item else []
+        if kind=='search':
+            results=[{'sku':exact(o),'title':text(o.get('Name'),2000),'index':i} for i,o in enumerate(offers,1) if isinstance(o,dict)]
+            depth=int(row['donotsearch'])
+            invalid=len(results)!=len(offers) or any(not h['sku'] for h in results) or len({h['sku'] for h in results})!=len(results)
+            state='ERROR' if error else 'INCOMPLETE' if len(results)<depth or invalid else 'OK'
+            data[key]=dict(state=state,error=error,hits=results,actual=len(offers),depth=depth)
+        else:
+            matches=[o for o in offers if isinstance(o,dict) and exact(o)==key]
+            if not error and len(matches)!=1:
+                error='SKU_MISMATCH' if not matches else 'DUPLICATE_SKU'
+            if error:
+                data[key]={'error':error}
+            elif kind=='cards':
+                try:
+                    data[key]=card(matches[0])
+                except (ValueError, TypeError, KeyError, RecursionError) as exc:
+                    data[key]={'error':str(exc)[:160] if isinstance(exc,ValueError) else 'INVALID_CARD_FIELDS'}
+            else:
+                comments=matches[0].get('Offer_userComments')
+                data[key]=review_rows(comments)
+        data[key].update(order=report['id'],code=row['code'],region=text(report.get('regioncode')) or number(report.get('regioncode'),integer=True),
+                         collected=text(report.get('received')) or number(report.get('received')),sort='normal' if kind=='search' else None)
+    return data
+
+
+def observed(skuses,phrases,search):
+    matrix={}
+    for sku in skuses:
+        found={}
+        for phrase in phrases:
+            row=search.get(phrase,{})
+            idx=next((hit['index'] for hit in row.get('hits',[]) if hit['sku']==sku),None)
+            state='FOUND' if idx else {'OK':'NOT_FOUND_IN_SAMPLE'}.get(row.get('state'), row.get('state','UNCHECKED'))
+            found[phrase]=dict(status=state,coverage=row.get('state','UNCHECKED'),response_index=idx,actual_count=row.get('actual'),requested_depth=row.get('depth'),order=row.get('order'),code=row.get('code'),region=row.get('region'),collected=row.get('collected'),sort=row.get('sort'))
+        matrix[sku]={'phrases':found,'top':{str(n):[p for p,r in found.items() if r['response_index'] and r['response_index']<=n] for n in (3,5,10,32)}}
+    return matrix
+
+
+def normalized(text):
+    return ' '.join(str(text).casefold().replace('ё','е').split())
+
+
+def candidates(cards,reviews,extra=()):
+    phrases=defaultdict(list)
+    def add(txt,source):
+        if isinstance(txt,str):
+            txt=' '.join(txt.split()).strip(' ,.!?;—-')
+            if 2<=len(txt)<=180 and not txt.casefold().endswith('(каталог)') and source not in phrases[txt]:
+                phrases[txt].append(source)
+    for sku,c in cards.items():
+        title=c.get('title') or ''
+        kind_words=re.findall(r'[А-Яа-яЁёA-Za-z][\w-]*',str(c.get('type') or ''))
+        for segment in re.split(r'[,/|«»"]|\s+[–—-]\s+',title):
+            words=re.findall(r'[А-Яа-яЁёA-Za-z][\w-]*',segment)
+            if 2<=len(words)<=12:
+                add(' '.join(words[:6]),[sku,'title'])
+                if kind_words and words[0].casefold() in ('от','на','в','для','с','из'):
+                    add(' '.join([*kind_words[:2],*words[:6]]),[sku,'title'])
+        for field,values in [('title',[c.get('title')]),('category',c.get('breadcrumbs',[])[-1:]),
+                ('description',[c.get('description')]),('characteristics',sum([v for k,v in c.get('characteristics',{}).items() if k!='Артикул'],[])),
+                ('reviews',[r.get('Comment') for r in reviews.get(sku,{}).get('reviews',[])])]:
+            for text in values:
+                if not isinstance(text,str):
+                    continue
+                for part in re.split(r'[.!?;,:/\n]+',text):
+                    words=re.findall(r'[А-Яа-яЁёA-Za-z][\w-]*',part)
+                    if words:
+                        add(' '.join(words[:6]),[sku,field])
+    for txt,label in extra:
+        # Keep exact provider query text, even punctuation that is meaningful in a report.
+        if isinstance(label,list) and label[0] in ('Seller','Performance'):
+            if isinstance(txt,str) and 1<=len(txt)<=180 and txt.strip() and not txt.casefold().endswith('(каталог)') and label not in phrases[txt]:
+                phrases[txt].append(label)
+        else:
+            add(txt,label)
+    return dict(phrases)
+
+
+# Functional relations can be expressed through the structured attributes or
+# the same linguistic relations in a title or a statement about intended use.
+# Context alone (a room, a vehicle, a possible gift) does not prove a function.
+FUNCTION_FIELDS={'назначение','основное назначение','область применения','способ установки',
+                 'способ крепления','место установки','тип крепления','вид применения'}
+BROAD_TYPE=re.compile(r'амулет|оберег|аксессуар|сувенир|универсальн|принадлежност|прочее|набор товаров|декоративн|украшение')
+FUNCTION_WORDS={'браслет':'запястье','булавк':'одежду','брошь':'одежду','кулон':'шею',
+                'ожерелье':'шею','обеденн':'приём пищи','письменн':'письмо','брелок':'ключей'}
+RELATION=re.compile(r'\b(для|на|под)\s+([а-яa-z-]+(?:\s+(?!(?:для|на|под|в|с|и|или)\b)[а-яa-z-]+){0,2})')
+DECLARED=re.compile(r'предназнач|применя|использу|крепи|закреп|подвеш|повесить|ставится|устанавлива|монтиру|носится')
+NEGATION=re.compile(r'\b(?:не|нельзя|запрещено|невозможно)\b')
+AUDIENCE=re.compile(r'мужчин|женщин|детей|ребенк|подар|взросл|повседнев|универсал|скидк')
+def uses_in(value):
+    uses=set()
+    for marker,meaning in FUNCTION_WORDS.items():
+        if re.search(r'\b'+marker,value):
+            uses.add(meaning)
+    for rel,members in RELATION.findall(value):
+        words=members.split()
+        if rel=='под' and words[0]=='заказ' or AUDIENCE.search(members):
+            continue
+        # Discard trailing prepositions and qualifiers after the governing noun.
+        obj=next((w for w in words if w not in ('в','и','на','с','или') and not w.endswith(('ную','нюю','ую','ое','ее','ной'))),words[0])
+        if obj.startswith('запясть'): obj='запястье'
+        if 'одежд' in members: obj='одежду'
+        uses.add(obj)
+    return uses
+
+def purpose_facts(card):
+    return [(key,v) for key,values in card.get('characteristics',{}).items()
+            if normalized(key) in FUNCTION_FIELDS or normalized(key).startswith(('назначение ','основное назначение '))
+            for v in values if isinstance(v,str) and v.strip() and not AUDIENCE.search(normalized(v))]
+
+def object_key(word):
+    # Match grammatical case on the governing object of a functional relation.
+    # Keep its original spelling for the UI and the audit trail.
+    return re.sub(r'(?:ами|ями|ах|ях|ам|ям|ом|ем|ой|ей|[аоеуыюяи])$','',word) if len(word)>4 and ' ' not in word else word
+
+def confirmed_title_uses(parts, description):
+    """Use a later product designation when the description independently identifies it."""
+    subject=re.match(r'[а-яa-z][а-яa-z-]+', normalized(description))
+    if not subject:
+        return set()
+    named=[normalized(part) for part in parts if re.match(re.escape(subject[0])+r'\b',normalized(part))]
+    if not named:
+        return set()
+    corroborated=set()
+    denied=set()
+    for part in parts:
+        clause=normalized(part)
+        negative=NEGATION.search(clause)
+        if negative:
+            denied.update(uses_in(clause[negative.end():]))
+    for clause in re.split(r'[.!?;,]|\bно\b', normalized(description)):
+        # A negation after the target (e.g. «на полку, не только ...») does
+        # not negate the relation. A negative use claim before it remains a veto.
+        first_negative=NEGATION.search(clause)
+        if first_negative:
+            corroborated.update(uses_in(clause[:first_negative.start()]))
+            denied.update(uses_in(clause[first_negative.end():]))
+        else:
+            corroborated.update(uses_in(clause))
+    confirmed=set()
+    for clause in named:
+        if (NEGATION.search(clause)
+                or re.search(r'\b(?:в комплекте|в подарок|приобретается отдельно)\b',clause)):
+            continue
+        declared=uses_in(clause)
+        if declared and declared <= corroborated and declared.isdisjoint(denied):
+            confirmed.update(declared)
+    return confirmed
+
+
+def purpose(card):
+    # Merchandising suffixes often describe an accessory, inscription or material.
+    # Read the head of the title and let actual use statements corroborate it.
+    parts=re.split(r'[/|;,.]',card.get('title') or '')
+    title=normalized(parts[0])
+    positive=set()
+    negative=set()
+    def add(value,structured=False):
+        for clause in re.split(r'[.!?;,]|\bно\b',value.casefold()):
+            stmt=normalized(clause)
+            found=uses_in(stmt)
+            if structured and not found and stmt and not AUDIENCE.search(stmt):
+                found={stmt}
+            (negative if NEGATION.search(stmt) else positive).update(found)
+    # A suffix describing an accessory or connector cannot disprove the primary
+    # function explicitly supplied by Ozon. Keep direct contradictory primary
+    # statements (including explicit negation) for an unresolved decision.
+    facts=purpose_facts(card)
+    if facts:
+        for key,v in facts:
+            add(v,True)
+        main=re.split(r'[.;,]',card.get('title') or '',maxsplit=1)[0]
+        if NEGATION.search(normalized(main)) or any(DECLARED.search(c) and NEGATION.search(c) for c in
+                    re.split(r'[.!?;]',(card.get('description') or '').casefold())):
+            positive.add('противоречие: не подтверждён')
+        head=normalized(main)
+        for marker,target in FUNCTION_WORDS.items():
+            if re.search(r'\b'+marker,head) and target not in positive:
+                positive.add(target)
+    else:
+        add(title)
+        if len(parts)>1:
+            positive.update(confirmed_title_uses(parts[1:],card.get('description') or ''))
+    for clause in re.split(r'[.!?;]',(card.get('description') or '').casefold()):
+        if not facts and DECLARED.search(clause) and not (positive and re.search(r'можно|также|дополнительно',clause)):
+            add(clause)
+    by_object={}
+    for term in sorted(positive,key=lambda v:(v not in title.split(),v)):
+        by_object.setdefault(object_key(term),term)
+    positive=set(by_object.values())
+    if set(by_object) & {object_key(term) for term in negative}:
+        return positive|{'противоречие: не подтверждён'}
+    if not positive and (negative or re.search(r'\bв (?:авто|машин)',title)):
+        return {'вид применения не подтверждён'}
+    return positive
+
+def category_key(card):
+    public=card.get('publicCategories') or []
+    if public:
+        url=public[-1].get('url','')
+        m=re.fullmatch(r'https://(?:www\.)?ozon\.ru/category/[\w-]+-(\d+)/?',url)
+        if m:
+            return ('ozon-public',m[1])
+    return ('path',tuple(normalized(v) for v in card.get('breadcrumbs',[]) if isinstance(v,str)))
+
+def profile(card):
+    return ((card.get('breadcrumbs') or [''])[-1],card.get('type') or '',purpose(card),category_key(card))
+
+def decision(sku,c,own,seen,profiles):
+    if not sku or 'error' in c:
+        return 'INVALID',c.get('error','Некорректный SKU')
+    if sku in own:
+        return 'OWN',sku
+    if sku in seen:
+        return 'DUPLICATE',sku
+    leaf,typ,uses,category=profile(c)
+    if not leaf or not profiles:
+        return 'NEEDS_CHECK','Нет подтверждённой публичной категории'
+    matching=[p for p in profiles if (p[3]==category if len(p)>3 and p[3][0]==category[0] else normalized(p[0])==normalized(leaf))]
+    if any(len(p)>3 and p[3][0]!=category[0] for p in matching):
+        matching=[p for p in matching if len(p)<=3 or p[3][0]==category[0]]
+        if not matching:
+            return 'NEEDS_CHECK','Нет сопоставимого публичного идентификатора категории'
+    if not matching:
+        if any(not p[0] for p in profiles):
+            return 'NEEDS_CHECK','У части исходных товаров неизвестна категория'
+        return 'OTHER_CATEGORY',leaf+' · '+str(category[1])
+    same=[p for p in matching if typ and normalized(p[1])==normalized(typ)]
+    if not same:
+        if not typ or any(not p[1] for p in matching):
+            return 'NEEDS_CHECK','Не подтверждён тип товара'
+        return 'OTHER_TYPE',typ
+    uncertain=False
+    for p in same:
+        required=p[2] if len(p)>2 else set()
+        required_keys={object_key(v) for v in required}
+        common={v for v in uses if object_key(v) in required_keys}
+        if common and (len(common)==len(uses)==len(required)==1) and not any('не подтверждён' in use for use in common):
+            return 'ELIGIBLE',f"{leaf} / {typ} / {', '.join(sorted(common))}"
+        if not uses and not required and not BROAD_TYPE.search(normalized(typ)):
+            return 'ELIGIBLE',f'{leaf} / {typ}'
+        if common or len(uses)>1 or len(required)>1 or not uses or not required or any(v.startswith('назначение: ') or 'не подтверждён' in v for v in uses|required):
+            uncertain=True
+    if uncertain:
+        return 'NEEDS_CHECK','Основное назначение не подтверждено для обеих карточек: '+typ
+    # A use verb elsewhere in prose does not establish that a marketing claim
+    # describes an incompatible primary function. Require a structured fact or
+    # an identified product form before declaring that mismatch.
+    if not purpose_facts(c) and not (uses & set(FUNCTION_WORDS.values())):
+        return 'NEEDS_CHECK','Нет подтверждения различия основных назначений: '+', '.join(sorted(uses))
+    return 'OTHER_TYPE','Другое назначение: '+', '.join(sorted(uses))+'; ожидается '+', '.join(sorted(set.union(*(p[2] for p in same))))
+
+
+def verification_phrases(words,targets,explicit,limit):
+    """Give each card a turn before spending a second slot on the same card."""
+    chosen=list(dict.fromkeys(explicit))[:limit]
+    fields={'title':0,'category':1,'characteristics':2,'description':3,'reviews':4}
+    queues={s:[] for s in targets}
+    # Prefer a phrase naming the subject or its use, including phrases found only
+    # in the description or reviews, before a bare attribute shared by many goods.
+    subject_words={sku:set() for sku in targets}
+    generic={'работа','ручная','ручной','авторская','подарок','набор','товар','цвет'}
+    def content_words(phrase):
+        return {w for w in normalized(phrase).split() if len(w)>=4 and w not in generic}
+    for q,origins in words.items():
+        for origin in origins:
+            if isinstance(origin,list) and origin[0] in subject_words and origin[1] in ('title','category'):
+                subject_words[origin[0]].update(content_words(q))
+    for q,origins in words.items():
+        tokens=q.split()
+        if not tokens or tokens[0].casefold() in ('в','во','для','из','на','от','под','с','со','и','или','а'):
+            continue
+        if normalized(q) in ('ручная работа','авторская работа','натуральный материал') or tokens[-1].lower() in ('шт','см','мм','мл'):
+            continue
+        if len(tokens)<2 or len(tokens)>9 or re.search(r'\b(этот|эта|котор\w+|является|поможет|может|очень|спасибо)\b',q,re.I):
+            continue
+        sources={v[0] for v in origins if isinstance(v,list) and v[0] in queues}
+        for sku in sources:
+            priority=min(fields.get(v[1],5) for v in origins if isinstance(v,list) and v[0]==sku)
+            grounded=bool(subject_words[sku] & content_words(q))
+            queues[sku].append(((not grounded,priority,len(sources),abs(len(tokens)-4)),q))
+    streams=[iter(q for _,q in sorted(rows,key=lambda item:item[0])) for rows in queues.values()]
+    while len(chosen)<limit:
+        before=len(chosen)
+        for stream in streams:
+            q=next((q for q in stream if q not in chosen),None)
+            if q:
+                chosen.append(q)
+            if len(chosen)==limit:
+                break
+        if len(chosen)==before:
+            break
+    # A confirmed single-word category/type is a useful search in its own right.
+    for q,origins in words.items():
+        if len(chosen)>=limit:
+            break
+        if q not in chosen and len(q.split())==1 and any(isinstance(v,list) and v[1] in ('title','category') for v in origins):
+            chosen.append(q)
+    return chosen
+
+
+def ranked(search,eligible):
+    positions=defaultdict(list)
+    depth=min((r['depth'] for r in search.values() if r.get('state')!='ERROR'),default=0)
+    for row in search.values():
+        first={}
+        for h in row.get('hits',[]):
+            if h['sku'] in eligible and h['index']<=depth:
+                first.setdefault(h['sku'],h['index'])
+        for sku,pos in first.items():
+            positions[sku].append(pos)
+    return sorted(positions,key=lambda s:(-len(positions[s]),statistics.median(positions[s]),int(s)))
+
+
+def peer_groups(selected,cards,eligible):
+    groups={}
+    for sku in selected:
+        own=cards[sku]
+        leaf=(own.get('breadcrumbs') or [''])[-1]
+        kind=own.get('type') or ''
+        uses=tuple(sorted(purpose(own)))
+        group=groups.setdefault((category_key(own),normalized(kind),uses),dict(category=leaf,type=kind,purpose=list(uses),own=[],eligible=[]))
+        group['own'].append(sku)
+    for group in groups.values():
+        profiles=[profile(cards[s]) for s in group['own']]
+        group['eligible']=[sku for sku in eligible if decision(sku,cards[sku],[],set(),profiles)[0]=='ELIGIBLE']
+    return list(groups.values())
+
+
+def suggested(groups,count):
+    from itertools import zip_longest
+    return unique([sku for peers in zip_longest(*(g['eligible'] for g in groups)) for sku in peers if sku])[:count]
