+"""Reserve a parser account's checks before dispatch. Uncertain sends are only polled."""
+import hashlib
+import json
+import sqlite3
+import time
+import uuid
+from contextlib import contextmanager
+from .analysis import parse_batch
+from .contracts import diagnostic, region_matches, number
+from .parser import estimate, SourceError
+
+SCHEMA = (
+    '''CREATE TABLE IF NOT EXISTS competitor_jobs(
+      research TEXT NOT NULL, phase TEXT NOT NULL, label TEXT NOT NULL UNIQUE, account TEXT NOT NULL,
+      kind TEXT NOT NULL, region TEXT NOT NULL, rows TEXT NOT NULL, reserved INTEGER NOT NULL,
+      state TEXT NOT NULL, due REAL NOT NULL, order_id TEXT, used INTEGER, data TEXT, error TEXT,
+      PRIMARY KEY(research,phase))''',
+    '''CREATE TABLE IF NOT EXISTS competitor_receipts(
+       account TEXT NOT NULL,order_id TEXT NOT NULL,label TEXT NOT NULL UNIQUE,used INTEGER NOT NULL CHECK(used>=0),
+       PRIMARY KEY(account,order_id))''',
+    '''CREATE TABLE IF NOT EXISTS competitor_backoff(account TEXT PRIMARY KEY,label TEXT NOT NULL,due REAL NOT NULL)''',
+    '''CREATE TABLE IF NOT EXISTS competitor_attempts(label TEXT PRIMARY KEY,attempts INTEGER NOT NULL)''',
+    '''CREATE TABLE IF NOT EXISTS competitor_polls(label TEXT PRIMARY KEY,attempts INTEGER NOT NULL DEFAULT 0)''',
+    '''CREATE TABLE IF NOT EXISTS competitor_incidents(label TEXT NOT NULL,reason TEXT NOT NULL,
+        accepted_id TEXT,reported_id TEXT,accepted_checks INTEGER,reported_checks INTEGER,created REAL NOT NULL,
+        PRIMARY KEY(label,reason))''',
+    'CREATE INDEX IF NOT EXISTS competitor_jobs_account ON competitor_jobs(account,state)',
+)
+
+
+@contextmanager
+def transaction(db):
+    db.execute('BEGIN IMMEDIATE')
+    try:
+        yield
+    except BaseException:
+        db.rollback()
+        raise
+    else:
+        db.commit()
+
+
+class Journal:
+    def __init__(self,path):
+        self.db=sqlite3.connect(path,isolation_level=None,timeout=15)
+        self.db.row_factory=sqlite3.Row
+        self.authorize_commit=lambda:None
+        for sql in SCHEMA:
+            self.db.execute(sql)
+
+    def close(self):
+        self.db.close()
+
+    def get(self,rid,phase):
+        return self.db.execute('SELECT * FROM competitor_jobs WHERE research=? AND phase=?',(rid,phase)).fetchone()
+
+    def step(self,rid,phase,kind,region,rows,cap,source):
+        account=hashlib.sha256(source.key.encode()).hexdigest()
+        row=self.get(rid,phase)
+        if row and row['state']=='not-sent' and not self.db.execute('SELECT 1 FROM competitor_attempts WHERE label=? AND attempts>=5',(row['label'],)).fetchone():
+            # The prior refusal was definitive, so acquire a fresh reservation on resume.
+            self.db.execute("DELETE FROM competitor_jobs WHERE label=? AND state='not-sent'",(row['label'],))
+            row=self.get(rid,phase)
+        if not row:
+            self.reconcile_detached(account,source)
+            if self.db.execute("SELECT 1 FROM competitor_backoff WHERE account=? AND due>?",(account,time.time())).fetchone():
+                return None
+            if self.db.execute("SELECT 1 FROM competitor_jobs WHERE research=? AND state='quarantine'",(rid,)).fetchone():
+                raise SourceError('Расхождение квитанции. Новые заказы остановлены')
+            prior_used=self.db.execute('SELECT COALESCE(SUM(used),0) FROM competitor_jobs WHERE account=?',(account,)).fetchone()[0]
+            balance,pending=source.balance()
+            if number(balance,integer=True) is None or number(pending,integer=True) is None:
+                raise SourceError('Неверный остаток проверок поставщика')
+            with transaction(self.db):
+                row=self.get(rid,phase)
+                if not row:
+                    self.authorize_commit()
+                    own,=self.db.execute('SELECT COALESCE(SUM(COALESCE(used,reserved)),0) FROM competitor_jobs WHERE research=?',(rid,)).fetchone()
+                    holds,=self.db.execute('SELECT COALESCE(SUM(reserved),0) FROM competitor_jobs WHERE account=? AND used IS NULL',(account,)).fetchone()
+                    reserve=estimate(rows)
+                    settled=self.db.execute('SELECT COALESCE(SUM(used),0) FROM competitor_jobs WHERE account=?',(account,)).fetchone()[0]-prior_used
+                    if reserve+own>cap or reserve+holds+max(0,settled)>balance-pending:
+                        raise ValueError('Недостаточно согласованных или доступных проверок')
+                    label='OP-'+uuid.uuid4().hex[:16]
+                    self.db.execute('INSERT INTO competitor_jobs VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)',
+                        (rid,phase,label,account,kind,region,json.dumps(rows),reserve,'submitting',time.time()+60,None,None,None,None))
+            if not row:
+                self.dispatch(source,kind,region,label,rows)
+                return None
+        if row['account']!=account:
+            raise ValueError('Ключ задания изменился. Требуется сверка исходной квитанции')
+        if json.loads(row['rows'])!=rows or row['kind']!=kind or row['region']!=region:
+            raise ValueError('Состав сохранённого задания отличается от нового плана')
+        if row['state'] in ('declined','quarantine','awaiting-manual'):
+            raise SourceError(row['error'] or 'Поставщик отклонил задание')
+        if row['state']=='not-sent':
+            return {r['name']:dict(error='RATE_LIMIT_EXHAUSTED',state='ERROR',code=r['code'],hits=[],order=None,depth=0) for r in rows}
+        if row['data'] is not None:
+            return json.loads(row['data'])
+        if row['due']>time.time():
+            return None
+        source.authorize()
+        if row['state']=='rate-limited':
+            if self.db.execute('SELECT 1 FROM competitor_backoff WHERE account=? AND label<>? AND due>?',(account,row['label'],time.time())).fetchone():
+                return None
+            with transaction(self.db):
+                claimed=self.db.execute("UPDATE competitor_jobs SET state='submitting',due=? WHERE label=? AND state='rate-limited' AND due<=?",
+                                        (time.time()+60,row['label'],time.time())).rowcount
+            if claimed:
+                self.dispatch(source,kind,region,row['label'],rows)
+            return None
+        return self.poll_existing(row,source)
+
+    def poll_existing(self,row,source,*,manual=False):
+        """Read one existing label. This path cannot create an order."""
+        if hashlib.sha256(source.key.encode()).hexdigest()!=row['account']:
+            raise ValueError('Для сверки требуется исходное подключение parser.market')
+        # Claim the read before the network call. An expired lease can be taken
+        # by another worker. Only its current holder may materialize a response.
+        if self.db.execute('SELECT 1 FROM competitor_backoff WHERE account=? AND due>?',(row['account'],time.time())).fetchone():
+            return None
+        token=time.time()+90
+        with transaction(self.db):
+            claimed=self.db.execute("""UPDATE competitor_jobs SET due=? WHERE label=? AND due<=?
+                AND data IS NULL AND state NOT IN ('completed','declined','quarantine','detached-settled','not-sent')""",
+                (token,row['label'],time.time())).rowcount
+            if claimed:
+                self.db.execute("""INSERT INTO competitor_polls VALUES(?,1)
+                    ON CONFLICT(label) DO UPDATE SET attempts=attempts+1""",(row['label'],))
+                attempts=self.db.execute('SELECT attempts FROM competitor_polls WHERE label=?',(row['label'],)).fetchone()[0]
+                if attempts>32 and not manual:
+                    self.db.execute("UPDATE competitor_jobs SET state=?,error=?,due=? WHERE label=?",
+                        ('detached-manual' if row['state'].startswith('detached') else 'awaiting-manual',
+                         'Требуется ручная сверка исходной квитанции',time.time()+60,row['label']))
+                    return None
+        if not claimed:
+            return None
+        try:
+            source.authorize()
+            state,report=source.poll(row['label'])
+            with transaction(self.db):
+                current=self.db.execute('SELECT * FROM competitor_jobs WHERE label=? AND due=?',(row['label'],token)).fetchone()
+                if not current:
+                    return None
+                label=current['label']
+                detached=current['state'].startswith('detached-')
+                oid=(report.get('id') if isinstance(report,dict) else getattr(source,'order_id',None))
+                oid=str(oid) if type(oid) in (str,int) and 0<len(str(oid))<=100 else None
+                def conflict(reason):
+                    reported=report.get('used_checks_total') if isinstance(report,dict) else None
+                    self.quarantine(current,reason,oid,reported)
+                if current['order_id'] and oid and str(current['order_id'])!=oid:
+                    conflict('Изменился ID принятого заказа')
+                    return None
+                if report is None:
+                    terminal=any(w in str(state).lower() for w in ('fail','error','cancel','reject','отмен','ошиб'))
+                    pending='detached-pending' if detached else 'awaiting-receipt' if terminal else 'waiting'
+                    self.db.execute('UPDATE competitor_jobs SET state=?,due=?,order_id=coalesce(order_id,?),error=? WHERE label=?',
+                                    (pending,time.time()+(300 if terminal else 25),oid,'Ожидаем финансовую квитанцию' if terminal else None,label))
+                    return None
+                used=report.get('used_checks_total')
+                if not oid or type(used) is not int or not 0<=used<=2**53-1:
+                    raise SourceError('Отсутствует корректный ID или used_checks_total')
+                if report.get('userlabel',label)!=label:
+                    conflict('Квитанция относится к другому заданию')
+                    return None
+                legacy=self.db.execute("""SELECT 1 FROM competitor_jobs WHERE account=? AND order_id=?
+                    AND label<>? AND used IS NOT NULL""",(current['account'],oid,label)).fetchone()
+                receipt=self.db.execute('SELECT label,used FROM competitor_receipts WHERE account=? AND order_id=?',(current['account'],oid)).fetchone()
+                if legacy or (receipt and tuple(receipt)!=(label,used)) or current['used'] not in (None,used):
+                    conflict('Квитанция противоречит ранее сохранённому заказу или расходу')
+                    return None
+                self.db.execute('INSERT OR IGNORE INTO competitor_receipts VALUES(?,?,?,?)',(current['account'],oid,label,used))
+                self.db.execute("UPDATE competitor_jobs SET state=?,order_id=?,used=? WHERE label=?",
+                                ('detached-settled' if detached else 'received',oid,used,label))
+                if used>current['reserved']:
+                    conflict('Расход поставщика превысил согласованный резерв')
+                    return None
+                if detached:
+                    return None
+            scope_ok=region_matches(current['region'],report.get('regioncode'))
+            data=parse_batch(current['kind'],json.loads(current['rows']),report)
+            if not scope_ok:
+                data={k:dict(error='REGION_MISMATCH',state='ERROR',hits=[],reviews=[],code=v['code'],order=oid,
+                             region=v.get('region'),depth=v.get('depth',0)) for k,v in data.items()}
+            source.authorize()
+            with transaction(self.db):
+                self.authorize_commit()
+                written=self.db.execute("""UPDATE competitor_jobs SET state='completed',data=?,error=NULL WHERE label=?
+                AND state='received' AND due=?""",(json.dumps(data,ensure_ascii=False,allow_nan=False),label,token)).rowcount
+            return data if written else None
+        except (ValueError,KeyError,SourceError) as exc:
+            if getattr(exc,'status',0)==429:
+                self.db.execute("""INSERT INTO competitor_backoff VALUES(?,?,?) ON CONFLICT(account) DO UPDATE
+                    SET due=max(due,excluded.due),label=excluded.label""",(row['account'],row['label'],time.time()+exc.retry_after))
+            self.db.execute('UPDATE competitor_jobs SET error=?,due=? WHERE label=? AND due=?',
+                (diagnostic(exc,(source.key,)),time.time()+getattr(exc,'retry_after',45),row['label'],token))
+            return None
+
+    def quarantine(self,row,reason,reported_id,reported_checks=None):
+        # Store only bounded provider identifiers and check counts. Never store
+        # the raw error body or original research contents in a financial incident.
+        actual=number(reported_checks,integer=True)
+        self.db.execute("INSERT OR IGNORE INTO competitor_incidents VALUES(?,?,?,?,?,?,?)",
+            (row['label'],reason,row['order_id'],reported_id,row['used'],actual,time.time()))
+        self.db.execute("UPDATE competitor_jobs SET state='quarantine',error=? WHERE label=?",(reason,row['label']))
+
+    def reconcile_detached(self,account,source,*,manual=False):
+        job=self.db.execute("""SELECT * FROM competitor_jobs WHERE account=? AND (state='detached-pending' OR
+            (? AND state='detached-manual')) AND due<=? ORDER BY due LIMIT 1""",(account,manual,time.time())).fetchone()
+        if job:
+            self.poll_existing(job,source,manual=manual)
+        if not job:
+            return 'no-due'
+        state=self.db.execute('SELECT state FROM competitor_jobs WHERE label=?',(job['label'],)).fetchone()[0]
+        return state
+
+    def dispatch(self,source,kind,region,label,rows):
+        self.db.execute("""INSERT INTO competitor_attempts VALUES(?,1) ON CONFLICT(label)
+            DO UPDATE SET attempts=attempts+1""",(label,))
+        try:
+            oid=source.submit(kind,region,label,rows)
+        except Exception as exc:
+            status=getattr(exc,'status',0)
+            state='rate-limited' if status==429 else 'declined' if status in (400,401,403,422) else 'unknown'
+            if status==429:
+                attempts=self.db.execute('SELECT attempts FROM competitor_attempts WHERE label=?',(label,)).fetchone()[0]
+                self.db.execute("""INSERT INTO competitor_backoff SELECT account,label,? FROM competitor_jobs WHERE label=?
+                    ON CONFLICT(account) DO UPDATE SET due=max(due,excluded.due),label=excluded.label""",(time.time()+getattr(exc,'retry_after',30),label))
+                if attempts>=5:
+                    state='not-sent'
+            self.db.execute("UPDATE competitor_jobs SET state=?,error=?,due=?,used=? WHERE label=? AND state='submitting'", 
+                (state,diagnostic(exc,(source.key,)),time.time()+getattr(exc,'retry_after',30),0 if state in ('declined','not-sent') else None,label))
+        else:
+            # An accepted response may arrive after STOP, deletion or a racing
+            # poll. Pin its identity even when all product material is gone.
+            with transaction(self.db):
+                row=self.db.execute('SELECT * FROM competitor_jobs WHERE label=?',(label,)).fetchone()
+                known=str(oid) if type(oid) in (str,int) and 0<len(str(oid))<=100 else None
+                if row and known and row['order_id'] and known!=row['order_id']:
+                    self.quarantine(row,'Изменился ID принятого заказа',known)
+                elif row:
+                    self.db.execute("UPDATE competitor_jobs SET order_id=coalesce(order_id,?) WHERE label=?",(known,label))
+                    self.db.execute("UPDATE competitor_jobs SET state='waiting',error=NULL,due=? WHERE label=? AND state='submitting'",(time.time()+15,label))
