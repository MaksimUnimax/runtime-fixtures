+def lookup(db,scope,rid):
+    row=db.execute('SELECT status,error,form,result FROM competitor_studies WHERE id=? AND chat=? AND workspace=? AND actor=?',
+                   (rid,scope.chat_id,scope.workspace_id,scope.actor_id)).fetchone()
+    if not row or row[0]=='revoked':
+        raise HTTPException(404,'Исследование недоступно')
+    permitted(db,scope,json.loads(row[2]))
+    return row
