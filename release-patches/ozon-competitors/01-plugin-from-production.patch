+    for k,lo,hi in [('count',1,10),('budget',1,100000),('phraseLimit',1,3000),('ownPhraseLimit',0,3000),('verifyDepth',1,3000),('depth',8,64)]:
+        if type(f[k])!=int or not lo<=f[k]<=hi:
