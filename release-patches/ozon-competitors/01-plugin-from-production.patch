+    f={'mode':'B','parser':'','store':'','refs':[],'selected':[],'categories':[],'phrases':[],
+       'region':'Москва','verifyDepth':32,'ownPhraseLimit':3,'depth':16,'count':5,'budget':60,'phraseLimit':16,'allSelected':False,'compareOwn':False,**form}
+    if f['mode'] not in ('A','B') or type(f['allSelected'])!=bool or type(f['compareOwn'])!=bool:
