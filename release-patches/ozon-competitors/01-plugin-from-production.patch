+def resolve(db,scope,text):
+    if not isinstance(text,str):
+        return Intent('other')
+    topic=bool(re.search(r'конкурент|референс|этих карточек|этого исследования|ядро.{0,16}(ozon|озон)|ozon\.ru/product/',text,re.I))
+    followup=re.fullmatch(r'\s*(?:покажи (?:его|их) топовые фразы|по каким запросам он есть,? а мой товар не найден|сравни описани[ея] и характеристики)[.?!\s]*',text,re.I)
+    if not (topic or followup or re.search(r'исследовани[ея]\s+#',text,re.I)):
+        return Intent('other')
+    from ..user_plugins.registry import attached
+    if not attached(db,scope,PLUGIN):
+        return Intent('other')
+    explicit=re.search(r'исследовани[ея]\s+#([0-9a-f]{32})\b',text,re.I)
+    if explicit and re.fullmatch(r'Передать результат анализа конкурентов, исследование #[0-9a-f]{32}',text,re.I):
+        return Intent('transfer',explicit[1].lower())
+    # Bind a request to its subject before selecting an operation or loading any
+    # studies. A named, unrelated subject must fall through to the general chat.
+    words=re.sub(r'https?://(?:www\.)?ozon\.ru/product/\S+|#[0-9a-f]{32}', ' ',text,flags=re.I)
+    foreign_market=re.search(r'\b(?:wildberries|вайлдберриз|валберис|wb|вб|amazon|авито|яндекс\s*маркет)\b',words,re.I)
+    named=re.findall(r'\b[a-zA-Z][a-zA-Z0-9_.-]*\b',words)
+    # A reference or study identifier binds the product even when its brand is
+    # written in Latin. Foreign marketplaces still exclude this plugin.
+    product_ref=explicit or re.search(r'https?://(?:www\.)?ozon\.ru/product/\S+|\b(?:sku|артикул)\s*[№:#-]?\s*[1-9]\d{5,18}\b',text,re.I)
+    named_subject=any(v.casefold() not in {'ozon','sku','id','top','performance','seller','api'} for v in named)
+    organization=re.search(r'\bконкурент\w*\s+(?:компании|сервиса|площадки|модели)\s+([^\s.,!?]+)',words,re.I)
+    foreign_subject=organization and organization[1].casefold() not in ('ozon','озон','октопорт')
+    if foreign_market or foreign_subject or (named_subject and not product_ref):
+        return Intent('other')
+    # A competitor qualified by a different named entity (including Cyrillic)
+    # is not the seller's product merely because there is a study in the chat.
+    qualifier=re.search(r'\bконкурент(?:ов|ами|ам|а|у|ы)?\s+(?:компании\s+|сервиса\s+|площадки\s+)?([А-ЯЁ][а-яёА-ЯЁ-]+)\b',words)
+    if qualifier and not product_ref and qualifier[1].casefold() not in ('озон','октопорт'):
+        return Intent('other')
+    if re.search(r'подбер|подобрать|нов(?:ый|ое) (?:анализ|исследование)|ozon\.ru/product/',text,re.I):
+        return Intent('new')
+    if re.search(r'измени|выбер|выбери',text,re.I):
+        return Intent('choose' if re.search(r'выбер|выбери',text,re.I) else 'modify')
+    subjects=set(re.findall(r'(?<![\w#])[1-9]\d{5,18}(?!\w)',text))
+    if subjects and re.search(r'проанализируй|изучи|разбери|разбор',text,re.I) and not explicit:
+        return Intent('new')
+    if not re.search(r'результат|отч[её]т|ядр[оа]|фраз|запрос|топ|описани|характеристик|фото|отзыв|спрос|рекомендаци',text,re.I):
+        return Intent('new') if re.search(r'анализ|разбери|изучи|найди',text,re.I) else Intent('other')
+    anchored=explicit or subjects or followup or re.search(r'озон|ozon|мо[иейя]|сво[иейя]|наш|эт(?:их карточек|ого исследования)',text,re.I)
+    bare_request=re.fullmatch(r'\s*(?:покажи|сравни|сопоставь|перечисли|какие)\s+(?:(?:топовые|поисковые|основные)\s+)?(?:фразы|фото|отзывы|характеристики|описани[ея]|результат|отч[её]т)\s+конкурент(?:а|ов)?[.?!\s]*',text,re.I)
+    if not (anchored or bare_request):
+        return Intent('topic-clarify')
+    rows=db.execute("""SELECT id FROM competitor_studies WHERE chat=? AND workspace=? AND actor=? AND status='done'
