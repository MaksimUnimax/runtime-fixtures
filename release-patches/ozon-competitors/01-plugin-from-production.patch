+                        if status!='selection' or not isinstance(skus,list) or len(skus)>10 or (not skus and d['eligible']) or not all(isinstance(s,str) and s in d['eligible'] for s in skus) or len(set(skus))!=len(skus):
+                            raise ValueError('Выберите до 10 подходящих конкурентов из этой выборки')
+                        form=json.loads(lookup(db,scope,rid)[2])
+                        if form['mode']=='A':
