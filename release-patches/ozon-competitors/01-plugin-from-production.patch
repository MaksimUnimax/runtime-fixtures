+                    (scope.chat_id,scope.workspace_id,scope.actor_id,explicit[1].lower() if explicit else None,explicit[1].lower() if explicit else None))
+    matches=[]
+    for (rid,) in rows:
+        try:
+            _,_,form,data=lookup(db,scope,rid)
