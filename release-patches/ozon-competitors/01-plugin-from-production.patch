+        b=dict(a,title='Декор в автомобиль / рисунок на дереве / для удачи',description='Можно повесить на зеркало, носить с собой.')
+        self.assertEqual(analysis.decision('2',b,[],set(),[analysis.profile(a)])[0],'ELIGIBLE')
+        b['description']='Нельзя повесить на зеркало.'
+        self.assertNotEqual(analysis.decision('2',b,[],set(),[analysis.profile(a)])[0],'ELIGIBLE')
