+    def test_declined_vs_unknown_vs_retry_after(self):
+        for status in (400,401,403,429,500,503,0):
+            with self.subTest(status=status),tempfile.TemporaryDirectory() as tmp:
+                j=Journal(Path(tmp)/'db');s=Transport()
+                rows=p.products('cards',['3','9'])
+                step=lambda:j.step('r','cards','cards','Москва',rows,2,s)
+                with patch.object(s,'submit',side_effect=p.SourceError('HTTP '+str(status),status,80)) as sub:
+                    self.assertIsNone(step())
+                    jrow=j.get('r','cards')
+                    self.assertLessEqual(len(jrow['label']),20)
+                    if status in (400,401,403):
+                        self.assertEqual(jrow['used'],0)
+                        with self.assertRaises(p.SourceError):step()
+                    elif status==429:
+                        self.assertEqual(jrow['state'],'rate-limited');self.assertIsNone(step())
+                    else:
+                        self.assertEqual(jrow['state'],'unknown');self.assertIsNone(step())
+                    self.assertEqual(sub.call_count,1)
+                if status==429:
+                    j.db.execute('UPDATE competitor_jobs SET due=0')
+                    self.assertIsNone(step());self.assertEqual(s.sent,1);self.assertEqual(j.get('r','cards')['label'],jrow['label'])
+                j.close()
