+import json
+import re
+import time
+from uuid import uuid4
+
+from starlette.exceptions import HTTPException
+from starlette.responses import JSONResponse,Response
+from starlette.routing import Route
+from ..chat_connections import scope_for
+from ..identity import _secret_digest
+from .service import reconcile_account,PLUGIN,guard,permitted,catalog,validate,freeze
+from .parser import ref,unique,check_units,review_subjects
+from .coverage import quality,card_fields
+from .contracts import stored_json
+
+
+def draft(db,chat):
+    row=db.execute('SELECT revision,form FROM competitor_drafts WHERE chat=?',(chat,)).fetchone()
+    return (row[0],json.loads(row[1])) if row else (0,validate({}))
+
+
+def save(db,chat,revision,form):
+    if type(revision)!=int or draft(db,chat)[0]!=revision:
