+                        db.execute("UPDATE competitor_studies SET status=?,due=0,lease=NULL,digest=?,result=? WHERE id=?",
+                                   ('running' if skus else 'done',_secret_digest(token),json.dumps(d),rid))
+                    elif action=='select-photo':
+                        if type(args['selected'])!=bool or not db.execute('UPDATE competitor_assets SET selected=? WHERE '+ASSET_SCOPE+' AND id=?',(args['selected'],*asset_scope(rid,d),args['asset'])).rowcount:
+                            raise HTTPException(404,'Фотография недоступна')
+            if rid:
