+                    disposition='attachment' if req.query_params.get('download')=='1' else 'inline'
+                    return Response(item[1],media_type=item[0],headers={'Content-Disposition':disposition,'Cache-Control':'private, no-store','X-Content-Type-Options':'nosniff'})
+                return JSONResponse(result,headers={'Content-Disposition':'attachment; filename="ozon-research.json"'} if action=='export' else {})
+            revision,form=draft(db,scope.chat_id)
+            rows=db.execute('''SELECT i.id,i.name,i.provider FROM chat_integrations g JOIN account_integrations i ON i.id=g.connection_id
+              WHERE g.chat_id=? AND i.workspace=? AND i.status='verified' AND i.provider IN ('ozon','parser-market') ORDER BY i.name''',(scope.chat_id,scope.workspace_id))
+            services=[dict(id=i,name=n,provider=p) for i,n,p in rows]
+            cid=req.query_params.get('store')
+            studies=[dict(id=i,status=s) for i,s in db.execute("SELECT id,status FROM competitor_studies WHERE chat=? AND actor=? AND status!='revoked' ORDER BY created DESC LIMIT 50",(scope.chat_id,scope.actor_id))]
