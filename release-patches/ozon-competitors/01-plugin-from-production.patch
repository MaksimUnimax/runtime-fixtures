+"""Single business outcome projection for stored studies, export, UI and Octopus."""
+def quality(data):
+    targets=data.get('targets',[])
+    cards=data.get('cards',{})
+    reviewed=data.get('reviews',{})
+    good=[s for s in targets if s in cards and not cards[s].get('error')]
+    observations=[v for s in targets for v in data.get('kernel',{}).get(s,{}).get('phrases',{}).values()]
+    photos=[p for s in targets for p in data.get('gallery',{}).get(s,{}).values()]
+    failures=[]
+    for group,rows in [('card',cards),('review',reviewed)]:
+        failures.extend({'source':group,'sku':s,'error':v['error']} for s,v in rows.items() if v.get('error'))
+    search_errors=sum(v['status'] in ('ERROR','INCOMPLETE') or v.get('coverage')=='INCOMPLETE' for v in observations)
+    discovery_errors=[{'source':'search','phrase':q,'error':v.get('error') or 'ERROR'} for q,v in data.get('search',{}).items() if v.get('state')=='ERROR']
+    failures.extend(discovery_errors)
+    missing_search=bool(observations) and all(v['status']=='UNCHECKED' for v in observations)
+    photo_errors=sum(bool(p.get('error')) for p in photos)
+    analytics_errors=bool(data.get('seller',{}).get('missingSummary')) or any(data.get(src,{}).get(k) for src,k in [('seller','error'),('seller','errors'),('performance','failed'),('performance','error')])
+    for sku,group in reviewed.items():
+        if group.get('invalidRows'):
+            failures.append({'source':'review','sku':sku,'error':'Некорректные строки отзывов: '+str(group['invalidRows'])})
+    reviewed_count=sum(isinstance(reviewed.get(s,{}).get('reviews'),list) for s in good)
+    missing_reviews=data.get('phase')=='done' and reviewed_count<len(good)
+    missing_photos=sum(1 for sku in good for url in cards[sku].get('photos',[]) if url not in data.get('gallery',{}).get(sku,{}))
+    incomplete=bool(missing_reviews or missing_photos or failures or photo_errors or analytics_errors or search_errors or missing_search or len(good)<len(targets))
+    return dict(requested=len(targets),fetched=sum(s in cards and not cards[s].get('error') for s in targets),validated=len(good),
+                reviewed=reviewed_count,
+                searchVerified=sum(v['status'] in ('FOUND','NOT_FOUND_IN_SAMPLE') for v in observations),
+                searchIncomplete=search_errors,photoFetched=sum(bool(p.get('asset')) for p in photos),
+                photoPending=missing_photos,photoFailed=photo_errors,failures=failures,partial=incomplete,
+                outcome='empty' if data.get('noConfirmedPeers') and not incomplete else 'failed' if targets and not good else 'partial' if incomplete else 'complete')
