+            db.execute('INSERT INTO competitor_studies VALUES(?,?,?,?,?,?,?,?,?)',(rid,'w','c',actor,'done',1,'{}',json.dumps({'targets':skus}),''))
+        with patch('platform_core.user_plugins.registry.attached',return_value=True),patch.object(routes,'permitted'):
+            self.assertEqual(routes.resolve(db,scope,'Покажи фото конкурента 123456').research,'1')
+            self.assertEqual(routes.resolve(db,scope,'Покажи фото конкурента 345678').action,'clarify')
+            self.assertEqual(routes.resolve(db,scope,'Проанализируй конкурента 987654 по фразам').action,'new')
