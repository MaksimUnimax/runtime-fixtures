+    return False,dict(error='did not raise expected error')
+
+def concurrent_same_plan():
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier,Lock
+    with tempfile.TemporaryDirectory() as tmp:
+        path=Path(tmp)/'db';j=Journal(path);j.close();s=Stub();barrier=Barrier(2);lock=Lock();rows=products('cards',['200001'])
+        def run():
+            j=Journal(path)
+            try:barrier.wait(timeout=5);j.step('r','same-phase','cards','Москва',rows,10,s)
+            finally:j.close()
+        with ThreadPoolExecutor(max_workers=2) as pool:list(pool.map(lambda _:run(),range(2)))
+        j=Journal(path);data=jout(j);j.close()
+        return len(s.sends)==1 and len(data)==1,dict(submits=len(s.sends),jobs=data)
+
+def concurrent_reserve_limit():
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier
+    with tempfile.TemporaryDirectory() as tmp:
+        path=Path(tmp)/'db';j=Journal(path);j.close();s=Stub(balance=1);barrier=Barrier(2);rows=products('cards',['200001'])
+        def run(r):
+            j=Journal(path)
+            try:
+                barrier.wait(timeout=5)
+                try:j.step(r,'card','cards','Москва',rows,1,s);return 'admitted'
+                except ValueError:return 'blocked'
+            finally:j.close()
+        with ThreadPoolExecutor(max_workers=2) as pool:states=list(pool.map(run,['first','second']))
+        return sorted(states)==['admitted','blocked'] and len(s.sends)==1,dict(states=states,submits=len(s.sends))
+
