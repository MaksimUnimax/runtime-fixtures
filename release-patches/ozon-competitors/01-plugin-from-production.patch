+"""Deterministic research, keeping original labels and observed positions."""
+import json
+import re
+import statistics
+from collections import defaultdict
+from datetime import datetime,timezone
+from urllib.parse import urlsplit
+
+from .contracts import number, text
+from .parser import exact, unique, match_rows
+
+
+def characteristics(value):
+    if isinstance(value,str):
+        try:
+            value=json.loads(value)
+        except ValueError:
+            return {'Текст': [value[:12000]]} if value.strip() else {}
+    fields=defaultdict(list)
+    def visit(node):
+        if isinstance(node,list):
+            for child in node:
+                visit(child)
+        elif isinstance(node,dict):
+            if text(node.get('name')) and isinstance(node.get('values'),list):
+                fields[text(node['name'])].extend(text(v['text'],2000) for v in node['values'] if isinstance(v,dict) and text(v.get('text')))
+            else:
+                for k in ('characteristics','short','long','full','groups','items'):
+                    visit(node.get(k))
+    visit(value)
+    return {k:unique(v) for k,v in fields.items() if v}
+
+
+def photo_url(url):
+    if not isinstance(url,str) or len(url)>2048:
+        return False
+    try:
+        p=urlsplit(url)
+    except ValueError:
+        return False
+    return p.scheme=='https' and bool(re.fullmatch(r'(?:ir|cdn[0-9]*)\.ozone\.ru',p.netloc.lower())) and p.path.startswith('/')
+
+
+def category_path(breadcrumbs):
+    result=[]
+    for item in breadcrumbs or []:
+        if not isinstance(item,dict) or not text(item.get('name')):
+            continue
+        link=urlsplit(str(item.get('link') or ''))
+        if link.scheme!='https' or link.netloc.lower() not in ('www.ozon.ru','ozon.ru'):
+            continue
+        if re.fullmatch(r'/category/[\w-]+-[0-9]+/?',link.path):
+            result.append({'name':text(item['name']),'url':link._replace(query='',fragment='').geturl()})
+    return result
+
+
+def shop_url(value):
+    if isinstance(value,str):
+        try:
+            u=urlsplit(value)
+            if u.scheme=='https' and u.netloc.lower() in ('ozon.ru','www.ozon.ru') and u.path.startswith('/seller/'):
+                return u._replace(fragment='',query='').geturl()
+        except ValueError:
+            pass
+    return None
+
+
+def review_rows(comments):
+    if not isinstance(comments,list):
+        return {'error':'MISSING_REVIEWS'}
+    rows=[]
+    invalid=0
+    for c in comments:
+        if not isinstance(c,dict) or not any(text(c.get(k)) for k in ('Comment','Pro','Contra','Title','Published')):
+            invalid+=1
+            continue
+        row={k:text(c.get(k),12000) for k in ('Published','Comment','Pro','Contra','Title')}
+        rating=number(c.get('Rating'),0,5,integer=True)
+        # The supplier uses numeric zero for an unpublished individual rating.
+        row['Rating']=rating or None
+        if c.get('Rating') is not None and rating is None:
+            invalid+=1
+        rows.append(row)
+    return {'reviews':rows,'invalidRows':invalid}
+
+
+def card(offer):
+    attrs=characteristics(offer.get('CharacteristicsObject') or offer.get('Characteristics'))
+    for field in ('Breadcrumbs', 'Offer_pics'):
+        if offer.get(field) is not None and not isinstance(offer[field], list):
+            raise ValueError('INVALID_FIELD: '+field)
+    for field in ('Name', 'Seo_description'):
+        if offer.get(field) is not None and not isinstance(offer[field], str):
+            raise ValueError('INVALID_FIELD: '+field)
+    path=category_path(offer.get('Breadcrumbs'))
+    crumbs=[b['name'] for b in path]
+    result={'sku':exact(offer),'title':text(offer.get('Name'),2000),'description':text(offer.get('Seo_description'),80000),
+            'characteristics':attrs,'breadcrumbs':crumbs,'publicCategories':path,'type':next(iter(attrs.get('Тип',[])),None),
+            'photos':unique([u for u in offer.get('Offer_pics') or [] if photo_url(u)]),
+            'url':f"https://www.ozon.ru/product/{exact(offer)}/",'sellerRating':number(offer.get('ShopRating'),0,5) or None,
+            'brand':text(offer.get('Brand_found')),'questions':number(offer.get('SkuQuestions'),integer=True),
+            'seller':text(offer.get('ShopName')),'sellerId':text(offer.get('ShopId')) or number(offer.get('ShopId'),integer=True),'sellerUrl':shop_url(offer.get('ShopUrl')),
+            'rating':number(offer.get('SkuRating'),0,5) or None,'ratingCount':number(offer.get('SkuRates'),integer=True),
+            'delivery':text(offer.get('DeliveryTerm')) or number(offer.get('DeliveryTerm')),'available':offer.get('Ozon_available') if type(offer.get('Ozon_available')) is bool else None,
+            'stock':number(offer.get('Ozon_stockcount'),integer=True),'source':'parser.market'}
+    for k in ('Price','PromoPrice','OldPrice','Ozon_sellerprice','OZON_couponPrice'):
+        value=offer.get(k)
+        result[k]=number(value) or None
+    return result
+
+
+def parse_batch(kind,rows,report):
+    data={}
+    for row,error,item in match_rows(rows,report):
+        key=row['name']
+        offers=item['offers'] if item else []
+        if kind=='search':
