+   real=analysis.parse_batch;stage={}
+   def deleted_after_receipt(kind,rows,report):
+    stage['receipts_before_delete']=db.execute('SELECT count(*) FROM competitor_receipts').fetchone()[0]
+    db.execute("DELETE FROM workspaces WHERE workspace_id='workspace'")
+    stage['studies_after_delete']=db.execute('SELECT count(*) FROM competitor_studies').fetchone()[0]
+    return real(kind,rows,report)
+   exc=None
+   with patch.object(jobs,'parse_batch',side_effect=deleted_after_receipt):
+    try:service.tick(path)
+    except Exception as e:exc=type(e).__name__+': '+str(e)
+   assert stage=={'receipts_before_delete':1,'studies_after_delete':0},stage
