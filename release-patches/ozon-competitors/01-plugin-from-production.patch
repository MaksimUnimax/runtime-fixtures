+            if not db.execute('SELECT 1 FROM identity_sessions WHERE digest=? AND actor_id=? AND expires_at>?',
+                              (row['digest'],scope.actor_id,time.time())).fetchone():
+                raise SessionExpired('Для восстановления доступа к исследованию войдите повторно')
+            db.execute('UPDATE competitor_studies SET due=? WHERE id=? AND lease=?',(time.time()+180,rid,lease))
+        def fields(provider,key):
+            return unseal(scope.workspace_id,provider,f[key],connection(db,scope,f[key],provider)[1])
+        def own_guard(right):
+            authorize()
+            if right=='advertising' and not allowed(db,f['store'],right):
+                raise OzonError('Доступ Performance отклонён для этого ключа')
+            connection(db,scope,f['store'],'ozon',right,f['storeVersion'])
+        def checkpoint():
+            authorize()
+            db.execute('UPDATE competitor_studies SET result=? WHERE id=? AND lease=?',(json.dumps(d,ensure_ascii=False),rid,lease))
+        try:
+            authorize()
+            journal.authorize_commit=authorize
+            source=Parser(fields('parser-market','parser')['token'],authorize)
+            if row['status']=='stopped':
+                db.execute("UPDATE competitor_jobs SET state='not-sent',used=0 WHERE research=? AND state='rate-limited'",(rid,))
+                job=db.execute("""SELECT * FROM competitor_jobs WHERE research=? AND due<=? AND data IS NULL
+                                  AND state NOT IN ('declined','quarantine','not-sent','detached-settled','awaiting-manual','detached-manual') ORDER BY due LIMIT 1""",(rid,now)).fetchone()
+                if job:
+                    journal.poll_existing(job,source)
+                record_receipts(db,scope,rid)
+                db.execute('UPDATE competitor_studies SET due=0,lease=NULL WHERE id=? AND lease=?',(rid,lease))
+                return True
+            own=Own(fields('ozon','store'),own_guard) if f.get('storeVersion') else None
+            before=d['phase']
+            advance(journal,rid,f,d,source,own,checkpoint)
+            record_receipts(db,scope,rid)
+            authorize()
+            status={'done':'done','selection':'selection'}.get(d['phase'],'running')
+            db.execute('UPDATE competitor_studies SET result=?,status=?,due=?,lease=NULL,error=? WHERE id=? AND lease=?',
+                (json.dumps(d,ensure_ascii=False),status,time.time()+(20 if before==d['phase'] and before!='gallery' else 0),'',rid,lease))
+        except SessionExpired as exc:
+            with transaction(db):
+                changed=db.execute("UPDATE competitor_studies SET status='reauth',error=?,lease=NULL WHERE id=? AND lease=?",(str(exc),rid,lease)).rowcount
+                if changed:
+                    db.execute("UPDATE competitor_jobs SET error=? WHERE research=? AND used IS NULL",(str(exc),rid))
+                    db.execute('INSERT OR REPLACE INTO competitor_auth_pause VALUES(?,?)',(rid,row['status']))
+        except Exception as exc:
+            record_receipts(db,scope,rid)
+            message=diagnostic(getattr(exc,'detail',exc))
+            db.execute('UPDATE competitor_studies SET status=?,error=?,lease=NULL WHERE id=? AND lease=?',
+                    ('revoked' if isinstance(exc,HTTPException) and exc.status_code==403 else 'stopped' if row['status']=='stopped' else 'paused',message,rid,lease))
+        return True
+    finally:
+        journal.close()
+
+
+def reconcile_account(path,token,chat,connection_id):
+    """Offline research authorization is never reused to poll a deleted chat."""
+    with closing(Journal(path)) as journal:
+        db=journal.db
+        scope=scope_for(db,token,chat)
+        guard(db,scope)
+        version,blob=connection(db,scope,connection_id,'parser-market')
+        def authorize():
+            current=scope_for(db,token,chat)
+            guard(db,current)
+            connection(db,current,connection_id,'parser-market',version=version)
+        secret=unseal(scope.workspace_id,'parser-market',connection_id,blob)['token']
+        source=Parser(secret,authorize)
+        outcome=journal.reconcile_detached(hashlib.sha256(secret.encode()).hexdigest(),source,manual=True)
+        authorize()
+        messages={'no-due':'Сейчас нет квитанций, доступных для повторной сверки.',
+                  'detached-settled':'Поставщик подтвердил окончательный расход.',
+                  'quarantine':'Квитанция противоречит сохранённой записи. Требуется сверка с поставщиком.'}
+        return {'state':outcome,'message':messages.get(outcome,'Окончательная квитанция ещё не получена.')}
+
+async def maintain(path):
+    async def worker():
+        while True:
+            try:
+                ran=await asyncio.to_thread(tick,path)
+            except sqlite3.OperationalError:
+                ran=False
+            await asyncio.sleep(1 if ran else 4)
+    await asyncio.gather(worker(),worker())
+
