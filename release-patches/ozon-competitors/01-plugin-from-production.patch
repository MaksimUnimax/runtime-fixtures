+def install(db):
+    db.execute('DROP TRIGGER IF EXISTS competitor_forget')
+    for sql in SCHEMA:
+        db.execute(sql)
+    db.execute("""UPDATE competitor_jobs SET rows='[]',data=NULL,region='',kind='',error=NULL,due=0,
+        state=CASE WHEN used IS NULL THEN 'detached-pending' ELSE 'detached-settled' END
+        WHERE state NOT IN ('detached-pending','detached-settled','quarantine')
