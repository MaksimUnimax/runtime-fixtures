+def routes(token_for,body):
+    base='/api/chats/{chat_id}/plugins/'+PLUGIN
+    async def handle(req):
+        token=token_for(req,allow_cookie=True)
+        identity=req.app.state.identity
+        action=req.path_params.get('action','')
+        args={}
+        if req.method=='POST':
+            keys={'reconcile':('parser',),'estimate':('form',),'save':('revision','form'),'start':('revision','requestId'),'choose':('id','skus'),
+                  'budget':('id','budget'),'retry-rows':('id','label'),'reread':('id','label'),'expand':('id',),'more':('id',),'retry-photos':('id',),'retry-seller':('id',),'retry-ads':('id',),'stop':('id',),'resume':('id',),'select-photo':('id','asset','selected')}
+            if action not in keys:
+                raise HTTPException(404,'Неизвестная команда')
+            args=await body(req,*keys[action])
+        if action=='reconcile' and req.method=='POST':
+            from starlette.concurrency import run_in_threadpool
+            with identity._lock:
+                path=identity._db.execute('PRAGMA database_list').fetchone()[2]
+            return JSONResponse(await run_in_threadpool(reconcile_account,path,token,req.path_params['chat_id'],args['parser']))
+        with (identity._write() if req.method=='POST' else identity._lock):
+            db=identity._db
+            scope=scope_for(db,token,req.path_params['chat_id'])
+            guard(db,scope)
+            rid=args.get('id') or req.query_params.get('id')
+            if req.method=='POST':
+                if action=='estimate':
+                    return JSONResponse(quote(freeze(db,scope,args['form'])))
+                if action=='save':
+                    save(db,scope.chat_id,args['revision'],args['form'])
+                elif action=='start':
+                    rid=new(db,scope,_secret_digest(token),args['requestId'],args['revision'])
+                else:
+                    status,_,_,encoded=lookup(db,scope,rid)
+                    d=stored_json(encoded)
+                    if action=='stop':
+                        db.execute("UPDATE competitor_studies SET status='stopped',lease=NULL,due=0 WHERE id=? AND status IN ('running','selection','paused')",(rid,))
+                    elif action=='resume' and status=='reauth':
+                        old=db.execute('SELECT execution FROM competitor_auth_pause WHERE research=?',(rid,)).fetchone()
+                        db.execute("UPDATE competitor_studies SET status=?,digest=?,error='',due=0 WHERE id=?",
+                                   (old[0] if old else 'stopped',_secret_digest(token),rid))
+                        db.execute('DELETE FROM competitor_auth_pause WHERE research=?',(rid,))
+                    elif action=='resume' and status in ('paused','stopped'):
+                        # A manual resume renews polling on the original label only.
+                        for row in db.execute("SELECT label FROM competitor_jobs WHERE research=? AND state='awaiting-manual'",(rid,)).fetchall():
+                            db.execute('DELETE FROM competitor_polls WHERE label=?',(row[0],))
+                            db.execute("UPDATE competitor_jobs SET state='waiting',due=0 WHERE label=?",(row[0],))
+                        db.execute('UPDATE competitor_studies SET status=?,digest=?,error=?,due=0 WHERE id=?',
+                            ('selection' if d['phase']=='selection' else 'running',_secret_digest(token),'',rid))
+                    elif action=='budget':
+                        amount=args['budget']
+                        f=json.loads(lookup(db,scope,rid)[2])
+                        if status!='paused' or type(amount)!=int or not f['budget']<amount<=100000:
+                            raise HTTPException(409,'Укажите новый верхний лимит для приостановленного исследования')
+                        f['budget']=amount
+                        db.execute("UPDATE competitor_studies SET form=?,status='running',due=0,error='',digest=? WHERE id=?",
+                            (json.dumps(f),_secret_digest(token),rid))
+                    elif action in ('retry-rows','reread'):
+                        job=db.execute("SELECT kind,rows,phase,order_id FROM competitor_jobs WHERE research=? AND label=? AND state IN ('completed','declined')",(rid,args['label'])).fetchone()
+                        if status not in ('done','selection') or not job:
+                            raise HTTPException(409,'Повтор строк доступен после завершения этапа')
+                        kind,encoded_rows,phase,order=job
