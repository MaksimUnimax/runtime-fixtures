+        n=re.search(r'\b(10|[1-9])\s+конкурент',text,re.I)
+        if n:
+            f['count']=int(n[1])
+        save(db,scope.chat_id,revision,f)
+        message=('Подбор для своих товаров' if f['mode']=='A' else 'Анализ выбранного референса')+'. Черновик обновлён. Откройте «Анализ конкурентов Ozon» в этом чате, проверьте выбор и подтвердите лимит.'
+    except ValueError as e:
+        message=str(e)
+    db.execute('INSERT INTO competitor_exchanges VALUES(?,?,?,?)',(scope.chat_id,rid,text,message))
