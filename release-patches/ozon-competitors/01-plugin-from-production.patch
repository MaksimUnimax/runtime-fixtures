+        self.assertEqual(analysis.decision('2',a,[],set(),[analysis.profile(b)])[0],'NEEDS_CHECK')
+    def test_equal_leaf_names_in_distinct_paths(self):
+        a=dict(type='Фильтр',breadcrumbs=['Аквариумистика','Фильтры'])
+        b=dict(a,breadcrumbs=['Водопровод','Фильтры'])
+        self.assertEqual(analysis.decision('2',a,[],set(),[analysis.profile(b)])[0],'OTHER_CATEGORY')
+    def test_saved_error_receipt_cannot_authorize_another(self):
+        rows=products('search',['поиск'],32)
+        result={'search':{'поиск':{'depth':32,'order':'100','label':'a','code':'Q1','state':'ERROR'}}}
+        self.assertFalse(routes.failed_items('search',rows,result,'101','verify','b'))
+        self.assertTrue(routes.failed_items('search',rows,result,'100','verify','a'))
+    def test_revised_target_list_scopes_photos_and_chosen_references(self):
