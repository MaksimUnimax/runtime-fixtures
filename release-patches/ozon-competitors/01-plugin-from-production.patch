+"""Advance an authorized research one recoverable phase at a time."""
+import hashlib
+import io
+import time
+import httpx
+import json
+from pathlib import Path
+from uuid import uuid4
+from PIL import Image
+
+from .analysis import normalized,candidates, decision, observed, photo_url, ranked, peer_groups, suggested, profile, verification_phrases, purpose_facts, category_key
+from .parser import fetch, products, batches, unique, review_subjects, SourceError
+from .own import OzonError,ad_totals
+from .facts import merge_result
+
+def photo(db,rid,sku,url,authorize):
+    if not photo_url(url):
+        raise ValueError('Недопустимый адрес фотографии')
+    old=db.execute('SELECT id FROM competitor_assets WHERE research=? AND sku=? AND url=?',(rid,sku,url)).fetchone()
+    if old:
+        return old[0]
+    authorize()
+    data,mime=fetch(url,limit=8*1024*1024)
+    try:
+        image=Image.open(io.BytesIO(data))
+    except Image.DecompressionBombError as exc:
+        raise ValueError('Превышен безопасный размер изображения') from exc
+    with image as img:
+        if (img.format not in ('JPEG','PNG','WEBP') or img.width*img.height>24_000_000 or
+                Image.MIME[img.format]!=mime):
+            raise ValueError('Формат, размер или MIME изображения не прошёл проверку')
+        img.verify()
+    authorize()
+    uid=uuid4().hex
+    db.execute('INSERT OR IGNORE INTO competitor_assets VALUES(?,?,?,?,?,?,?,0)',(uid,rid,sku,url,mime,hashlib.sha256(data).hexdigest(),data))
+    return db.execute('SELECT id FROM competitor_assets WHERE research=? AND sku=? AND url=?',(rid,sku,url)).fetchone()[0]
+
+
+def advance(journal,rid,f,d,source,own,checkpoint):
+    phase=d['phase']
+    cards=d.setdefault('cards',{})
+    search=d.setdefault('search',{})
+    targets=d.get('targets',[])
+    selected=f['skus']
+    def batch(kind,items,store,depth=None):
+        missing=[v for v in unique(items) if v not in store or (kind=='search' and store[v].get('depth',0)<(depth or f['depth']))]
+        if not missing:
+            return True
+        depth=depth or f['depth']
+        # Freeze row codes and split boundaries before the first external order.
+        # A restarted worker uses the original plan even after a partial commit.
+        plans=d.setdefault('batchPlans',{})
+        plan=plans.get(phase)
+        if plan is None:
+            plan=list(batches(products(kind,missing,depth)))
+            plans[phase]=plan
+            checkpoint()
+        for part in plan:
+            if all(r['name'] in store and (kind!='search' or store[r['name']].get('depth',0)>=depth) for r in part):
+                continue
+            key=phase
+            old=journal.get(rid,key)
+            if len(plan)>1 or old and json.loads(old['rows'])!=part:
+                key=phase+'-'+hashlib.sha256(json.dumps(part,sort_keys=True).encode()).hexdigest()[:16]
+            try:
+                result=journal.step(rid,key,kind,f['region'],part,f['budget'],source)
+            except SourceError:
+                failed=journal.get(rid,key)
+                if not failed or failed['state']!='declined':
+                    raise
+                result={r['name']:dict(error=failed['error'],state='ERROR',order=failed['order_id'],code=r['code'],
+                                       depth=depth,hits=[]) for r in part}
+            if result is None:
+                return False
+            saved=journal.get(rid,key)
+            if saved:
+                for entry in result.values():
+                    entry['label']=saved['label']
+            store.update(result)
+            checkpoint()
+        plans.pop(phase,None)
+        if any(v not in store for v in missing):
+            return False
+        return True
+    def move(stage):
+        d.setdefault('phases',[]).append(phase)
+        d['phase']=stage
+
+    if phase=='retry-rows':
+        job=d['retry']
+        inputs=job.get('originalRows',job['rows'])
+        result=journal.step(rid,job['key'],job['kind'],f['region'],inputs,f['budget'],source)
+        if result is None:
+            return
+        result={r['name']:result[r['name']] for r in job['rows'] if r['name'] in result}
+        cache={'cards':cards,'search':search,'reviews':d.setdefault('reviews',{})}[job['kind']]
+        receipt=journal.get(rid,job['key'])
+        if receipt:
+            for item in result.values():
+                item['label']=receipt['label']
+        result={key:merge_result(job['kind'],cache.get(key),entry) for key,entry in result.items()}
+        cache.update(result)
+        origin=job.get('origin',job['phase']).split('-')[0]
+        if origin=='expand':
+            d.setdefault('expanded',{}).update(result)
+            move('expand')
+        elif origin in ('discover','profile'):
+            move(origin)
+        elif job['return']=='selection':
+            move('qualify')
+        elif job['kind']=='cards':
+            move('reviews')
+        else:
+            move('dictionary')
+    elif phase=='profile':
+        if not batch('cards',selected,cards):
+            return
+        phrases=[]
+        for sku in selected:
+            leaf,kind,uses,*_=profile(cards[sku])
+            title=candidates({sku:cards[sku]}, {})
+            title_phrase=next((q for q,origins in title.items() if [sku,'title'] in origins and len(q.split())>=2),None)
+            phrases.extend(q for q in (leaf,kind,*sorted(uses),title_phrase) if q)
+        # Preserve the first provider spelling while sending case/whitespace
+        # variants of the same discovery phrase only once.
+        phrases=list({normalized(q):q for q in reversed(phrases+f['phrases'])}.values())[::-1]
+        if not phrases:
+            raise ValueError('Не удалось определить категорию и тип выбранных товаров')
+        d['discovery']=phrases
+        move('discover')
+    elif phase=='expand':
+        expanded=d.setdefault('expanded',{})
+        if not batch('search',d['discovery'],expanded,depth=32):
+            return
+        d.setdefault('firstSample',dict(search))
+        search.update(expanded)
+        d.pop('noConfirmedPeers',None)
+        d['pool']=ranked(expanded,{h['sku'] for row in expanded.values() for h in row['hits'] if h['sku']})
+        move('qualify-expanded')
+    elif phase=='discover':
+        if not batch('search',d['discovery'],search):
+            return
+        discovered={q:search[q] for q in d['discovery']}
+        pool=ranked(discovered,{h['sku'] for q in discovered.values() for h in q['hits'] if h['sku']})
+        seen=set()
+        audit=[]
+        for phrase,row in discovered.items():
+            for hit in row['hits']:
+                sku=hit['sku']
+                if not sku or sku in seen:
+                    audit.append(dict(sku=sku,phrase=phrase,index=hit['index'],reason='DUPLICATE' if sku else 'INVALID'))
+                seen.add(sku)
+        d.pop('noConfirmedPeers',None)
+        d['poolAudit']=audit
+        d['pool']=pool
+        move('qualify')
+    elif phase in ('qualify','qualify-expanded'):
+        profiles=[profile(cards[s]) for s in selected]
+        discovery={q:search[q] for q in d['discovery']}
+        goal=d.get('qualificationGoal',f['count'])
+        def classify():
+            reasons={s:decision(s,cards.get(s,{}),f['own'],set(),profiles) for s in d['pool'] if s in cards or s in f['own']}
+            d['decisions']=reasons
+            d['classificationEvidence']={s:{'category':category_key(cards[s]),'type':cards[s].get('type'),
+                   'purposeFields':purpose_facts(cards[s]),'title':cards[s].get('title'),'order':cards[s].get('order')}
+                   for s in dict.fromkeys(selected+list(reasons)) if s in cards}
+            d['eligible']=ranked(discovery,{s for s,(reason,_) in reasons.items() if reason=='ELIGIBLE'})
+            d['groups']=peer_groups(selected,cards,d['eligible'])
+            d['targets']=suggested(d['groups'],goal)
+        classify()
+        pending=[s for s in d['pool'] if s not in cards and s not in f['own']]
+        def missing_slots():
+            groups=d['groups']
+            return max(goal-len(d['targets']),sum(max(0,goal//len(groups)+(i<goal%len(groups))-len(g['eligible']))
+                                                    for i,g in enumerate(groups))) if groups else goal
+        if pending and missing_slots():
+            # Finish any exact batch already submitted by an older worker before replanning.
+            existing=journal.get(rid,phase)
+            if journal.db is not None:
+                # Preserve a prior worker's exact paid split across a restart or update.
+                for saved in journal.db.execute("""SELECT * FROM competitor_jobs WHERE research=? AND
+                        (phase=? OR (length(phase)=length(?)+17 AND substr(phase,1,length(?)+1)=?||'-'))
+                        ORDER BY rowid DESC""",(rid,phase,phase,phase,phase)):
+                    if all(row['name'] in pending for row in json.loads(saved['rows'])):
+                        existing=saved
+                        break
+            ordered=[row['name'] for row in json.loads(existing['rows'])] if existing else []
+            todo=ordered if ordered and all(s in pending for s in ordered) else pending[:min(10,max(3,missing_slots()))]
+            if not batch('cards',todo,cards):
+                return
+            classify()
+            pending=[s for s in pending if s not in cards]
+            if pending and missing_slots():
+                return
+        d['unexamined']=pending
+        move('selection')
+    elif phase=='cards':
+        if batch('cards',targets,cards):
+            move('reviews')
+    elif phase=='reviews':
+        if batch('reviews',[s for s in review_subjects(f['mode'],targets,selected) if s in cards and not cards[s].get('error')],d.setdefault('reviews',{})):
+            move('dictionary')
+    elif phase=='dictionary':
+        words=candidates({s:cards[s] for s in targets if s in cards},d.get('reviews',{}),[(q,'форма') for q in f['phrases']])
+        d['candidates']=words
+        # User-supplied phrases have priority within the explicitly approved sample.
+        reserved=min(f.get('ownPhraseLimit',0),max(0,f['phraseLimit']-1)) if selected else 0
+        d['verify']=verification_phrases(words,targets,f['phrases'],f['phraseLimit']-reserved)
+        move('verify')
+    elif phase=='verify':
+        if not batch('search',d['verify'],search,f.get('verifyDepth',f['depth'])):
+            return
+        d['kernel']=observed(targets,d['candidates'],search)
+        move('own' if f['mode']=='A' else 'own-reference' if selected else 'gallery')
+    elif phase=='own-reference':
+        if batch('cards',selected,cards):
+            move('own')
+    elif phase=='own':
+        if 'seller' not in d:
+            try:
+                d['seller']=own.seller(f.get('relatedSkus',selected),f['sellerPeriod'],cache=(journal.db,f['store'],f['storeVersion']))
+            except OzonError as exc:
+                d['seller']=getattr(exc,'partial',{'error':str(exc)})
+            checkpoint()
+        if 'performance' not in d and not own.fields.get('performance_secret'):
+            d['performance']={'reason':'Нет рекламного ключа'}
+        if 'performance' not in d:
+            try:
+                if 'adBatches' not in d or d.get('retryCampaigns'):
+                    subjects=set(f.get('relatedSkus',selected))
+                    retry=d.get('retryCampaigns')
+                    try:
+                        campaigns=own.campaigns(subjects,f['adPeriod'],only=set(retry)) if isinstance(retry,list) else own.campaigns(subjects,f['adPeriod'])
+                        d['campaignErrors']=list(getattr(own,'campaign_errors',[]))
+                    except (OzonError,httpx.TransportError) as exc:
+                        campaigns=[]
+                        d['campaignErrors']=[{'source':'campaign-list','error':str(exc) if isinstance(exc,OzonError) else type(exc).__name__}]
+                    jobs=d.setdefault('adBatches',[])
+                    queued={c for job in jobs for c in job['campaigns']}
+                    campaigns=[c for c in campaigns if c not in queued]
+                    jobs.extend({'campaigns':campaigns[i:i+10]} for i in range(0,len(campaigns),10))
+                    d.pop('retryCampaigns',None)
+                    checkpoint()
+                for job in d['adBatches']:
+                    if ('rows' in job and not job.get('pendingRead')) or job.get('error'):
+                        continue
+                    try:
+                        if 'uuid' not in job:
+                            if job.get('submitting'):
+                                raise OzonError('Исход создания отчёта неизвестен. Требуется сверка.')
+                            job['submitting']=True
+                            checkpoint()
+                            job['uuid']=own.order_phrases(job['campaigns'],f['adPeriod'])
+                            checkpoint()
+                        state,data=own.phrases(job['uuid'],set(f.get('relatedSkus',selected)))
+                        job['state']=state
+                        if state in ('ERROR','CANCELLED'):
+                            raise OzonError('Performance '+state)
+                        if data is None:
+                            checkpoint()
+                            continue
+                        previous=job.get('rows',[])
+                        fresh=data['rows']
+                        # A UUID names an immutable report. Retain independently
+                        # confirmed rows and their multiplicity across partial reads.
+                        if previous:
+                            from collections import Counter
+                            seen=Counter(tuple(sorted(row.items())) for row in fresh)
+                            for row in previous:
+                                key=tuple(sorted(row.items()))
+                                if seen[key]:
+                                    seen[key]-=1
+                                else:
+                                    fresh.append(row)
+                                    job['error']='При чтении UUID отсутствуют ранее подтверждённые строки'
+                        job['rows']=fresh
+                        job.pop('pendingRead',None)
+                        if data.get('invalidRows'):
+                            job['error']='Некорректные строки CSV: '+str(data['invalidRows'])
+                    except (ValueError,KeyError,httpx.TransportError) as exc:
+                        job['error']=type(exc).__name__ if isinstance(exc,httpx.TransportError) else str(exc)[:240] or 'Повреждён отчёт Performance'
+                    checkpoint()
+                if any(('rows' not in job or job.get('pendingRead')) and not job.get('error') for job in d['adBatches']):
+                    return
+                rows=[r for job in d['adBatches'] for r in job.get('rows',[])]
+                failures=[{k:job[k] for k in ('campaigns','uuid','state','error') if k in job}
+                          for job in d['adBatches'] if job.get('error')]
+                failures+=d.get('campaignErrors',[])
+                d['performance']=dict(rows=rows,totals=ad_totals(rows,incomplete=bool(failures)),period=f['adPeriod'],skipped=own.skipped,failed=failures)
+                if failures:
+                    d['performance']['reason']='Недоступно пакетов: '+str(len(failures))+'. '+ '; '.join(j['error'] for j in failures)
+                if not d['adBatches'] and not failures:
+                    d['performance']['reason']='Нет подходящей кампании для выбранных SKU'
+            except OzonError as exc:
+                d['performance']={'error':str(exc),'reason':str(exc)}
+        supplemental=[(r['query'],['Seller',str(r['sku'])]) for r in d['seller'].get('queries',[])]
+        supplemental.extend((r['phrase'],['Performance',r['sku']]) for r in d['performance'].get('rows',[]) if r['kind']=='search')
+        d['ownDictionary']=candidates({s:cards[s] for s in selected if s in cards},d.get('reviews',{}),supplemental)
+        for q,origins in d['ownDictionary'].items():
+            dest=d['candidates'].setdefault(q,[])
+            for origin in origins:
+                if origin not in dest:
+                    dest.append(origin)
+        remaining=f['phraseLimit']-len(d['verify'])
+        extra=[q for q in unique([q for q,_ in supplemental]+list(d['ownDictionary'])) if q not in d['verify']][:min(remaining,f.get('ownPhraseLimit',0))]
+        if not d.get('retryAdsOnly') and not batch('search',extra,search,f.get('verifyDepth',f['depth'])):
+            return
+        d['kernel']=observed(targets,d['candidates'],search)
+        d.pop('retryAdsOnly',None)
+        d['comparison']=observed(selected,d['candidates'],search)
+        from .comparison import compare
+        d['quantitative']=compare(selected,targets,d['candidates'],search,d['seller'],d['performance'],f)
+        peers={s:[t for t in targets if t in group['eligible']] for group in d.get('groups',[]) for s in group['own']}
+        d['gaps']={s:[p for p,r in row['phrases'].items() if r['status']=='NOT_FOUND_IN_SAMPLE' and any(d['kernel'][t]['phrases'][p]['status']=='FOUND' for t in peers.get(s,targets))] for s,row in d['comparison'].items()}
+        hits={p:[sku for sku,row in d['kernel'].items() if row['phrases'][p]['status']=='FOUND'] for p in d['candidates']}
+        d['shared']={p:s for p,s in hits.items() if len(s)>1}
+        d['unique']={p:s[0] for p,s in hits.items() if len(s)==1}
+        d['comparisonCards']={s:dict(ownOrder=cards[s].get('order'),observations=[dict(sku=t,order=cards[t].get('order'),
+            priceDifference=(cards[t]['Price']-cards[s]['Price']) if cards[t].get('Price') and cards[s].get('Price') else None,
+            sharedAttributes=sorted(set(cards[t].get('characteristics',{}))&set(cards[s].get('characteristics',{}))),
+            additionalAttributes=sorted(set(cards[t].get('characteristics',{}))-set(cards[s].get('characteristics',{})))) for t in peers.get(s,targets) if t in cards]) for s in selected}
+        d['recommendations']=[]
+        for s,comparison in d['comparisonCards'].items():
+            for item in comparison['observations']:
+                if item['additionalAttributes']:
+                    d['recommendations'].append(dict(sku=s,reference=item['sku'],orders=[comparison['ownOrder'],item['order']],
+                        text='Проверьте применимость характеристик '+', '.join(item['additionalAttributes'][:4])+' к вашему товару.'))
+            if d['gaps'][s]:
+                d['recommendations'].append(dict(sku=s,orders=unique([search[q]['order'] for q in d['gaps'][s]]),
+                    text='Проверьте, точно ли описание отражает назначение по фразам: '+', '.join(d['gaps'][s][:5])+'.'))
+        move('gallery')
+    elif phase=='gallery':
+        gallery=d.setdefault('gallery',{})
+        for s in targets:
+            entries=gallery.setdefault(s,{})
+            for u in cards.get(s,{}).get('photos',[]):
+                saved=entries.get(u,{})
+                if saved.get('asset') or saved.get('attempts',0)>=3:
+                    continue
+                if saved.get('next',0)>time.time():
+                    continue
+                try:
+                    entries[u]={'asset':photo(journal.db,rid,s,u,source.authorize),'fetchedAt':time.time()}
+                except (SourceError,ValueError,OSError) as exc:
+                    attempts=saved.get('attempts',0)+1
+                    entries[u]={'error':str(exc),'attempts':attempts,'next':time.time()+10*attempts}
+                checkpoint()
+                return
+        if any(v.get('error') and v.get('attempts',0)<3 for entries in gallery.values() for v in entries.values()):
+            return
+        groups={}
+        for phrase in d.get('candidates',{}):
+            groups.setdefault(normalized(phrase),[]).append(phrase)
+        d['normalizedPhrases']=groups
+        move('done')
+
