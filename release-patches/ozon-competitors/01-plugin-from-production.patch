+    def test_parallel_reservation_same_key(self):
+        from concurrent.futures import ThreadPoolExecutor
+        from threading import Barrier
+        barrier=Barrier(2)
+        with tempfile.TemporaryDirectory() as tmp:
+            db=Path(tmp)/'db';Journal(db).close()
+            def compete(rid):
+                j=Journal(db);s=Transport()
+                s.balance=lambda:(barrier.wait() is not None and 2,0)
+                try:
+                    j.step(rid,'q','search','Москва',p.products('search',['q'],32),2,s)
+                    return s.sent
+                except ValueError:return 0
+                finally:j.close()
+            with ThreadPoolExecutor(max_workers=2) as pool:self.assertEqual(sum(pool.map(compete,['first','second'])),1)
