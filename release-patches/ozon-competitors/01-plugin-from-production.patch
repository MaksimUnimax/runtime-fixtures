+"""Compare exact phrase observations within a single study and a single Seller period."""
+from collections import defaultdict
+from .analysis import observed
+
+THRESHOLDS=(3,5,10,32)
+
+
+def compare(own,targets,candidates,search,seller,ads,form):
+    sku_ids=list(dict.fromkeys([*own,*targets]))
+    indexes=observed(sku_ids,candidates,search)
+    seller_by_phrase=defaultdict(list)
+    for fact in seller.get('queries',[]):
+        seller_by_phrase[fact['query']].append({k:fact.get(k) for k in ('sku','unique_search_users','gmv','currency','sorts')})
+    advertising=defaultdict(dict)
+    for fact in ads.get('rows',[]):
+        if fact['kind']=='search':
+            entry=advertising[fact['phrase']].setdefault(fact['sku'],{'impressions':0,'clicks':0})
+            for metric in ('impressions','clicks'):
+                entry[metric]+=fact[metric]
+    rows={}
+    depth=form.get('verifyDepth',form['depth'])
+    for phrase,sources in candidates.items():
+        results={sku:indexes[sku]['phrases'][phrase] for sku in sku_ids}
+        check=search.get(phrase,{})
+        # Use a complete common sample for a share, including when no target was found.
+        comparable=(check.get('state')=='OK' and check.get('actual',0)>=depth and check.get('depth')==depth)
+        members={s for source in sources if isinstance(source,list) for s in source
+                 if isinstance(s,str) and s in sku_ids}
+        ads_cells=advertising[phrase]
+        for metrics in ads_cells.values():
+            metrics['ctr']=100*metrics['clicks']/metrics['impressions'] if metrics['impressions'] else None
+        rows[phrase]=dict(sources=sources,seller=seller_by_phrase[phrase],ads=ads_cells,
+            members=sorted(members),observations=results,comparable=comparable)
+    common=[q for q,r in rows.items() if r['comparable']]
+    summaries={}
+    for anchor in own:
+        weights={q:next((v['unique_search_users'] for v in rows[q]['seller'] if str(v['sku'])==anchor),None) for q in common}
+        known={q:w for q,w in weights.items() if w is not None}
+        products={}
+        for sku in sku_ids:
+            def pos(q):
+                return rows[q]['observations'][sku]['response_index']
+            stats={}
+            for n in THRESHOLDS:
+                checked=common if n<=depth else []
+                hits=[q for q in checked if pos(q) and pos(q)<=n]
+                count_known=len(known) if checked else 0
+                stats[str(n)]=dict(hits=len(hits),checked=len(checked),share=len(hits)/len(checked) if checked else None,
+                    known=count_known,unknown=len(checked)-count_known,knownHits=sum(q in known for q in hits),
+                    knownDemand=sum(known[q] for q in hits if q in known) if count_known else None)
+            products[sku]=dict(candidatePhrases=sum(sku in row['members'] for row in rows.values()),
+                found=sum(bool(pos(q)) for q in common),checked=len(common),top=stats)
+        gaps={}
+        for target in targets:
+            gaps[target]=dict(
+                ownPhraseAbsentInSample=[q for q in common if anchor in rows[q]['members'] and rows[q]['observations'][target]['status']=='NOT_FOUND_IN_SAMPLE'],
+                referencePhraseOutsideOwnDictionary=[q for q,row in rows.items() if target in row['members'] and anchor not in row['members']],
+                referencePhraseOwnAbsentInSample=[q for q in common if target in rows[q]['members'] and rows[q]['observations'][anchor]['status']=='NOT_FOUND_IN_SAMPLE'],
+                bothFound=[q for q in common if all(rows[q]['observations'][s]['status']=='FOUND' for s in (anchor,target))])
+        summaries[anchor]=dict(products=products,gaps=gaps)
+    return dict(rows=rows,anchors=summaries,targets=sku_ids,depth=depth,region=form['region'],
+        checked=len(common),collected=len(rows),sellerPeriod=seller.get('period'),adPeriod=ads.get('period'),
+        note='Известный спрос фраз в ТОП — сумма показателей поиска точных фраз одного своего SKU за один период. Просмотры и продажи конкурентов по этой сумме определить нельзя.')
+
