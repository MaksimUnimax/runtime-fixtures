+"""Bounded normalized values at the external-provider boundary."""
+import re
+
+
+def text(value, limit=500):
+    return value.strip()[:limit] if isinstance(value,str) and value.strip() else None
+
+
+def number(value, low=0, high=2**53-1, *, integer=False):
+    if type(value) not in (int,float) or not low <= value <= high:
+        return None
+    if integer and not float(value).is_integer():
+        return None
+    return int(value) if integer else value
+
+
+def diagnostic(value, secrets=()):
+    # Never echo unstructured response bodies. Retain local classifications and
+    # the actionable provider reasons in the supported source contract.
+    msg=str(value)
+    for token in secrets:
+        if isinstance(token,str) and token:
+            msg=msg.replace(token,'[скрыто]')
+    msg=re.sub(r'https?://\S+|\b[\w.+-]+@[\w.-]+|\bBearer\s+\S+|(?:api.?key|token|secret|password)\s*[:=]\s*\S+', '[скрыто]',msg,flags=re.I)
+    return ' '.join(msg.split())[:240]
+
+
+def external_error(value):
+    msg=str(value).casefold()
+    for marker,reason in [('преми','Требуется подписка'),('premium','Требуется подписка'),('архив','Кампания в архиве'),('лимит','Превышен лимит параметра'),('limit','Превышен лимит параметра'),('credential','Ошибка авторизации'),('invalid api','Ошибка авторизации')]:
+        if marker in msg:
+            return reason
+    return 'Поставщик отклонил запрос'
+
+
+def region_matches(requested, reported):
+    # Recorded parser.market reports echo the lower-case name of the region.
+    # Compare other explicit codes only with a directly requested matching code.
+    return reported is None or str(requested).strip().casefold()==str(reported).strip().casefold()
+
+
+def stored_json(value):
+    """Old study snapshots may contain non-standard NaN/Infinity literals."""
+    import json
+    return json.loads(value,parse_constant=lambda _:None)
