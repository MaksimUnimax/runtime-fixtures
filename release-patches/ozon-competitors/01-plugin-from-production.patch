+import json
+import sqlite3
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from starlette.exceptions import HTTPException
+from platform_core.competitors import analysis, own, routes, service
+from platform_core.competitors.comparison import compare
+
+
+class CompetitorComparison(unittest.TestCase):
+    def test_repeated_launch_of_same_saved_estimate_reuses_study(self):
+        db=sqlite3.connect(':memory:')
+        db.execute(service.SCHEMA[0])
+        scope=SimpleNamespace(chat_id='chat',workspace_id='ws',actor_id='user')
+        form=dict(service.validate({'refs':['20']}),skus=[])
+        a,b='a'*32,'b'*32
+        with patch.object(routes,'draft',return_value=(3,form)),patch.object(routes,'freeze',return_value=form.copy()),patch.object(routes,'permitted'):
+            self.assertEqual(routes.new(db,scope,b'one',a,3),a)
+            self.assertEqual(routes.new(db,scope,b'two',b,3),a)
+            with self.assertRaises(HTTPException) as err:routes.new(db,scope,b'one',a,4)
+            self.assertEqual(err.exception.status_code,409)
+            self.assertEqual(db.execute('select count(*) from competitor_studies').fetchone()[0],1)
+        db.close()
+
+    def test_demand_excludes_incomplete_and_other_sku_weights(self):
+        form={'depth':16,'region':'Москва'}
+        full=dict(actual=16,depth=16,state='OK',hits=[{'sku':'23','index':2}])
+        search={'x':full,'y':dict(full,state='INCOMPLETE',actual=4),'z':dict(full,depth=8,actual=8)}
+        seller={'queries':[{'sku':'42','query':'x','unique_search_users':113}],'period':{'start':'one'}}
+        m=compare(['11'],['23'],{p:[['23','title']] for p in search},search,seller,{},form)
+        t=m['anchors']['11']['products']['23']['top']
+        self.assertEqual((t['5']['checked'],t['5']['hits'],t['5']['unknown'],t['32']['checked']),(1,1,1,0))
+        self.assertIsNone(t['5']['knownDemand'])
+        self.assertEqual(m['rows']['x']['seller'][0]['unique_search_users'],113)
