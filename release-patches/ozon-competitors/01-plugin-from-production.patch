+        args=routes.asset_scope('r',{'targets':['2']})
+        self.assertEqual(db.execute('SELECT count(*),sum(selected) FROM competitor_assets WHERE '+routes.ASSET_SCOPE,args).fetchone(),(1,0))
+        self.assertFalse(db.execute('UPDATE competitor_assets SET selected=1 WHERE '+routes.ASSET_SCOPE+' AND sku=?',(*args,'1')).rowcount)
+
+    def test_no_measurements_when_all_csv_rows_fail(self):
+        parsed=own.performance_csv('Отчёт\nSKU;Поисковый запрос;Показы;Клики\n101;поиск;-10;0\n'.encode())
+        self.assertEqual(parsed['invalidRows'],[3])
+        self.assertIsNone(parsed['totals']['all']['impressions'])
+    def test_coverage_keeps_found_position_in_incomplete_sample(self):
+        rows=products('search',['запрос'],3)
+        src=analysis.parse_batch('search',rows,{'id':'1','data':[{**rows[0],'offers':[None,{'Marketid':'111'}]}]})
+        kernel=analysis.observed(['111'],['запрос'],src)
