+"""Parser.market's three compatible Ozon request types and public response fields."""
+import json
+import math
+import re
+import urllib.error
+import urllib.request
+from urllib.parse import urlsplit
+from .contracts import external_error
+
+API = 'https://parser.market/wp-json/client-api/v1/'
+DIGITS = re.compile(r'[1-9][0-9]{0,18}')
+LIMIT = 48 * 1024 * 1024
+
+
+class SourceError(Exception):
+    def __init__(self, message, status=0, retry_after=30):
+        super().__init__(message)
+        self.status = status
+        self.retry_after = retry_after
+
+
+class NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, *args):
+        return None
+
+
+def ref(value):
+    value = str(value).strip()
+    if DIGITS.fullmatch(value):
+        return value
+    try:
+        url = urlsplit(value)
+    except ValueError:
+        raise ValueError("Некорректная ссылка Ozon") from None
+    if url.scheme == 'https' and url.netloc.lower() in {'ozon.ru', 'www.ozon.ru'}:
+        match = re.fullmatch(r'/product/(?:[\w-]+-)?([1-9][0-9]{0,18})/?', url.path)
+        if match:
+            return match[1]
+    raise ValueError("Нужен точный числовой SKU или HTTPS-ссылка Ozon /product/…")
+
+
+def unique(values):
+    return list(dict.fromkeys(values))
+
+
+def products(kind, values, depth=16):
+    if kind not in {'search','cards','reviews'} or type(depth)!=int or not 1<=depth<=3000:
+        raise ValueError("Неподдерживаемый вид или глубина задания")
+    vals = unique([str(v).strip() if kind == 'search' else ref(v) for v in values])
+    if not vals or any(not v or len(v)>240 for v in vals):
+        raise ValueError("Пустая или слишком длинная строка задания")
+    rows = []
+    for i, v in enumerate(vals, 1):
+        row = {'code': (dict(search='Q', cards='C', reviews='R')[kind])+str(i), 'name': v}
+        if kind == 'search':
+            row['donotsearch'] = str(depth)
+        elif kind == 'cards':
+            row['marketid'] = v
+        else:
+            row.update(donotsearch='reviews20', linkset=[f'https://www.ozon.ru/product/{v}/'])
+        rows.append(row)
+    return rows
+
+
+def batches(rows,limit=1024*1024):
+    """Keep a compatible batch whole up to the local upstream JSON-body allowance."""
+    group=[]
+    size=0
+    for row in rows:
+        cost=len(json.dumps(row,ensure_ascii=True).encode())+2
+        if group and size+cost>limit:
+            yield group
+            group=[]
+            size=0
+        group.append(row)
+        size+=cost
+    if group:
+        yield group
+
+
+def check_units(kind,depth=1):
+    return math.ceil(depth/16) if kind=='search' else 1
+
+def review_subjects(mode,targets,selected):
+    return unique(list(targets)+(list(selected) if mode=='A' else []))
+
+def estimate(rows):
+    return sum(check_units('search',int(r['donotsearch'])) if str(r.get('donotsearch','')).isdigit() else check_units('cards') for r in rows)
+
+
+def fetch(url, *, body=None, limit=LIMIT):
+    data = None if body is None else json.dumps(body).encode()
+    req = urllib.request.Request(url,data,{'Content-Type':'application/json','User-Agent':'Octoport/1.0'})
+    try:
+        with urllib.request.build_opener(NoRedirect).open(req,timeout=45) as res:
+            payload = res.read(limit+1)
+            if len(payload)>limit:
+                raise SourceError("Превышен предел размера ответа")
+            return payload, res.headers.get_content_type()
+    except urllib.error.HTTPError as e:
+        delay = e.headers.get('Retry-After','30')
+        detail=''
+        try:
+            obj=flatten(json.loads(e.read(4096)))
+            detail=str(obj.get('message') or obj.get('error') or '')[:200]
+            if body and body.get('apikey'):
+                detail=detail.replace(body['apikey'],'[скрыто]')
+            detail=re.sub(r'https?://\S+|[\w.+-]+@[\w.-]+','[скрыто]',detail)
+        except (ValueError,OSError):
+            pass
+        raise SourceError(f'HTTP {e.code} {external_error(detail)}'.strip(), e.code, max(5,int(delay)) if delay.isascii() and delay.isdecimal() and len(delay)<=9 else 30) from None
+    except (OSError, TimeoutError) as e:
+        raise SourceError(type(e).__name__) from None
+
+
+def flatten(value):
+    if isinstance(value,list):
+        return {k:v for part in value if isinstance(part,dict) for k,v in part.items()}
+    return value if isinstance(value,dict) else {}
+
+
+class Parser:
+    def __init__(self, key, authorize=lambda:None):
+        self.order_id = None
+        self.key = key
+        self.authorize = authorize
+
+    def call(self, method, **args):
+        self.authorize()
+        obj = flatten(json.loads(fetch(API+method, body={'apikey':self.key,**args}, limit=4*1024*1024)[0]))
+        if obj.get('result') != 'success':
+            message = str(obj.get('message') or obj.get('error') or obj.get('result') or 'Неверный формат')
+            raise SourceError(external_error(message))
+        return obj
+
+    def balance(self):
+        obj=self.call('get-balanse')
+        values=[str(obj.get('checks_total')),str(obj.get('checks_pending',0))]
+        if any(not re.fullmatch('[0-9]{1,15}',value) for value in values):
+            raise SourceError('Некорректный баланс parser.market')
+        return tuple(map(int,values))
+
+    def submit(self, kind, region, label, rows):
+        result=self.call('send-order',market='ozon' if kind=='cards' else 'ozons',
+                         regionid=region,userlabel=label,products=rows)
+        return result.get('order-id') or result.get('orderid') or result.get('id')
+
+    def poll(self,label):
+        entries=self.call('get-last50',userlabels=[label],limit=50).get('data') or []
+        matches=[item for item in map(flatten,entries) if item.get('userlabel')==label]
+        if len(matches)>1:
+            raise SourceError('Неоднозначный userlabel')
+        self.order_id=matches[0].get('order-id') if matches else None
+        if not matches or matches[0].get('status')!='completed':
+            return (matches[0].get('status','pending') if matches else 'pending'),None
+        item=matches[0]
+        url=urlsplit(item.get('report_json') or '')
+        if url.scheme!='https' or url.netloc.lower()!='files.parser.market':
+            raise SourceError('Недопустимый адрес отчёта parser.market')
+        self.authorize()
+        report=json.loads(fetch(url.geturl())[0])
+        if str(item.get('order-id'))!=str(report.get('id')) or not isinstance(report.get('data'),list):
+            raise SourceError('ID или структура отчёта не совпадает с заданием')
+        return 'completed',report
+
+
+def exact(offer):
+    sku=str(offer.get('Marketid') or offer.get('OfferId') or '')
+    alt=str(offer.get('OfferId') or sku)
+    return sku if DIGITS.fullmatch(sku) and sku==alt else None
+
+
+def match_rows(expected,report):
+    collected={}
+    for item in report['data']:
+        if isinstance(item,dict) and isinstance(item.get('code'),str):
+            collected.setdefault(item.get('code'),[]).append(item)
+    result=[]
+    for row in expected:
+        matches=collected.get(row['code'],[])
+        reason = 'DUPLICATE_CODE' if len(matches)>1 else 'MISSING_CODE' if not matches else ''
+        if not reason:
+            item=matches[0]
+            if item.get('name')!=row['name']:
+                reason='NAME_MISMATCH'
+            elif item.get('donotsearch') not in (None,'') and 'donotsearch' in row and str(item['donotsearch'])!=row['donotsearch']:
+                reason='DEPTH_MISMATCH'
+            elif not isinstance(item.get('offers'),list):
+                reason='MISSING_OFFERS'
+        result.append((row,reason,None if reason else matches[0]))
+    return result
+
