+def new(db,scope,digest,key,revision):
+    if not isinstance(key,str) or not re.fullmatch('[0-9a-f]{32}',key):
+        raise ValueError('Неверный идентификатор запуска')
+    if type(revision)!=int:
+        raise HTTPException(409,'Смета изменилась')
+    if db.execute('SELECT 1 FROM competitor_studies WHERE id=?',(key,)).fetchone():
+        previous=json.loads(lookup(db,scope,key)[2])
+        if previous.get('draftRevision',revision)!=revision:
+            raise HTTPException(409,'Идентификатор запуска связан с другой версией формы')
+        return key
+    previous=db.execute("SELECT id FROM competitor_studies WHERE chat=? AND workspace=? AND actor=? AND status<>'revoked' AND json_extract(form,'$.draftRevision')=?",
+        (scope.chat_id,scope.workspace_id,scope.actor_id,revision)).fetchone()
+    if previous:
+        lookup(db,scope,previous[0])
+        return previous[0]
+    rev,form=draft(db,scope.chat_id)
+    if type(revision)!=int or rev!=revision:
+        raise HTTPException(409,'Смета изменилась')
+    f=freeze(db,scope,form)
+    f['draftRevision']=revision
+    d=dict(estimate=quote(f),phase='profile' if f['mode']=='A' else 'cards',targets=f['refs'] if f['mode']=='B' else [])
+    db.execute('INSERT INTO competitor_studies(id,workspace,chat,actor,digest,form,result,status,created) VALUES(?,?,?,?,?,?,?,?,?)',
+               (key,scope.workspace_id,scope.chat_id,scope.actor_id,digest,json.dumps(f),json.dumps(d),'running',time.time()))
+    return key
