+        'SELECT phase,state,order_id,used,reserved,error,label FROM competitor_jobs WHERE research=? ORDER BY rowid',(rid,))]
+    result=stored_json(d)
+    if 'gallery' in result:
+        result['gallery']={sku:v for sku,v in result['gallery'].items() if sku in result.get('targets',[])}
+    for r in receipts:
+        if r['state']=='quarantine':
+            incident=db.execute('SELECT reason,accepted_id,reported_id,accepted_checks,reported_checks,created FROM competitor_incidents WHERE label=?',(r['label'],)).fetchall()
+            r['incidents']=[dict(zip(('reason','acceptedOrder','reportedOrder','acceptedChecks','reportedChecks','time'),v)) for v in incident]
+        if r['state'] in ('completed','declined'):
+            kind,rows=db.execute('SELECT kind,rows FROM competitor_jobs WHERE label=?',(r['label'],)).fetchone()
+            args=(kind,json.loads(rows),result,r['order'],result.get('retryOrigins',{}).get(r['phase'],r['phase']),r['label'])
+            r['retryable']=[item['name'] for item in failed_items(*args)]
+            if r['order']:
+                r['rereadable']=[item['name'] for item in failed_items(*args,reread=True)]
+    assets=[dict(id=i,sku=k,mime=m,sha256=h,selected=bool(sel),bytes=n) for i,k,m,h,sel,n in db.execute(
+        'SELECT id,sku,mime,digest,selected,length(content) FROM competitor_assets WHERE '+ASSET_SCOPE,asset_scope(rid,result))]
+    return dict(id=rid,status=status,error=error,quality=quality(result),form=json.loads(f),result=result,receipts=receipts,assets=assets)
