@@ -0,0 +1,80 @@
+PRAGMA foreign_keys=ON;
+
+BEGIN IMMEDIATE;
+
+DROP TRIGGER IF EXISTS competitor_forget;
+
+CREATE TABLE IF NOT EXISTS competitor_studies(
+        id TEXT PRIMARY KEY, workspace TEXT NOT NULL REFERENCES workspaces ON DELETE CASCADE,
+        chat TEXT NOT NULL REFERENCES chats ON DELETE CASCADE, actor TEXT NOT NULL, digest BLOB NOT NULL,
+        form TEXT NOT NULL, result TEXT NOT NULL, status TEXT NOT NULL, error TEXT NOT NULL DEFAULT '',
+        lease TEXT, due REAL NOT NULL DEFAULT 0, created REAL NOT NULL);
+
+CREATE TABLE IF NOT EXISTS competitor_assets(id TEXT PRIMARY KEY,research TEXT NOT NULL REFERENCES competitor_studies ON DELETE CASCADE,
+        sku TEXT NOT NULL,url TEXT NOT NULL,mime TEXT NOT NULL,digest TEXT NOT NULL,content BLOB NOT NULL,selected INTEGER NOT NULL,
+        UNIQUE(research,sku,url));
+
+CREATE TABLE IF NOT EXISTS competitor_drafts(chat TEXT PRIMARY KEY REFERENCES chats ON DELETE CASCADE,revision INTEGER NOT NULL,form TEXT NOT NULL);
+
+CREATE TABLE IF NOT EXISTS competitor_exchanges(chat TEXT REFERENCES chats ON DELETE CASCADE,request TEXT,text TEXT,answer TEXT,PRIMARY KEY(chat,request));
+
+CREATE TABLE IF NOT EXISTS competitor_jobs(
+      research TEXT NOT NULL, phase TEXT NOT NULL, label TEXT NOT NULL UNIQUE, account TEXT NOT NULL,
+      kind TEXT NOT NULL, region TEXT NOT NULL, rows TEXT NOT NULL, reserved INTEGER NOT NULL,
+      state TEXT NOT NULL, due REAL NOT NULL, order_id TEXT, used INTEGER, data TEXT, error TEXT,
+      PRIMARY KEY(research,phase));
+
+CREATE TABLE IF NOT EXISTS competitor_receipts(
+       account TEXT NOT NULL,order_id TEXT NOT NULL,label TEXT NOT NULL UNIQUE,used INTEGER NOT NULL CHECK(used>=0),
+       PRIMARY KEY(account,order_id));
+
+CREATE TABLE IF NOT EXISTS competitor_backoff(account TEXT PRIMARY KEY,label TEXT NOT NULL,due REAL NOT NULL);
+
+CREATE TABLE IF NOT EXISTS competitor_attempts(label TEXT PRIMARY KEY,attempts INTEGER NOT NULL);
+
+CREATE TABLE IF NOT EXISTS competitor_polls(label TEXT PRIMARY KEY,attempts INTEGER NOT NULL DEFAULT 0);
+
+CREATE TABLE IF NOT EXISTS competitor_incidents(label TEXT NOT NULL,reason TEXT NOT NULL,
+        accepted_id TEXT,reported_id TEXT,accepted_checks INTEGER,reported_checks INTEGER,created REAL NOT NULL,
+        PRIMARY KEY(label,reason));
+
+CREATE INDEX IF NOT EXISTS competitor_jobs_account ON competitor_jobs(account,state);
+
+CREATE TABLE IF NOT EXISTS competitor_seller_cache(cid TEXT REFERENCES account_integrations(id) ON DELETE CASCADE,
+       version INTEGER,since TEXT,until TEXT,sku TEXT,payload TEXT NOT NULL,PRIMARY KEY(cid,version,since,until,sku));
+
+CREATE TRIGGER IF NOT EXISTS competitor_detach AFTER DELETE ON chat_plugins WHEN OLD.plugin_id='ozon-competitors'
+        BEGIN UPDATE competitor_studies SET status='revoked',lease=NULL WHERE chat=OLD.chat_id;
+        DELETE FROM competitor_drafts WHERE chat=OLD.chat_id; END;
+
+CREATE TRIGGER IF NOT EXISTS competitor_revoke AFTER DELETE ON chat_integrations
+        BEGIN UPDATE competitor_studies SET status='revoked',lease=NULL WHERE chat=OLD.chat_id AND
+        OLD.connection_id IN (json_extract(form,'$.parser'),json_extract(form,'$.store')); END;
+
+CREATE TRIGGER IF NOT EXISTS competitor_reconcile_revoked AFTER UPDATE OF status ON competitor_studies
+       WHEN NEW.status='revoked' BEGIN
+       UPDATE competitor_jobs SET error='Сверка ожидает восстановления доступа к исходному заказу'
+       WHERE research=NEW.id AND used IS NULL AND state NOT IN ('declined','not-sent'); END;
+
+CREATE TRIGGER IF NOT EXISTS competitor_finance_revocation AFTER UPDATE OF status ON competitor_studies
+       WHEN NEW.status='revoked' BEGIN
+       UPDATE competitor_jobs SET state=CASE WHEN state='rate-limited' THEN 'not-sent' ELSE 'detached-pending' END,
+         used=CASE WHEN state='rate-limited' THEN 0 ELSE used END,due=0,rows='[]',data=NULL,
+         error='Требуется авторизованная сверка' WHERE research=NEW.id AND used IS NULL AND state<>'quarantine';
+       END;
+
+CREATE TABLE IF NOT EXISTS competitor_auth_pause(research TEXT PRIMARY KEY REFERENCES competitor_studies(id)
+       ON DELETE CASCADE, execution TEXT NOT NULL);
+
+CREATE TRIGGER IF NOT EXISTS competitor_detach_finance AFTER DELETE ON competitor_studies BEGIN
+       UPDATE competitor_jobs SET rows='[]',data=NULL,region='',kind='',error=NULL,
+         state=CASE WHEN state='quarantine' THEN state WHEN used IS NOT NULL OR state='rate-limited' THEN 'detached-settled' ELSE 'detached-pending' END,
+         used=CASE WHEN state='rate-limited' THEN 0 ELSE used END,due=0 WHERE research=OLD.id;
+       END;
+
+UPDATE competitor_jobs SET rows='[]',data=NULL,region='',kind='',error=NULL,due=0,
+        state=CASE WHEN used IS NULL THEN 'detached-pending' ELSE 'detached-settled' END
+        WHERE state NOT IN ('detached-pending','detached-settled','quarantine')
+        AND NOT EXISTS(SELECT 1 FROM competitor_studies r WHERE r.id=competitor_jobs.research AND r.status<>'revoked');
+
+COMMIT;
diff --git a/products/harness-platform/docs/OZON_COMPETITORS.md b/products/harness-platform/docs/OZON_COMPETITORS.md
new file mode 100644
index 0000000..d1b9780
--- /dev/null
+++ b/products/harness-platform/docs/OZON_COMPETITORS.md
@@ -0,0 +1,31 @@
+# Анализ конкурентов Ozon
+
+Плагин устанавливается из общего каталога в категории «Аналитика». Для каждого диалога владелец включает плагин и выдаёт доступ к проверенному подключению parser.market. Режим подбора также использует проверенный магазин Ozon. Performance подключается отдельно и служит источником собственных рекламных фраз.
+
+## Ручная приёмка
+
+1. Установите «Анализ конкурентов Ozon», подключите к текущему чату и добавьте ключ через защищённую форму интеграций. Проверьте связь. Для анализа конкретного SKU достаточно этого подключения.
+2. В чате напишите «Изучи конкурента https://www.ozon.ru/product/1315615288/». Откройте плагин в боковом меню. Убедитесь, что в общей форме появился этот SKU. Добавьте второй выбранный SKU с новой строки.
+3. Укажите регион, глубину и количество проверяемых фраз. Нажмите «Рассчитать смету». Проверьте строки карточек, отзывов, поиска и верхний предел. Запуск исследования требует отдельной кнопки «Подтвердить лимит и начать».
+4. Откройте готовое исследование повторно. Проверьте точные SKU, исходные поля карточек, тексты и даты отзывов, полное ядро и вложенные ТОП. Номер отсчитывается от единицы в ответе parser.market. Для неполной выдачи отчёт сохраняет фактическое покрытие.
+5. Откройте фото, скачайте его и выберите один референс. После обновления страницы выбранное изображение доступно по тому же asset ID. Экспорт JSON содержит данные исследования, признаки выбора и идентификаторы квитанций.
+6. Подключите магазин для режима A. В чате напишите «Подбери пять конкурентов для моего товара» и укажите свой SKU. В форме можно выбрать несколько товаров, категории или весь текущий каталог. Выбор фиксируется при запуске. Откройте список подходящих карточек, поменяйте состав и подтвердите исследование выбранной группы. Если группы отличаются типом или категорией, проверьте сравнение отдельно для каждого своего SKU.
+7. Для содержательного разбора спросите «Объясни результаты анализа конкурентов по поисковым фразам». Октопус получает краткие факты текущего исследования. Выбор модели и списание за такой диалог подчиняются настройкам аккаунта. Проверка фраз, скачивание и выбор фотографий выполняются локальной логикой.
+8. Повторите открытие формы и отчёта в другом браузере. После отзыва подключения проверьте доступ к отчёту и к ранее открытому изображению. Для другого аккаунта доступны лишь его диалоги, отчёты и квитанции.
+
+## Источники и расходы
+
+Обычная выборка поиска, прямые карточки и отзывы образуют отдельные пакетные задания. Каждая строка содержит code и name. Источник возвращает один отчёт на группу совместимых строк. Код сверяет userlabel, ID отчёта, строки и целевые SKU. У одного исследования собственный кэш. Дополнительные охваты и повторы ошибочных строк используют остаток согласованного лимита.
+
+Для подключения на ключе пользователя поставщик списывает проверки со своего счёта пользователя в parser.market. Совпадающие точные фразы проверяются одним поиском по всем выбранным SKU. Два среза Seller (BY_SEARCHES и BY_GMV) собираются по своей категории и кэшируются по магазину, версии подключения, SKU и точным границам периода. В разделе «Количественное сравнение фраз» раскройте источники, сопоставьте один опорный SKU и одинаковую глубину. Отсутствующий показатель обозначается «Нет данных». Группа ТОП, для которой глубины недостаточно, имеет пустой знаменатель.\n\nВ кошельке Октопорта появляется закрытая квитанция за сбор с нулём монет и внешним расходом в проверках. Эквивалент по базовому тарифу 0,20 ₽ за проверку служит ориентиром. Денежная стоимость приобретённого пользователем пакета может отличаться.
+
+## Миграция и откат
+
+Миграция выполняется при запуске через существующий установщик реестра. Код схемы находится в `platform_core/competitors/service.py` и `platform_core/competitors/jobs.py`. Добавляются таблицы `competitor_studies`, `competitor_drafts`, `competitor_exchanges`, `competitor_jobs` , `competitor_assets` и `competitor_seller_cache`, индекс резервов и три триггера. Повторный запуск сохраняет исследования и задания. Подключения шифрует действующий IntegrationStore. Повторной загрузки годового каталога для установки плагина не требуется.
+
+Перед выкладкой оператор сверяет активный релиз и допуск владельца, сохраняет путь предыдущего релиза и консистентный снимок SQLite вместе с журналом отзыва магазинов. Порядок переключения релиза и штатная блокировка описаны в `deploy/README.md`.
+
+При откате остановите новые запуски и сверяйте уже отправленные задания по сохранённым userlabel и order ID. Дождитесь сохранения квитанций, затем по штатной процедуре под `/opt/harness-prod/deploy.lock` верните ссылку `/opt/harness-prod/current` на ранее записанный релиз и перезапустите `harness-prod.service`. Проверьте открытие прежнего чата и кошелька. Предыдущий реестр снимает плагин с публикации. Добавленные таблицы и оплаченные квитанции сохраняются для сверки. Восстановление старого снимка рабочей базы затрагивает новые операции других пользователей и требует отдельного решения владельца.
+
+После повторного включения прежний отчёт может быть закрыт отзывом прав. Для нового исследования пользователь заново включает плагин в чат. Сохраняйте контрольные суммы выданного архива, результатов теста и Git bundle.
+
