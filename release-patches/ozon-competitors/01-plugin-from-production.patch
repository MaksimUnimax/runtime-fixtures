+    ids=unique(own+data.get('targets',[]))
+    mentioned=[sku for sku in ids if re.search(r'(?<!\d)'+re.escape(sku)+r'(?!\d)',text)]
+    if mentioned:
+        ids=mentioned
+        if re.search(r'сравн|сопостав',text,re.I):
+            # Naming one side of a comparison must not drop the requested counterparts.
+            if not any(s in own for s in mentioned) and re.search(r'сво[ийе]|мо[йие]|наш',text,re.I):
+                ids=unique(own+ids)
+            if own and all(s in own for s in mentioned) and re.search(r'конкурент|референс',text,re.I):
