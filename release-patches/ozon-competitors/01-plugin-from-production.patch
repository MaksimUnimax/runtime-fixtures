+def failed_items(kind,rows,current,order=None,phase=None,label=None,*,reread=False):
+    cache=current.get({'cards':'cards','reviews':'reviews','search':'search'}[kind],{})
+    if kind=='search' and phase and phase.startswith('expand'):
+        cache=current.get('expanded',cache)
+    def failed(r):
+        entry=cache.get(r['name'],{})
+        if entry.get('attemptError'):
+            attempt=entry.get('lastAttempt') or {}
+            if reread and str(order)==str(attempt.get('order')) and label==attempt.get('label') and r['code']==attempt.get('code'):
+                return True
+        if label and entry.get('label') and label!=entry['label']:
+            return False
+        if order is not None and str(entry.get('order'))!=str(order):
+            return False
+        if kind=='search' and entry.get('depth')!=int(r['donotsearch']):
+            return False
+        if entry.get('code')!=r['code']:
+            return False
+        if reread and kind=='cards' and not card_fields(entry):
+            return True
+        if reread and kind=='reviews' and entry.get('invalidRows'):
+            return True
+        return entry.get('error') or entry.get('state') in ('ERROR','INCOMPLETE')
+    return [r for r in rows if failed(r)]
