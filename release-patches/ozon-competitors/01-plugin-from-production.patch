+def quote(f):
+    unit=check_units('search',f.get('verifyDepth',f['depth']))
+    n=len(f['refs']) if f['mode']=='B' else f['count']
+    stages=[]
+    if f['mode']=='A':
+        stages.extend([{'stage':'Публичные категории выбранных SKU','checks':len(f['skus'])},
+                       {'stage':'Поиск ниши','checks':None},{'stage':'Уточнение кандидатов','checks':None}])
+    else:
+        stages.append({'stage':'Прямые карточки','checks':n})
+        if f.get('compareOwn'):
+            stages.append({'stage':'Явно выбранные собственные карточки','checks':len(f['skus'])})
+    stages.extend([{'stage':'Отзывы, до 20 на карточку','checks':len(review_subjects(f['mode'],range(n),f.get('skus',[])))},
+                   {'stage':'Проверка новых фраз во всей группе','checks':f['phraseLimit']*unit}])
+    return {'stages':stages,'cap':f['budget'],'knownChecks':sum(s['checks'] or 0 for s in stages),
+            'hasUnknown':any(s['checks'] is None for s in stages),'baseRubPerCheck':'0.20','octoportCoinsForCollection':0}
