+def transport_lock(db, operation):
+    # Every process sharing this SQLite file also shares these advisory locks.
+    # Closing the descriptor on exit or process death makes recovery possible.
+    path=Path(db.execute('PRAGMA database_list').fetchone()[2])
+    directory=path.parent/(path.name+'.competitor-locks')
+    directory.mkdir(mode=0o700,exist_ok=True)
+    with (directory/operation[:2]).open('ab') as lock:
+        try:
+            fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
+        except BlockingIOError:
+            yield False
+        else:
+            yield True
