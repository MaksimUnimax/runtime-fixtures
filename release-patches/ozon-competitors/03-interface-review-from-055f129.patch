diff --git a/products/harness-platform/tests/test_competitor_system_invariants.py b/products/harness-platform/tests/test_competitor_system_invariants.py
new file mode 100644
index 0000000..65c6d83
--- /dev/null
+++ b/products/harness-platform/tests/test_competitor_system_invariants.py
@@ -0,0 +1,108 @@
+"""End-to-end invariant suites use temporary stores and offline provider fixtures."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+
+ROOT=Path(__file__).resolve().parents[1]
+SUITE=ROOT/'acceptance/competitor_invariants'
+
+
+def run(script, *args):
+    env=dict(os.environ,PYTHONPATH=os.pathsep.join([str(ROOT),os.environ.get('PYTHONPATH','')]),OCTOPORT_REVIEW_PROJECT=str(ROOT))
+    exe='node' if script.endswith('.mjs') else sys.executable
+    proc=subprocess.run([exe,str(SUITE/script),*args],env=env,capture_output=True,text=True,timeout=120)
+    if proc.returncode:
+        raise AssertionError(proc.stderr[-2000:] or proc.stdout[-1500:])
+    return json.loads(proc.stdout)
+
+
+class SystemInvariants(unittest.TestCase):
+    def test_previous_system_and_lifecycle(self):
+        sets=[('system_probes',27,'status','PASS'),('positive',9,'passed',True)]
+        for name,size,field,expected in sets:
+            result=run(name+'.py')
+            self.assertEqual(len(result),size)
+            for key,row in result.items():
+                with self.subTest(key=key):
+                    self.assertEqual(row.get(field),expected,row)
+        self.assertEqual(len(run('lifecycle.py')),30)
+        self.assertEqual(len(run('batch_matrix.py')),18)
+        for value in run('ui_projection.mjs').values():
+            self.assertTrue(value['showsError'])
+            self.assertFalse(value['showsReady'])
+
+    def test_two_tenants_at_durable_checkpoints(self):
+        self.assertEqual(len(run('checkpoints.py')),25)
+
+    def test_cross_module_reviews(self):
+        for suite,size in [('new_probes',14),('extra_probes',4),('race_probe',1)]:
+            results=run(suite+'.py')
+            self.assertEqual(len(results),size)
+            for key,row in results.items():
+                with self.subTest(key=key):
+                    self.assertIs(row.get('invariant'),True,row)
+            if suite=='new_probes':
+                with tempfile.TemporaryDirectory() as temp:
+                    path=Path(temp)/'projection.json'
+                    path.write_text(json.dumps(results))
+                    for key,row in run('ui_quality_probe.mjs',str(path)).items():
+                        with self.subTest(key=key):
+                            self.assertTrue(row['showsPartial'])
+                            self.assertFalse(row['showsReady'])
+
+class CrossSourceContracts(unittest.TestCase):
+    def test_primary_application_and_secondary_details(self):
+        from platform_core.competitors.analysis import decision,profile
+        def card(title, use, desc=''):
+            return dict(title=title,type='Устройство',breadcrumbs=['Каталог','Оборудование'],
+                        characteristics={'Назначение':[use]},description=desc)
+        pairs=[
+            (card('Фильтр для аквариума','Очистка воды','Предназначен для воды в аквариуме.'),
+             card('Фильтр для бассейна','Очистка воды','Предназначен для воды в бассейне.'),'OTHER_TYPE'),
+            (card('Нагреватель для теплицы','Нагрев','Используется в теплице.'),
+             card('Нагреватель для террариума','Нагрев','Используется в террариуме.'),'OTHER_TYPE'),
+            (card('Подставка для смартфона','Для смартфона'),card('Подставка для телефона','Для телефона'),'ELIGIBLE'),
+            (card('Датчик для почвы','Измерение'),card('Датчик для воздуха','Измерение'),'NEEDS_CHECK'),
+            (card('Кронштейн для планшета на винтах','Для планшета'),card('Кронштейн для планшета на зажиме','Для планшета'),'ELIGIBLE')]
+        for left,right,expected in pairs:
+            for own,ref in ((left,right),(right,left)):
+                with self.subTest(own=own['title'],ref=ref['title']):
+                    self.assertEqual(decision('2',ref,[],set(),[profile(own)])[0],expected)
+
+    def test_review_evidence_survives_repeated_empty_and_partial_reads(self):
+        from platform_core.competitors.facts import merge_result
+        one={'Comment':'Текст','Rating':None}
+        two={'Comment':'Другой','Rating':3}
+        original={'reviews':[one,one,two],'order':'7','code':'R1','invalidRows':1}
+        newer={'order':'7','code':'R1','reviews':[dict(one,Rating=5)],'invalidRows':0}
+        cache=merge_result('reviews',original,newer)
+        self.assertEqual(len(cache['reviews']),3)
+        self.assertEqual(cache['reviews'][0]['Rating'],5)
+        for observation in ({**newer,'reviews':[]},{'error':'MISSING_CODE','order':'7'},newer):
+            cache=merge_result('reviews',cache,observation)
+            self.assertEqual(len(cache['reviews']),3)
+            self.assertIn('attemptError',cache)
+        cache=merge_result('reviews',cache,{**newer,'reviews':[dict(one,Rating=5),one,two]})
+        self.assertNotIn('attemptError',cache)
+        self.assertEqual(len(cache['reviews']),3)
+
+    def test_invalid_csv_positions_and_unknown_totals(self):
+        from platform_core.competitors.own import performance_csv
+        header='Отчёт\nSKU;Поисковый запрос;Показы;Клики\n'
+        good='123;фраза;0;0\n'
+        bad='123;испорчено;-1;нет\n'
+        for idx in range(3):
+            records=[good,good]
+            records.insert(idx,bad)
+            out=performance_csv((header+''.join(records)).encode())
+            self.assertEqual(len(out['rows']),2)
+            self.assertEqual(out['totals']['all']['impressions'],0)
+            self.assertEqual(out['invalidRows'],[idx+3])
+        unknown=performance_csv((header+bad).encode())['totals']['all']
+        self.assertIsNone(unknown['impressions'])
+        self.assertIsNone(unknown['clicks'])
