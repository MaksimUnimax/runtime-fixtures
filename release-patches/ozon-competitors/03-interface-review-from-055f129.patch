+"""Cross authorization transitions with each durable supplier boundary, in a disposable database."""
+import json,sqlite3,tempfile,time
+from pathlib import Path
+from unittest.mock import patch
+from platform_core.competitors import service
+from platform_core.competitors.jobs import Journal
+from platform_core.competitors.parser import products,SourceError
+from platform_core.identity import _secret_digest
+from positive import setup,endpoint,fbase,TOKEN
+
+def scenario(boundary,action):
+    f=fbase();f['parser']='connection'
+    with tempfile.TemporaryDirectory() as td:
+        path=Path(td)/'db';db=setup(path,f,{'phase':'cards','targets':['200001']})
+        db.execute('PRAGMA foreign_keys=ON')
+        sends=[];reads=[]
+        class Provider:
+            key='offline-parser-account'
+            def __init__(self,key=None,authorize=lambda:None):self.authorize=authorize
+            def balance(self):self.authorize();return 10,0
+            def submit(self,kind,region,label,rows):
+                self.authorize();sends.append(label)
+                if boundary=='429':raise SourceError('HTTP 429',429,5)
+                if boundary=='unknown':raise SourceError('HTTP 503',503)
+                return '11'
+            def poll(self,label):
+                self.authorize();reads.append(label)
+                return 'completed',dict(id='11',used_checks_total=1,regioncode='Москва',data=[dict(code='C1',name='200001',offers=[dict(Marketid='200001',Name='Контроль')])])
+        def due():
+            db.execute('UPDATE competitor_studies SET due=0')
+            db.execute('UPDATE competitor_jobs SET due=0')
+        with patch.object(service,'permitted'),patch.object(service,'connection',return_value=(1,None)),patch.object(service,'unseal',return_value={'token':Provider.key}),patch.object(service,'Parser',Provider):
+            if boundary!='before':
+                assert service.tick(path);due()
+            if boundary=='receipt':
+                with patch('platform_core.competitors.jobs.parse_batch',side_effect=ValueError('interrupted')):
+                    assert service.tick(path)
+                assert db.execute('select used from competitor_jobs').fetchone()[0]==1
+            if boundary=='parsed':
+                assert service.tick(path)
+            due()
+            n=len(sends);r=len(reads)
+            if action=='stop':endpoint(db,'stop',{'id':'study'})
+            if action=='expired':
+                db.execute("update identity_sessions set expires_at=0")
+            if action=='delete':
+                db.execute("delete from chats where chat_id='chat'")
+            if action=='detach':
+                db.execute("insert into chat_plugins values('ozon-competitors','chat')")
+                db.execute("delete from chat_plugins where chat_id='chat'")
+            if action=='rotate':
+                from starlette.exceptions import HTTPException
+                with patch.object(service,'permitted',side_effect=HTTPException(403,'Версия подключения изменилась')):
+                    service.tick(path)
+            service.tick(path)
+            assert len(sends)==n
+            if action not in ('stop',):
+                assert len(reads)==r
+            if action=='expired':
+                db.execute('insert into identity_sessions values(?,?,?)',(_secret_digest(TOKEN),'actor',time.time()+60))
+                value=json.loads(endpoint(db,'resume',{'id':'study'}).body)
+                assert value['status']=='running'
+            if action in ('delete','detach') and n and boundary not in ('429','parsed','receipt'):
+                with JournalCloser(path) as journal:
+                    row=journal.db.execute('select * from competitor_jobs').fetchone()
+                    assert row['state']=='detached-pending' and row['rows']=='[]'
+                    journal.reconcile_detached(row['account'],Provider(),manual=True)
+                    after=journal.db.execute('select * from competitor_jobs').fetchone()
+                    assert after['data'] is None and after['used']==1 and after['state']=='detached-settled'
+            states=[list(row) for row in db.execute('select state,used,order_id from competitor_jobs')]
+            assert len(set(sends))==len(sends)
+            db.close()
+            return dict(boundary=boundary,action=action,submits=len(sends),polls=len(reads),financial=states)
+from contextlib import contextmanager
+@contextmanager
+def JournalCloser(path):
+    j=Journal(path)
+    try:yield j
+    finally:j.close()
+if __name__=='__main__':
+    results=[scenario(b,a) for b in ('before','accepted','unknown','429','receipt','parsed') for a in ('stop','expired','detach','rotate','delete')]
+    print(json.dumps(results,ensure_ascii=False,indent=1))
