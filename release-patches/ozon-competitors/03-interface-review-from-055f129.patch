+"""Independent cross-module probes. Synthetic provider responses; no network or credentials."""
+import json,tempfile,sqlite3,time,traceback
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+from platform_core.competitors import analysis, engine, routes, service, own
+from platform_core.competitors.coverage import quality
+from platform_core.competitors.parser import products
+from platform_core.competitors.jobs import Journal
+from platform_core.identity import _secret_digest
+from positive import setup,endpoint,fbase,own_state,FakeJournal,SCOPE,TOKEN,Source
+
+results={}
+def case(name,fn):
+    try:
+        passed,actual=fn();results[name]={'invariant':bool(passed),'actual':actual}
+    except Exception as exc:results[name]={'invariant':None,'harness_error':repr(exc),'trace':traceback.format_exc()}
+
+def stop_reauth():
+    f=fbase(); d={'phase':'cards','targets':['200001']}
+    Source.sent=[];Source.polled=[]
+    with tempfile.TemporaryDirectory() as tmp:
+        path=Path(tmp)/'db';db=setup(path,f,d)
+        db.execute('UPDATE identity_sessions SET expires_at=0')
+        with patch.object(service,'permitted'),patch.object(service,'connection',return_value=(1,None)),patch.object(service,'unseal',return_value={'token':Source.key}),patch.object(service,'Parser',Source):
+            service.tick(path)
+            expired=db.execute('SELECT status FROM competitor_studies').fetchone()[0]
+            db.execute('INSERT INTO identity_sessions VALUES(?,?,?)',(_secret_digest(TOKEN),'actor',time.time()+3600))
+            resp=endpoint(db,'stop',{'id':'study'});stopped=json.loads(resp.body)['status']
